{
  "name": "user_activity_trends",
  "label": "Health: User Activity Trend",
  "description": "User Activity: Insights",
  "dashboard_folder": "RDAF_Health_Trends",
  "version": "1.0.0",
  "enabled": false,
  "dashboard_type": "template",
  "stream": "rda_system_audit_logs",
  "live_edit": true,
  "dashboard_filters": {
    "time_filter": true,
    "default_time_filter_labels": [
      "Last 1 month"
    ],
    "extra_filter": "user_id != 'SERVICE' ",
    "columns_filter": [
      {
        "id": "operation",
        "label": "Operation",
        "type": "TEXT"
      }
    ],
    "group_filters": [
      {
        "stream": "rda_system_audit_logs",
        "title": "Activity",
        "extra_filter": null,
        "limit": 50,
        "group_by": [
          "artifact_type"
        ],
        "ts_column": "timestamp",
        "agg": "cardinality",
        "column": "operation",
        "type": "int",
        "show_counts": false
      },
      {
        "stream": "rda_system_audit_logs",
        "title": "Operation",
        "extra_filter": null,
        "limit": 50,
        "group_by": [
          "operation"
        ],
        "ts_column": "timestamp",
        "agg": "cardinality",
        "column": "operation",
        "type": "int",
        "show_counts": false
      }
    ]
  },
  "dashboard_sections": [
    {
      "title": "User Activity",
      "show_filter": true,
      "widgets": [
        {
          "widget_type": "label",
          "context_filter": "show_traces is 'yes'",
          "max_width": 12,
          "height": 0.5,
          "min_width": 12,
          "label": "<div style='text-align:center;width:100%;'><h1><a style='text-decoration:none;color:#0066ff;' target='_blank'>User Login Trend </a></h1></div>",
          "widget_id": "33317e49"
        },
        {
          "title": "Total Logins",
          "widget_type": "custom_counter",
          "label": "",
          "min_width": 3,
          "max_width": 3,
          "height": 3,
          "unit": "",
          "stream": "rda_system_audit_logs",
          "extra_filter": "artifact_type = 'UserActivity' and operation = 'LOGIN' ",
          "ts_column": "timestamp",
          "duration_hours": 10000000,
          "column": "user_id",
          "agg": "value_count",
          "type": "str",
          "style": {
            "color-list": [
              "#90CAF9"
            ]
          },
          "widget_id": "d73e52ec"
        },
        {
          "title": "Total Login - Unique Users",
          "widget_type": "custom_counter",
          "label": "",
          "min_width": 3,
          "max_width": 3,
          "height": 3,
          "unit": "",
          "stream": "rda_system_audit_logs",
          "extra_filter": "artifact_type = 'UserActivity' and operation = 'LOGIN' ",
          "ts_column": "timestamp",
          "duration_hours": 10000000,
          "column": "user_id",
          "agg": "cardinality",
          "type": "str",
          "style": {
            "color-list": [
              "#90CAF9"
            ]
          },
          "widget_id": "cdc38ae1"
        },
        {
          "title": "Total Users Login Trend (Daily)",
          "widget_type": "timeseries",
          "stream": "rda_system_audit_logs",
          "ts_column": "timestamp",
          "extra_filter": "artifact_type = 'UserActivity' and operation = 'LOGIN'",
          "duration_hours": 1080,
          "max_width": 8,
          "height": 4,
          "min_width": 6,
          "gap_interval": "keep",
          "chartProperties": {
            "yAxisLabel": "Total Users",
            "xAxisLabel": "Local Time",
            "legendLocation": "bottom",
            "isDownsamplingDisabled": true,
            "mode": "selection",
            "column-id": "timestamp",
            "options": {
              "axes": {
                "display": false
              }
            }
          },
          "interval": "1d",
          "series_spec": [
            {
              "column": "count_",
              "agg": "sum",
              "type": "int",
              "label": "Total"
            },
            {
              "column": "user_id",
              "agg": "cardinality",
              "type": "cardinality",
              "label": "Unique"
            }
          ],
          "widget_id": "ed5ca8c1"
        },
        {
          "title": "User Activity Operations",
          "widget_type": "counter",
          "label": "",
          "min_width": 6,
          "max_width": 6,
          "height": 4,
          "unit": "",
          "group_by": [
            "operation"
          ],
          "stream": "rda_system_audit_logs",
          "extra_filter": "artifact_type = 'UserActivity'",
          "ts_column": "timestamp",
          "duration_hours": 1080,
          "column": "count_",
          "agg": "sum",
          "type": "int",
          "widget_id": "ddfbf320"
        },
        {
