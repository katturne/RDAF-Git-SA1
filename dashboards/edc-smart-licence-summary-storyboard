" data-value=\"CMD047\" data-display=\"show platform vm\">show platform vm</div>\r\n                        <div class=\"option px-4 py-2 cursor-pointer hover:bg-blue-50\" data-value=\"CMD048\" data-display=\"show redundancy\">show redundancy</div>\r\n                        <div class=\"option px-4 py-2 cursor-pointer hover:bg-blue-50\" data-value=\"CMD049\" data-display=\"show platform\">show platform</div>\r\n                        <div class=\"option px-4 py-2 cursor-pointer hover:bg-blue-50\" data-value=\"CMD050\" data-display=\"show redundancy\">show redundancy</div>\r\n                        <div class=\"option px-4 py-2 cursor-pointer hover:bg-blue-50\" data-value=\"CMD051\" data-display=\"show bgp all all neighbor brief\">show bgp all all neighbor brief</div>\r\n                        <div class=\"option px-4 py-2 cursor-pointer hover:bg-blue-50\" data-value=\"CMD052\" data-display=\"show ip interface brief\">show ip interface brief</div>\r\n                        <div class=\"option px-4 py-2 cursor-pointer hover:bg-blue-50\" data-value=\"CMD053\" data-display=\"show proc cpu\">show proc cpu</div>\r\n\r\n                            <div id=\"add-command\"\r\n                                class=\"px-4 py-2 cursor-pointer hover:bg-green-50 text-green-600 font-medium hidden\">+\r\n                                Add Command: <span id=\"new-command-text\"></span></div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <!-- Hidden input to store selected values -->\r\n                <input type=\"hidden\" id=\"selected-commands\" name=\"commands\" required>\r\n            </div>\r\n\r\n            <!-- Submit Button -->\r\n            <div>\r\n                \r\n                <button type=\"submit\" class=\"w-auto px-1 py-3 text-blue-500 bg-blue-25 font-medium rounded-md transition focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50 hover:bg-blue-50\">\r\n                    Save Collection\r\n                </button>\r\n            </div>\r\n        </form>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Add Template Modal -->\r\n    <div id=\"add-template-modal\"\r\n        class=\"fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden\">\r\n        <div class=\"bg-white rounded-lg shadow-xl p-6 w-full max-w-4xl mx-4 max-h-[90vh] overflow-y-auto\">\r\n            <div class=\"flex justify-between items-center mb-4\">\r\n                <h2 class=\"text-xl font-bold text-gray-800\">Add New TextFSM Template</h2>\r\n                <button id=\"close-add-modal\" class=\"text-gray-500 hover:text-gray-700\">\r\n                    <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"\r\n                        xmlns=\"http://www.w3.org/2000/svg\">\r\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\">\r\n                        </path>\r\n                    </svg>\r\n                </button>\r\n            </div>\r\n\r\n            <form id=\"add-template-form\" class=\"space-y-4\">\r\n                <div>\r\n                    <label for=\"template-name\" class=\"block text-sm font-medium text-gray-700 mb-1\">Template Name</label>\r\n                    <input type=\"text\" id=\"template-name\" name=\"template-name\" required\r\n                        class=\"w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500\"\r\n                        placeholder=\"e.g., cisco_ios_show_bgp.textfsm\">\r\n                </div>\r\n\r\n                <div>\r\n                    <label for=\"template-content\" class=\"block text-sm font-medium text-gray-700 mb-1\">\r\n                        TextFSM Template\r\n                    </label>\r\n                    <textarea\r\n                        id=\"template-content\"\r\n                        name=\"template-content\"\r\n                        rows=\"10\"\r\n                        required\r\n                        class=\"w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-mono text-sm\"\r\n                        placeholder=\"Value HOSTNAME (\\S+) Value VERSION (.+) Value UPTIME (.+) Start ^.*uptime is ${UPTIME} ^${HOSTNAME} [^,]*, Version ${VERSION},.*\"></textarea>\r\n                </div>\r\n\r\n                <div>\r\n                    <label for=\"cli-output\" class=\"block text-sm font-medium text-gray-700 mb-1\">CLI Output\r\n                        Sample</label>\r\n                    <textarea\r\n                        id=\"cli-output\"\r\n                        name=\"cli-output\"\r\n                        rows=\"8\"\r\n                        required\r\n                        class=\"w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-mono text-sm\"\r\n                        placeholder=\"Router uptime is 1 year, 2 weeks, 5 days, 1 hour, 4 minutes Router1 (RJ45-Console) Cisco IOS Software, Version 15.2(4)M3, RELEASE SOFTWARE...\"></textarea>\r\n                </div>\r\n\r\n                <div>\r\n                    <label class=\"block text-sm font-medium text-gray-700 mb-1\">Result</label>\r\n                    <div id=\"template-result\"\r\n                        class=\"border border-gray-300 rounded-md p-3 min-h-[100px] bg-gray-50 font-mono text-sm overflow-x-auto\">\r\n                        Result will appear here after validation\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"flex justify-end space-x-3 pt-2\">\r\n                    <button type=\"button\" id=\"validate-template\"\r\n                        class=\"px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white font-medium rounded-md shadow-sm transition\">\r\n                        Validate\r\n                    </button>\r\n                    <button type=\"submit\" id=\"save-template\"\r\n                        class=\"px-4 py-2 bg-green-600 hover:bg-green-700 text-white font-medium rounded-md shadow-sm transition\">\r\n                        Save Template\r\n                    </button>\r\n                </div>\r\n            </form>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Rule template (hidden) -->\r\n    <template id=\"rule-template\">\r\n        <div class=\"rule-form mt-2 pl-4 pr-2 pb-2 pt-2 border border-gray-200 rounded-md bg-gray-50\">\r\n            <div class=\"flex items-center justify-between mb-2\">\r\n                <h4 class=\"text-sm font-medium text-gray-700\">\r\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"inline-block h-4 w-4 mr-1\" fill=\"none\"\r\n                        viewBox=\"0 0 24 24\" stroke=\"currentColor\">\r\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"\r\n                            d=\"M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2\" />\r\n                    </svg>\r\n                    Rule\r\n                </h4>\r\n\r\n                <button type=\"button\" class=\"remove-rule text-red-500 hover:text-red-700 p-1\">\r\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"currentColor\"\r\n                        viewBox=\"0 0 16 16\">\r\n                        <path\r\n                            d=\"M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z\" />\r\n                    </svg>\r\n                </button>\r\n            </div>\r\n            <div class=\"rule-inputs-container\">\r\n                <!-- Default 2-column layout for normal operations -->\r\n                <div class=\"grid grid-cols-2 gap-2 rule-standard-inputs\">\r\n                    <div>\r\n                        <label class=\"block text-xs font-medium text-gray-700 mb-1\">Operation</label>\r\n                        <select\r\n                            class=\"rule-operation w-full px-2 py-1 text-sm border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500\">\r\n                            <option value=\"contains\">Raw Output: Contains</option>\r\n                            <option value=\"not contains\">Raw Output: Does not contain</option>\r\n                            <option value=\"matches\">Raw Output: Regex match</option>\r\n                            <option value=\"textfsm\">TextFSM</option>\r\n                        </select>\r\n                    </div>\r\n                    <div class=\"value-container\">\r\n                        <label class=\"block text-xs font-medium text-gray-700 mb-1\">Value</label>\r\n                        <input type=\"text\"\r\n                            class=\"rule-value w-full px-2 py-1 text-sm border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500\">\r\n                    </div>\r\n                </div>\r\n\r\n                <!-- TextFSM specific inputs (hidden by default) -->\r\n                <div class=\"grid grid-cols-1 gap-2 mt-2 rule-textfsm-inputs hidden\">\r\n                    <!-- Template selector input on its own line but with better label placement -->\r\n                    <div class=\"mb-2\">\r\n                        <div class=\"flex items-center mb-1\">\r\n                            <label class=\"text-xs font-medium text-gray-700\">TextFSM Template:</label>\r\n                        </div>\r\n                        <div class=\"relative\">\r\n                            <input type=\"text\"\r\n                                class=\"template-input px-2 py-1 text-sm w-full border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500\"\r\n                                placeholder=\"Search templates...\">\r\n                            <button type=\"button\"\r\n                                class=\"template-dropdown-toggle absolute inset-y-0 right-0 flex items-center pr-2 text-gray-400\">\r\n                                <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"\r\n                                    xmlns=\"http://www.w3.org/2000/svg\">\r\n                                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"\r\n                                        d=\"M19 9l-7 7-7-7\"></path>\r\n                                </svg>\r\n                            </button>\r\n                            <input type=\"hidden\" class=\"template-value\">\r\n\r\n                            <!-- Template dropdown menu -->\r\n                            <div class=\"template-menu hidden absolute z-10 bg-white border border-gray-300 rounded-md shadow-md mt-1 w-full\">\r\n                                <div id=\"templateOptionsContainer\" class=\"py-1 max-h-60 overflow-y-auto\">\r\n                                  <!-- Options will be injected here -->\r\n                                </div>\r\n                              </div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <!-- Field name, operation and value in one line -->\r\n                    <div class=\"grid grid-cols-4 gap-2\">\r\n                        <div>\r\n                            <label class=\"block text-xs font-medium text-gray-700 mb-1\">Field Name</label>\r\n                            <input type=\"text\"\r\n                                class=\"rule-field-name w-full px-2 py-1 text-sm border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500\"\r\n                                placeholder=\"e.g. status\">\r\n                        </div>\r\n                        <div>\r\n                            <label class=\"block text-xs font-medium text-gray-700 mb-1\">Field Operation</label>\r\n                            <select\r\n                                class=\"field-operation w-full px-2 py-1 text-sm border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500\">\r\n                                <option value=\"contains\">Contains</option>\r\n                                <option value=\"not-contains\">Does not contain</option>\r\n                                <option value=\"regex\">Regex match</option>\r\n                            </select>\r\n                        </div>\r\n                        <div>\r\n                            <label class=\"block text-xs font-medium text-gray-700 mb-1\">Field Value</label>\r\n                            <input type=\"text\"\r\n                                class=\"field-value w-full px-2 py-1 text-sm border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500\"\r\n                                placeholder=\"Value to check\">\r\n                        </div>\r\n                        <div>\r\n                            <label class=\"block text-xs font-medium text-gray-700 mb-1\">Application Mode</label>\r\n                            <select\r\n                                class=\"rule-application-mode w-full px-2 py-1 text-sm border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500\">\r\n                                <option value=\"all-rows\">All Rows</option>\r\n                                <option value=\"any-row\">Any Row</option>\r\n                            </select>    \r\n                        </div>\r\n                    </div>\r\n\r\n                    <!-- Application mode below -->\r\n                    <div class=\"mt-2\">\r\n                    </div>\r\n                </div>\r\n\r\n            </div>\r\n        </div>\r\n    </template>\r\n\r\n<script src=\"script.js\"></script>    \r\n</body>\r\n\r\n\r\n</html>"
