         if (command && command.rules[ruleIndex]) {\r\n                    command.rules[ruleIndex].fieldName = this.value;\r\n                    updateHiddenInput();\r\n                }\r\n            });\r\n        }\r\n\r\n        const applicationModeSelect = ruleElement.querySelector('.rule-application-mode');\r\n        if (applicationModeSelect) {\r\n            applicationModeSelect.addEventListener('change', function () {\r\n                const commandItem = this.closest('.command-item');\r\n                const commandId = commandItem.dataset.commandId;\r\n                const ruleIndex = this.closest('.rule-form').dataset.ruleIndex;\r\n\r\n                // Update the rule in the data structure\r\n                const command = selectedValues.find(item => item.id === commandId);\r\n                if (command && command.rules[ruleIndex]) {\r\n                    command.rules[ruleIndex].applicationMode = this.value;\r\n                    updateHiddenInput();\r\n                }\r\n            });\r\n        }\r\n\r\n        // Add event listeners for field operation and value\r\n        const fieldOperationSelect = ruleElement.querySelector('.field-operation');\r\n        if (fieldOperationSelect) {\r\n            fieldOperationSelect.addEventListener('change', function () {\r\n                const commandItem = this.closest('.command-item');\r\n                const commandId = commandItem.dataset.commandId;\r\n                const ruleIndex = this.closest('.rule-form').dataset.ruleIndex;\r\n\r\n                // Update the rule in the data structure\r\n                const command = selectedValues.find(item => item.id === commandId);\r\n                if (command && command.rules[ruleIndex]) {\r\n                    command.rules[ruleIndex].fieldOperation = this.value;\r\n                    updateHiddenInput();\r\n                }\r\n            });\r\n        }\r\n\r\n        const fieldValueInput = ruleElement.querySelector('.field-va