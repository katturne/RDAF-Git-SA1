name: OI Reports
id: oi_edc_reports
version: '2025_07_24_1'
category: OI
comment: Collect and process OI data from snowflake
enabled: true
type: Service
provider: Cisco Systems
scheduled_pipelines:
- name: edc_get_customer_data
  label: Retrieve inventory data
  version: '*'
  site: rda.*
  cron_expression: 0 2 * * 5
  site_type: regex
- name: edc_license_grp
  label: Retrieve Licensing data
  version: '*'
  site: rda.*
  cron_expression: 0 0 * * *
  site_type: regex
  max_execution_mins: 75
