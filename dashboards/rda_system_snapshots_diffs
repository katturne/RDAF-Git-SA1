ory pipeline started successfully:', result);\n                this.updatePipelineFormStatus('inventoryStatus', 'success', 'Pipeline Started Successfully');\n                this.addPipelineSummary('Inventory Hardware EoX', 'success', pipelineData);\n            } else {\n                throw new Error(`Pipeline failed: ${response.status} ${response.statusText}`);\n            }\n\n        } catch (error) {\n            console.error('Error running inventory pipeline:', error);\n            this.updatePipelineFormStatus('inventoryStatus', 'error', `Error: ${error.message}`);\n            this.addPipelineSummary('Inventory Hardware EoX', 'error', null, error.message);\n        } finally {\n            // Reset button\n            button.disabled = false;\n            button.innerHTML = '<i class=\"fas fa-play mr-2\"></i>Run Inventory Pipeline';\n        }\n    }\n\n    async runLicensePipeline() {\n        const form = document.getElementById('licenseForm');\n        const formData = new FormData(form);\n        \n        // Validate form\n        if (!this.validateLicenseForm(formData)) {\n            return;\n        }\n\n        const button = document.getElementById('runLicensePipeline');\n        const status = document.getElementById('licenseStatus');\n        \n        try {\n            // Show loading state\n            button.disabled = true;\n            button.innerHTML = '<i class=\"fas fa-spinner fa-spin mr-2\"></i>Running...';\n            status.classList.remove('hidden');\n            this.updatePipelineFormStatus('licenseStatus', 'running', 'Running Pipeline...');\n\n            // Prepare API data\n            const pipelineData = {\n                customer: formData.get('customer'),\n                top_level_domain: formData.get('top_level_domain')\n            };\n\n            // Store form data\n            this.wizardData.licensePipelineData = pipelineData;\n\n            // Call API\n            const response = await this.callPipelineAPI(