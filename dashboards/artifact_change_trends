{
  "name": "artifact_change_trends",
  "label": "Health: Artifact Change Trend",
  "description": "Artifact Changes: Insights",
  "dashboard_folder": "RDAF_Health_Trends",
  "version": "2025-02-11_2",
  "enabled": false,
  "dashboard_type": "template",
  "stream": "rda_system_audit_logs",
  "live_edit": true,
  "dashboard_filters": {
    "time_filter": true,
    "default_time_filter_labels": [
      "Last 1 month"
    ],
    "columns_filter": [
      {
        "id": "operation",
        "label": "Operation",
        "type": "TEXT"
      }
    ],
    "group_filters": [
      {
        "stream": "rda_system_audit_logs",
        "title": "Operation",
        "extra_filter": "user_id != 'SERVICE' and operation in [ 'ADD', 'UPDATE', 'DELETE'] ",
        "limit": 50,
        "group_by": [
          "operation"
        ],
        "ts_column": "timestamp",
        "agg": "cardinality",
        "column": "operation",
        "type": "int",
        "show_counts": false
      },
      {
        "stream": "rda_system_audit_logs",
        "title": "Artifact Type",
        "extra_filter": "user_id != 'SERVICE' and operation in [ 'ADD', 'UPDATE', 'DELETE'] ",
        "limit": 50,
        "group_by": [
          "artifact_type"
        ],
        "ts_column": "timestamp",
        "agg": "cardinality",
        "column": "artifact_type",
        "type": "int",
        "show_counts": false
      }
    ]
  },
  "dashboard_sections": [
    {
      "title": "Artifact Changes",
      "show_filter": true,
      "widgets": [
        {
          "widget_type": "label",
          "context_filter": "show_traces is 'yes'",
          "max_width": 12,
          "height": 0.5,
          "min_width": 12,
          "label": "<div style='text-align:center;width:100%;'><h1><a style='text-decoration:none;color:#0066ff;' target='_blank'>Artifact Change Trend</a></h1></div>",
          "widget_id": "33317e49"
        },
        {
          "widget_type": "pie_chart",
          "title": "Artifacts Changed",
          "duration_hours": 1080,
          "stream": "rda_system_audit_logs",
          "ts_column": "timestamp",
          "extra_filter": "user_id != 'SERVICE' and operation in [ 'ADD', 'UPDATE', 'DELETE'] ",
          "column": "count_",
          "agg": "value_count",
          "group_by": [
            "artifact_type"
          ],
          "min_width": 4,
          "height": 4,
          "max_width": 4,
          "widget_id": "b015e2a2"
        },
        {
          "title": "Artifact Changes Trend (Daily)",
          "widget_type": "timeseries",
          "stream": "rda_system_audit_logs",
          "ts_column": "timestamp",
          "extra_filter": "user_id != 'SERVICE' and operation in [ 'ADD', 'UPDATE', 'DELETE']",
          "duration_hours": 1080,
          "max_width": 8,
          "height": 5,
          "min_width": 8,
          "gap_interval": "keep",
          "chartProperties": {
            "yAxisLabel": "Artifacts",
            "xAxisLabel": "Local Time",
            "legendLocation": "bottom",
            "isDownsamplingDisabled": true,
            "mode": "selection",
            "column-id": "timestamp",
            "options": {
              "axes": {
                "display": false
              }
            }
          },
          "interval": "1d",
          "group_by": [
            "artifact_type"
          ],
          "series_spec": [
            {
              "column": "artifact_type",
              "agg": "value_count",
              "type": "int"
            }
          ],
          "widget_id": "ed5ca8c1"
        },
        {
          "title": "Artifacts changed",
          "widget_type": "counter",
          "label": "",
          "min_width": 5,
          "max_width": 5,
          "height": 4,
          "unit": "",
          "group_by": [
            "operation"
          ],
          "style": {
            "color-map": {
              "DELETE": "#df0000",
              "ADD": "#00df00",
              "UPDATE": "#ad00bd"
            }
          },
          "stream": "rda_system_audit_logs",
          "extra_filter": "user_id != 'SERVICE' and operation in [ 'ADD', 'UPDATE', 'DELETE'] ",
          "ts_column": "timestamp",
          "duration_hours": 1080,
          "column": "count_",
          "agg": "sum",
          "type": "int",
          "widget_id": "d73e52ec"
        },
        {
          "title": "Top Artifacts",
          "widget_type": "tabular",
          "duration_hours": 1080,
          "max_width": 7,
          "max_rows": 10,
          "height": 5,
          "min_width": 7,
          "stream": "rda_system_audit_logs",
          "ts_column": "timestamp",
          "extra_filter": "user_id != 'SERVICE' and operation in [ 'ADD', 'UPDATE', 'DELETE']",
          "paginated": false,
          "columns": {
            "artifact_type": {
              "title": "Artifact Type",
              "key": true
            },
            "artifact_name": {
              "title": "Artifact Name",
              "key": true
            },
            "operation": {
              "title": "Operation",
              "key": false
            }
          },
          "pivot": {
            "pivot_type": "advanced",
            "group_by": [
              "artifact_type",
              "artifact_name",
              "operation"
            ],
            "series": [
              {
                "column": "count_",
                "agg": "sum",
                "type": "int",
