{
  "name": "pipeline_failure_trends",
  "label": "Health: Pipeline Failure Trend",
  "description": "device_training: Insights",
  "dashboard_folder": "RDAF_Health_Trends",
  "version": "1.0.0",
  "enabled": false,
  "showTitle": false,
  "title": "Dashboard Data",
  "dashboard_type": "template",
  "live_edit": true,
  "debug": false,
  "template_variables": {
    "STREAM_NAME": {
      "contextId": "stream_name",
      "default": "rda_system_worker_traces"
    }
  },
  "computedContext": {
    "show_traces": {
      "expr": "'yes' if str(stream_name) in [ 'rda_system_worker_traces'] else 'no'",
      "defaultValue": "yes"
    },
    "show_logs": {
      "expr": "'yes' if str(stream_name) in [ 'rda_system_worker_logs'] else 'no'",
      "defaultValue": "no"
    },
    "all_context": {
      "expr": "",
      "defaultValue": "Unknown"
    }
  },
  "dashboard_filters": {
    "time_filter": true,
    "default_time_filter_labels": [
      "Last 2 days"
    ],
    "columns_filter": [
      {
        "id": "timestamp",
        "label": "Timestamp",
        "type": "DATETIME"
      },
      {
        "id": "pipeline_name",
        "label": "Pipeline Name",
        "type": "TEXT"
      },
      {
        "id": "error_message",
        "label": "Error Message",
        "type": "TEXT"
      }
    ],
    "group_filters": [
      {
        "stream": "rda_system_worker_traces",
        "title": "Pipeline Name (Traces)",
        "extra_filter": "status_type == 'failed' or levelname== 'ERROR'",
        "limit": 50,
        "group_by": [
          "pipeline_name"
        ],
        "ts_column": "timestamp",
        "agg": "cardinality",
        "column": "pipeline_name",
        "type": "int",
        "show_counts": false
      },
      {
        "stream": "rda_system_worker_logs",
        "title": "Pipeline Name (Logs)",
        "extra_filter": "status_type == 'failed' or levelname== 'ERROR'",
        "limit": 50,
        "group_by": [
          "pipeline_name"
        ],
        "ts_column": "timestamp",
        "agg": "cardinality",
        "column": "pipeline_name",
        "type": "int",
        "show_counts": false
      }
    ]
  },
  "dashboard_sections": [
    {
      "title": "Pipeline Failure",
      "show_filter": true,
      "widgets": [
        {
          "widget_type": "label",
          "context_filter": "show_traces is 'yes'",
          "max_width": 12,
          "height": 0.5,
          "min_width": 12,
          "label": "<div style='text-align:center;width:100%;'><h1><a style='text-decoration:none;color:#0066ff;' target='_blank'> Pipeline Failure Trend (Worker Traces)</a></h1></div>",
          "widget_id": "33317e49"
        },
        {
          "widget_type": "label",
          "context_filter": "show_logs is 'yes'",
          "max_width": 12,
          "height": 0.5,
          "min_width": 12,
          "label": "<div style='text-align:center;width:100%;'><h1><a style='text-decoration:none;color:#0066ff;' target='_blank'> Pipeline Failure Trend (Worker Logs) </a></h1></div>",
          "widget_id": "af4f91d4"
        },
        {
          "widget_type": "pie_chart",
          "title": "Top pipelines failed ",
          "duration_hours": 1080,
          "stream": "{{STREAM_NAME}}",
          "ts_column": "timestamp",
          "extra_filter": "status_type == 'failed' or levelname== 'ERROR'",
          "column": "count_",
          "agg": "value_count",
          "group_by": [
            "pipeline_name"
          ],
          "min_width": 4,
          "height": 4,
          "max_width": 4,
          "widget_id": "b015e2a2"
        },
        {
          "title": "Unique Count Failing Pipelines (Daily)",
          "widget_type": "timeseries",
          "stream": "{{STREAM_NAME}}",
          "ts_column": "timestamp",
          "extra_filter": "status_type == 'failed' or levelname== 'ERROR'",
          "duration_hours": 1080,
          "max_width": 8,
          "height": 4,
          "min_width": 8,
          "gap_interval": "keep",
          "chartProperties": {
            "yAxisLabel": "Failures",
            "xAxisLabel": "Local Time",
            "legendLocation": "none",
            "isDownsamplingDisabled": true,
            "mode": "selection",
            "column-id": "timestamp",
            "options": {
              "axes": {
                "display": false
              }
            }
          },
          "interval": "1d",
          "series_spec": [
            {
              "column": "pipeline_name",
              "agg": "cardinality",
              "type": "int"
            }
          ],
          "widget_id": "ed5ca8c1"
        },
        {
          "title": "Top Pipelines",
          "widget_type": "tabular",
          "duration_hours": 1080,
          "max_width": 4,
          "max_rows": 10,
          "height": 5,
          "min_width": 4,
          "stream": "{{STREAM_NAME}}",
          "ts_column": "timestamp",
          "extra_filter": "status_type == 'failed' or levelname== 'ERROR'",
          "paginated": false,
          "remote_searchable": true,
          "remote_searchable_cols": [
            "pipeline_name"
          ],
          "columns": {
            "pipeline_name": {
              "title": "Pipeline",
              "key": true
            }
          },
          "pivot": {
            "pivot_type": "advanced",
            "group_by": [
              "pipeline_name"
            ],
            "series": [
              {
                "column": "count_",
                "agg": "sum",
                "type": "int",
                "label": "Failure Count"
              }
            ]
          },
          "widget_id": "954ed85a"
        },
        {
          "title": "Top Errors (Traces)",
