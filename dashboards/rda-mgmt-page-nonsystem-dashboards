  "enabled": false,
  "dashboard_type": "template",
  "stream": "oia-alerts-stream",
  "live_edit": true,
  "dashboard_filters": {
    "time_filter": true,
    "default_time_filter_labels": [
      "Last 1 week"
    ],
    "columns_filters": [
      {
        "id": "a_rule_name",
        "label": "Rule Name",
        "type": "TEXT"
      },
      {
        "id": "i_priority_label",
        "label": "Priority",
        "type": "TEXT"
      },
      {
        "id": "a_source_systemname",
        "label": "Source",
        "type": "TEXT"
      }
    ],
    "group_filters": [
      {
        "stream": "oia-alerts-stream",
        "extra_filter": "(a_source_systemname is  'Alert Group')",
        "title": "Rule Name",
        "duration_hours": 3240,
        "limit": 200,
        "group_by": [
          "a_rule_name"
        ],
        "ts_column": "timestamp",
        "agg": "cardinality",
        "column": "count_",
        "show_counts": false
      },
      {
        "stream": "oia-alerts-stream",
        "extra_filter": "(a_source_systemname is not 'Alert Group')",
        "title": "Source",
        "duration_hours": 3240,
        "limit": 200,
        "group_by": [
          "a_source_systemname"
        ],
        "ts_column": "timestamp",
        "agg": "cardinality",
        "column": "count_",
        "show_counts": false
      }
    ]
  },
