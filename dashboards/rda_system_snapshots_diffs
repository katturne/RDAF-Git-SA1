    {
      "name": "script.js",
      "value": "// Pack Configuration Wizard JavaScript\n\nclass PackConfigurationWizard {\n    constructor() {\n        this.currentStep = 1;\n        this.totalSteps = 4;\n        this.wizardData = {\n            customerName: '',\n            customerLogo: null,\n            logoUploadResponse: null,\n            dataSource: '',\n            uploadedFiles: {},\n            pipelineStatus: {},\n            inventoryPipelineData: {},\n            licensePipelineData: {},\n            lastInventoryResponse: null,\n            lastLicenseResponse: null\n        };\n        \n        this.init();\n    }\n\n    init() {\n        this.bindEvents();\n        this.setupFileUploads();\n        this.updateStepIndicators();\n        this.updateNavigationButtons();\n    }\n\n    bindEvents() {\n        // Navigation buttons\n        document.getElementById('nextBtn').addEventListener('click', () => this.nextStep());\n        document.getElementById('prevBtn').addEventListener('click', () => this.prevStep());\n\n        // Credentials dropdown\n        this.bindCredentialsEvents();\n\n        // Customer name validation\n        document.getElementById('customerName').addEventListener('input', (e) => {\n            this.validateCustomerName(e.target.value);\n            this.wizardData.customerName = e.target.value;\n        });\n\n        // Logo upload\n        document.getElementById('customerLogo').addEventListener('change', (e) => {\n            this.handleLogoUpload(e.target.files[0]);\n        });\n\n        // Data source selection\n        document.querySelectorAll('.data-source-option').forEach(option => {\n            option.addEventListener('click', () => {\n                this.selectDataSource(option.dataset.source);\n            });\n        });\n\n        // Pipeline trigger\n        const triggerBtn = document.getElementById('triggerPipelines');\n        if (triggerBtn) {\n            triggerBtn.addEventListener('click', () => this.triggerPipelines());\n        }\n\n        // Individual pipeline buttons\n        const runInventoryBtn = document.getElementById('runInventoryPipeline');\n        if (runInventoryBtn) {\n            runInventoryBtn.addEventListener('click', () => this.runInventoryPipeline());\n        }\n\n        const runLicenseBtn = document.getElementById('runLicensePipeline');\n        if (runLicenseBtn) {\n            runLicenseBtn.addEventListener('click', () => this.runLicensePipeline());\n        }\n\n        // Add data buttons\n        const addInventoryBtn = document.getElementById('addInventoryData');\n        if (addInventoryBtn) {\n            addInventoryBtn.addEventListener('click', () => this.addInventoryData());\n        }\n\n        const addLicenseBtn = document.getElementById('addLicenseData');\n        if (addLicenseBtn) {\n            addLicenseBtn.addEventListener('click', () => this.addLicenseData());\n        }\n\n        // Refresh table buttons\n        const refreshInventoryBtn = document.getElementById('refreshInventoryTable');\n        if (refreshInventoryBtn) {\n            refreshInventoryBtn.addEventListener('click', () => this.loadInventoryData());\n        }\n\n        const refreshLicenseBtn = document.getElementById('refreshLicenseTable');\n        if (refreshLicenseBtn) {\n            refreshLicenseBtn.addEventListener('click', () => this.loadLicenseData());\n        }\n\n        // EOL/ADV upload button\n        const uploadEolAdvBtn = document.getElementById('uploadEolAdvData');\n        if (uploadEolAdvBtn) {\n            uploadEolAdvBtn.addEventListener('click', () => this.processEolAdvData());\n        }\n\n        // Form validation on step change\n        document.addEventListener('stepChange', (e) => {\n            this.validateCurrentStep();\n        });\n    }\n\n    bindCredentialsEvents() {\n        // Credentials dropdown toggle\n        const credentialsDropdown = document.getElementById('credentialsDropdown');\n        const credentialsDropdownMenu = document.getElementById('credentialsDropdownMenu');\n        \n        if (credentialsDropdown && credentialsDropdownMenu) {\n            credentialsDropdown.addEventListener('click', (e) => {\n                e.stopPropagation();\n                credentialsDropdownMenu.classList.toggle('hidden');\n            });\n\n            // Close dropdown when clicking outside\n            document.addEventListener('click', () => {\n                credentialsDropdownMenu.classList.add('hidden');\n            });\n\n            credentialsDropdownMenu.addEventListener('click', (e) => {\n                e.stopPropagation();\n            });\n        }\n\n        // Snowflake credential button\n        const addSnowflakeBtn = document.getElementById('addSnowflakeCredential');\n        if (addSnowflakeBtn) {\n            addSnowflakeBtn.addEventListener('click', () => {\n                this.openSnowflakeModal();\n                credentialsDropdownMenu.classList.add('hidden');\n            });\n        }\n\n        // Snowflake modal events\n        this.bindSnowflakeModalEvents();\n    }\n\n    setupFileUploads() {\n        const fileUploadAreas = document.querySelectorAll('.file-upload-area');\n        \n        fileUploadAreas.forEach(area => {\n            const input = area.querySelector('input[type=\"file\"]');\n            const fileInfo = area.querySelector('.file-info');\n\n            // Click handler\n            area.addEventListener('click', () => {\n                if (input) input.click();\n            });\n\n            // File change handler\n            if (input) {\n                input.addEventListener('change', (e) => {\n                    this.handleFileUpload(e.target.files[0], area, fileInfo);\n                });\n            }\n\n            // Drag and drop handlers\n            area.addEventListener('dragover', (e) => {\n                e.preventDefault();\n                area.classList.add('dragover');\n            });\n\n            area.addEventListener('dragleave', () => {\n                area.classList.remove('dragover');\n            });\n\n            area.addEventListener('drop', (e) => {\n                e.preventDefault();\n                area.classList.remove('dragover');\n                if (input && e.dataTransfer.files.length > 0) {\n                    input.files = e.dataTransfer.files;\n                    this.handleFileUpload(e.dataTransfer.files[0], area, fileInfo);\n                }\n            });\n        });\n    }\n\n    bindSnowflakeModalEvents() {\n        const modal = document.getElementById('snowflakeModal');\n        const closeBtn = document.getElementById('closeSnowflakeModal');\n        const cancelBtn = document.getElementById('cancelSnowflake');\n        const form = document.getElementById('snowflakeCredentialsForm');\n        const checkConnectivityBtn = document.getElementById('checkConnectivity');\n\n        // Close modal events\n        if (closeBtn) {\n            closeBtn.addEventListener('click', () => this.closeSnowflakeModal());\n        }\n\n        if (cancelBtn) {\n            cancelBtn.addEventListener('click', () => this.closeSnowflakeModal());\n        }\n\n        // Close modal when clicking outside\n        if (modal) {\n            modal.addEventListener('click', (e) => {\n                if (e.target === modal) {\n                    this.closeSnowflakeModal();\n                }\n            });\n        }\n\n        // Check connectivity button\n        if (checkConnectivityBtn) {\n            checkConnectivityBtn.addEventListener('click', () => this.checkSnowflakeConnectivity());\n        }\n\n        // Form submission\n        if (form) {\n            form.addEventListener('submit', (e) => {\n                e.preventDefault();\n                this.saveSnowflakeCredential();\n            });\n        }\n    }\n\n    openSnowflakeModal() {\n        const modal = document.getElementById('snowflakeModal');\n        if (modal) {\n            modal.classList.remove('hidden');\n            document.body.style.overflow = 'hidden'; // Prevent background scrolling\n        }\n    }\n\n    closeSnowflakeModal() {\n        const modal = document.getElementById('snowflakeModal');\n        const connectionStatus = document.getElementById('connectionStatus');\n        \n        if (modal) {\n            modal.classList.add('hidden');\n            document.body.style.overflow = 'auto'; // Restore scrolling\n        }\n        \n        // Reset form and hide status\n        const form = document.getElementById('snowflakeCredentialsForm');\n        if (form) {\n            form.reset();\n            // Reset checkboxes to default values (add_to_default should be checked)\n            document.getElementById('snowflake_add_to_default').checked = true;\n        }\n        \n        if (connectionStatus) {\n            connectionStatus.classList.add('hidden');\n        }\n    }\n\n    async checkSnowflakeConnectivity() {\n        const button = document.getElementById('checkConnectivity');\n        const statusDiv = document.getElementById('connectionStatus');\n        \n        try {\n            // Show loading state\n            button.disabled = true;\n            button.innerHTML = '<i class=\"fas fa-spinner fa-spin mr-2\"></i>Testing...';\n            \n            // Show status div\n            statusDiv.classList.remove('hidden');\n            this.updateConnectionStatus('testing', 'Testing connection...');\n\n            // Get form data\n            const formData = this.getSnowflakeFormData();\n            \n            // Call the verification API\n            const response = await fetch('/api/v2/credentials/credential/snowflake/verify', {\n                method: 'POST',\n                headers: {\n                    'Content-Type': 'application/json',\n                    'accept': 'application/json'\n                },\n                body: JSON.stringify(formData)\n            });\n\n            if (response.ok) {\n                const result = await response.json();\n                console.log('Connection verified successfully:', result);\n                this.updateConnectionStatus('success', 'Connection successful!');\n            } else {\n                const errorData = await response.json().catch(() => ({}));\n                throw new Error(errorData.message || `Connection failed: ${response.status} ${response.statusText}`);\n            }\n\n        } catch (error) {\n            console.error('Error checking connectivity:', error);\n            this.updateConnectionStatus('error', `Connection failed: ${error.message}`);\n        } finally {\n            // Reset button\n            button.disabled = false;\n            button.innerHTML = '<i class=\"fas fa-plug mr-2\"></i>Check Connectivity';\n        }\n    }\n\n    async saveSnowflakeCredential() {\n        const button = document.querySelector('#snowflakeCredentialsForm button[type=\"submit\"]');\n        const statusDiv = document.getElementById('connectionStatus');\n        \n        try {\n            // Show loading state\n            button.disabled = true;\n            button.innerHTML = '<i class=\"fas fa-spinner fa-spin mr-2\"></i>Saving...';\n            \n            // Show status div\n            statusDiv.classList.remove('hidden');\n            this.updateConnectionStatus('saving', 'Saving credential...');\n\n            // Get form data\n            const formData = this.getSnowflakeFormData();\n            \n            // Call the save credential API\n            const response = await fetch('/api/v2/credentials/credential/snowflake', {\n                method: 'PUT',\n                headers: {\n                    'Content-Type': 'application/json',\n                    'accept': 'application/json'\n                },\n                body: JSON.stringify(formData)\n            });\n\n            if (response.ok) {\n                const result = await response.json();\n                console.log('Credential saved successfully:', result);\n                this.updateConnectionStatus('success', 'Credential saved successfully!');\n                \n                // Set credentials configured flag\n                this.wizardData.credentialsConfigured = true;\n                localStorage.setItem('snowflakeCredentialsSaved', 'true');\n                \n                // Show success notification\n                this.showNotification('Snowflake credential saved successfully!', 'success');\n                \n                // Close modal after a delay\n                setTimeout(() => {\n                    this.closeSnowflakeModal();\n                }, 1500);\n                \n            } else {\n                const errorData = await response.json().catch(() => ({}));\n                throw new Error(errorData.message || `Save failed: ${response.status} ${response.statusText}`);\n            }\n\n        } catch (error) {\n            console.error('Error saving credential:', error);\n            this.updateConnectionStatus('error', `Save failed: ${error.message}`);\n            this.showNotification(`Error saving credential: ${error.message}`, 'error');\n        } finally {\n            // Reset button\n            button.disabled = false;\n            button.innerHTML = '<i class=\"fas fa-save mr-2\"></i>Save Credential';\n        }\n    }\n\n    getSnowflakeFormData() {\n        const form = document.getElementById('snowflakeCredentialsForm');\n        const formData = new FormData(form);\n        \n        // Convert FormData to object, matching the required payload structure\n        const data = {\n            account: formData.get('account') || '',\n            name: formData.get('name') || '',\n            password: null, // Always null as per spec\n            private_key: formData.get('private_key') || '',\n            timeout: parseInt(formData.get('timeout')) || 60,\n            type: 'snowflake', // Fixed value\n            user: formData.get('user') || '',\n            verify: document.getElementById('snowflake_verify').checked || false\n        };\n\n        // Add additional fields if they have values\n        if (document.getElementById('snowflake_add_to_default').checked) {\n            data.add_to_default_site_profile = true;\n        }\n\n        const sites = formData.get('sites');\n        if (sites) {\n            data.sites = sites;\n        }\n\n        return data;\n    }\n\n    updateConnectionStatus(type, message) {\n        const statusDiv = document.getElementById('connectionStatus');\n        \n        let bgColor, borderColor, textColor, icon;\n        switch (type) {\n            case 'testing':\n            case 'saving':\n                bgColor = 'bg-blue-50';\n                borderColor = 'border-blue-200';\n                textColor = 'text-blue-800';\n                icon = 'fa-spinner fa-spin';\n                break;\n            case 'success':\n                bgColor = 'bg-green-50';\n                borderColor = 'border-green-200';\n                textColor = 'text-green-800';\n                icon = 'fa-check-circle';\n                break;\n            case 'error':\n                bgColor = 'bg-red-50';\n                borderColor = 'border-red-200';\n                textColor = 'text-red-800';\n                icon = 'fa-exclamation-circle';\n                break;\n            default:\n                bgColor = 'bg-blue-50';\n                borderColor = 'border-blue-200';\n                textColor = 'text-blue-800';\n                icon = 'fa-info-circle';\n        }\n\n        statusDiv.innerHTML = `\n            <div class=\"${bgColor} border ${borderColor} rounded-lg p-4\">\n                <div class=\"flex items-center\">\n                    <i class=\"fas ${icon} ${textColor} mr-2\"></i>\n                    <span class=\"${textColor}\">${message}</span>\n                </div>\n            </div>\n        `;\n    }\n\n    validateCustomerName(name) {\n        const errorElement = document.getElementById('customerNameError');\n        const inputElement = document.getElementById('customerName');\n        \n        if (name.trim().length === 0) {\n            errorElement.classList.remove('hidden');\n            inputElement.classList.add('form-error');\n            return false;\n        } else {\n            errorElement.classList.add('hidden');\n            inputElement.classList.remove('form-error');\n            inputElement.classList.add('form-success');\n            return true;\n        }\n    }\n\n    handleLogoUpload(file) {\n        if (!file) return;\n\n        const maxSize = 10 * 1024 * 1024; // 10MB\n        const allowedTypes = ['image/png', 'image/jpeg', 'image/jpg', 'image/svg+xml'];\n\n        if (file.size > maxSize) {\n            alert('File size must be less than 10MB');\n            return;\n        }\n\n        if (!allowedTypes.includes(file.type)) {\n            alert('Only PNG, JPG, and SVG files are allowed');\n            return;\n        }\n\n        // Show preview immediately\n        const reader = new FileReader();\n        reader.onload = (e) => {\n            document.getElementById('logoUploadContent').classList.add('hidden');\n            document.getElementById('logoPreview').classList.remove('hidden');\n            document.getElementById('logoImage').src = e.target.result;\n            document.getElementById('logoFileName').textContent = file.name;\n        };\n        reader.readAsDataURL(file);\n\n        // Store file data\n        this.wizardData.customerLogo = file;\n\n        // Upload to backend API\n        this.uploadLogoToAPI(file);\n    }\n\n    async uploadLogoToAPI(file) {\n        try {\n            // Show uploading indicator\n            this.showUploadProgress(true);\n\n            // Get the file name without extension for the API endpoint\n            const fileName = file.name.replace(/\\.[^/.]+$/, \"\");\n            const encodedFileName = encodeURIComponent(fileName);\n\n            // Create FormData for multipart/form-data\n            const formData = new FormData();\n            formData.append('file', file);\n\n            // API endpoint\n            const apiUrl = `/api/v2/icons/upload/${encodedFileName}?public=false`;\n\n            // Make the API call\n            const response = await fetch(apiUrl, {\n                method: 'POST',\n                headers: {\n                    'accept': 'application/json'\n                },\n                body: formData\n            });\n\n            if (response.ok) {\n                const result = await response.json();\n                console.log('Logo uploaded successfully:', result);\n                \n                // Store the API response for later use\n                this.wizardData.logoUploadResponse = result;\n                \n                // Show success indicator\n                this.showUploadSuccess();\n            } else {\n                throw new Error(`Upload failed: ${response.status} ${response.statusText}`);\n            }\n\n        } catch (error) {\n            console.error('Error uploading logo:', error);\n            this.showUploadError(error.message);\n        } finally {\n            // Hide uploading indicator\n            this.showUploadProgress(false);\n        }\n    }\n\n    showUploadProgress(show) {\n        const fileName = document.getElementById('logoFileName');\n        if (show) {\n            fileName.innerHTML = `\n                <div class=\"flex items-center\">\n                    <i class=\"fas fa-spinner fa-spin mr-2 text-blue-500\"></i>\n                    <span>Uploading...</span>\n                </div>\n            `;\n        }\n    }\n\n    showUploadSuccess() {\n        const fileName = document.getElementById('logoFileName');\n        const originalName = this.wizardData.customerLogo.name;\n        fileName.innerHTML = `\n            <div class=\"flex items-center\">\n                <i class=\"fas fa-check-circle mr-2 text-green-500\"></i>\n                <span>${originalName} - Uploaded successfully</span>\n            </div>\n        `;\n    }\n\n    showUploadError(errorMessage) {\n        const fileName = document.getElementById('logoFileName');\n        const originalName = this.wizardData.customerLogo.name;\n        fileName.innerHTML = `\n            <div class=\"flex items-center\">\n                <i class=\"fas fa-exclamation-circle mr-2 text-red-500\"></i>\n                <span>${originalName} - Upload failed: ${errorMessage}</span>\n            </div>\n        `;\n    }\n\n    selectDataSource(source) {\n        // Remove selection from all options\n        document.querySelectorAll('.data-source-option').forEach(option => {\n            option.classList.remove('selected');\n            option.querySelector('input[type=\"radio\"]').checked = false;\n        });\n\n        // Select the clicked option\n        const selectedOption = document.querySelector(`[data-source=\"${source}\"]`);\n        selectedOption.classList.add('selected');\n        selectedOption.querySelector('input[type=\"radio\"]').checked = true;\n\n        this.wizardData.dataSource = source;\n\n        // Hide error message\n        document.getElementById('dataSourceError').classList.add('hidden');\n    }\n\n    handleFileUpload(file, area, fileInfo) {\n        if (!file) return;\n\n        const fileName = file.name;\n        const fileSize = this.formatFileSize(file.size);\n        const fileType = file.type || 'Unknown';\n\n        fileInfo.innerHTML = `\n            <div class=\"flex items-center justify-between\">\n                <div>\n                    <p class=\"font-medium\">${fileName}</p>\n                    <p class=\"text-sm\">${fileSize} \u2022 ${fileType}</p>\n                </div>\n                <i class=\"fas fa-check-circle text-green-500\"></i>\n            </div>\n        `;\n        fileInfo.classList.remove