      "name": "main.html",
      "value": "{%-\n    set docContentsYaml = engine.get_dashboard_attachment(help_yaml_source_dashboard, help_yaml_source_attachment, defaultValue=help_default)\n-%}\n\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n    <title>r</title>\n    <style>\n        body {\n            font-family: Avenir, Helvetica, Arial, sans-serif;\n            margin: 20px auto;\n            padding: 20px;\n            max-width0: 1000px;\n            background-color: #D3D3D3;\n            color: #36454F;\n        }\n\n        #toc {\n            background: #07182D;\n            padding: 10px;\n            margin-bottom: 20px;\n            border-radius: 8px;\n        }\n\n        #toc ul {\n            list-style: none;\n            padding-left: 20px;\n            margin: 0;\n        }\n\n        #toc > ul {\n            padding-left: 0;\n        }\n\n        #toc li {\n            margin: 6px 0;\n        }\n\n        .toc-h2 > a {\n            color: #90CAF9;\n        }\n\n        .toc-h3 > a {\n            color: orange;\n        }\n\n        .toc-h4 > a {\n            color: green;\n        }\n\n        .toc-h5 > a {\n            color: lightgreen; \n        }\n\n        .toc-h6 > a {\n            color: grey; \n            font-style: italic;\n        }\n\n        .toggle-button {\n            cursor: pointer;\n            font-weight: bold;\n            margin-right: 5px;\n        }\n\n        .no-toggle {\n            display: inline-block;\n            width: 1em;\n        }\n\n        .hidden {\n            display: none;\n        }\n\n        section.section-box {\n            background: #07182D;\n            border: 1px solid #ddd;\n            border-radius: 8px;\n            padding: 10px;\n            margin-bottom: 10px;\n            color: white;\n            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);\n        }\n\n        h2 {\n            color: #90CAF9;\n            font-size: 22px;\n            border-bottom: 1px solid #607D8B;\n            padding-bottom: 4px;\n        }\n\n        h3 {\n            color: orange;\n            font-size: 20px;\n        }\n\n        h4 {\n            color: green;\n            font-size: 18px;\n            \n        }\n\n        h5 {\n            color: lightgreen;\n            font-size: 16px;\n            font-weight: normal;\n        }\n\n        h6 {\n            color: grey; \n            font-size: 15px;\n            font-weight: normal;\n            font-style: italic;\n        }\n\n        p {\n            line-height: 1.6;\n            font-size: 14px;\n        }\n\n        a {\n            color: #42A5F5;\n            text-decoration: none;\n        }\n\n        a:hover {\n            text-decoration: underline;\n        }\n\n        img {\n            max-width: 100%;\n            height: auto;\n            margin-top: 10px;\n            border-radius: 5px;\n        }\n    </style>\n\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/js-yaml/4.1.0/js-yaml.min.js\"></script>\n</head>\n<body>\n    <h1>{{help_title}}</h1>\n    <p>{{help_description}}</p>\n\n    <div id=\"toc\">\n        <ul id=\"index\"></ul>\n    </div>\n\n    <div id=\"content\"></div>\n\n    <script>\n        const yamlData = `{{docContentsYaml}}`;\n        const data = jsyaml.load(yamlData);\n        renderDocumentation(data);\n\n        function renderDocumentation(data) {\n            const indexEl = document.getElementById('index');\n            const contentEl = document.getElementById('content');\n            indexEl.innerHTML = '';\n            contentEl.innerHTML = '';\n\n            renderSectionsRecursive(data.sections, indexEl, contentEl, 'section');\n        }\n\n        function renderSectionsRecursive(sections, parentTOCEl, parentContentEl, parentIdPrefix) {\n            sections.forEach((section, sectionIndex) => {\n                const sectionId = `${parentIdPrefix}-${sectionIndex}`;\n                const sectionToggleId = `${sectionId}-toggle`;\n                const sectionTOCId = `${sectionId}-toc`;\n\n                const headingLevel = parentIdPrefix.split('-').length + 1;\n                const headingTag = headingLevel > 6 ? 'h6' : `h${headingLevel}`;\n                const tocClass = `toc-${headingTag}`;\n\n                const sectionItem = document.createElement('li');\n                sectionItem.className = tocClass;\n\n                if (section.children && section.children.length > 0) {\n                    sectionItem.innerHTML = `\n                        <span class=\"toggle-button\" id=\"${sectionToggleId}\" onclick=\"toggleTOC('${sectionToggleId}', '${sectionTOCId}')\">\u25b6</span>\n                        <a href=\"#${sectionId}\">${section.title}</a>\n                        <ul class=\"hidden\" id=\"${sectionTOCId}\"></ul>\n                    `;\n                } else {\n                    sectionItem.innerHTML = `\n                        <span class=\"no-toggle\"></span>\n                        <a href=\"#${sectionId}\">${section.title}</a>\n                    `;\n                }\n\n                parentTOCEl.appendChild(sectionItem);\n\n                const sectionEl = document.createElement('section');\n                sectionEl.classList.add('section-box');\n\n                sectionEl.innerHTML = `\n                    <${headingTag} id=\"${sectionId}\">${section.title}</${headingTag}>\n                    <p>${section.description || ''}</p>\n                `;\n\n                if (section.image) {\n                    sectionEl.innerHTML += `<img src=\"${section.image}\" alt=\"${section.title}\">`;\n                }\n\n                parentContentEl.appendChild(sectionEl);\n\n                if (section.children && section.children.length > 0) {\n                    const childTOCEl = document.getElementById(sectionTOCId);\n                    renderSectionsRecursive(section.children, childTOCEl, sectionEl, sectionId);\n                }\n            });\n        }\n\n        function toggleTOC(toggleId, listId) {\n            const toggleButton = document.getElementById(toggleId);\n            const list = document.getElementById(listId);\n\n            if (list.classList.contains('hidden')) {\n                list.classList.remove('hidden');\n                toggleButton.textContent = '\u25bc';\n            } else {\n                list.classList.add('hidden');\n                toggleButton.textContent = '\u25b6';\n            }\n        }\n    </script>\n</body>\n</html>\n"
    },
