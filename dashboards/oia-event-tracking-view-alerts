{
  "name": "oia-event-tracking-view-alerts",
  "label": "Events-View-Alerts",
  "description": "OIA Event Tracking View Alerts",
  "version": "23.1.2",
  "enabled": true,
  "stream": "oia-events-stream",
  "dashboard_style": "auto",
  "status_poller": {},
  "dashboard_type": "template",
  "template_variables": {
    "SOURCE_EVENT_ID": {
      "default": null,
      "contextId": "se_id",
      "type": "stack"
    }
  },
  "dashboard_filters": {
    "show_default_time_filter": false,
    "additional_datetime_column_filters": [
      {
        "id": "e_createdat",
        "label": "Created At"
      },
      {
        "id": "e_updatedat",
        "label": "Updated At"
      }
    ],
    "columns_filter": [
      {
        "id": "e_createdat",
        "label": "Created At",
        "type": "DATETIME"
      }
    ],
    "time_filter": false,
    "default_time_filter_non_removable": true
  },
  "dashboard_sections": [
    {
      "title": "Events",
      "show_filter": true,
      "projects": [
        "ACME"
      ],
      "widgets": [
        {
          "title": "Event",
          "widget_type": "summary",
          "stream": "oia-source-events-stream",
          "extra_filter": "se_id is '{{SOURCE_EVENT_ID}}'",
          "ts_column": "se_updatedat",
          "timebased": false,
          "min_width": 6,
          "height": 4,
          "max_width": 6,
          "paginated": true,
          "resizableColumns": false,
          "refreshRequired": true,
          "remote_searchable": true,
          "remote_searchable_cols": [
            "se_sourcesystemname",
            "se_status",
            "se_message",
            "se_projectid",
            "se_id"
          ],
          "max_rows": 50,
          "columns": {
            "se_id": {
              "title": "Source Event ID",
              "visible": false,
              "key": true,
              "defaultWidth": 150
            },
            "se_projectid": {
              "title": "project Id",
              "visible": false,
              "key": true,
              "defaultWidth": 150
            },
            "se_sourcereceivedat": {
              "title": "Received At",
              "type": "DATETIME",
              "defaultWidth": 150
            },
            "se_sourcesystemname": {
              "title": "Source",
              "defaultWidth": 150
            },
            "se_status": {
              "title": "Status",
              "defaultWidth": 150
            },
            "se_numberofevents": {
              "title": "No of Events",
              "defaultWidth": 150
            },
            "se_message": {
              "title": "Message",
              "defaultWidth": 270
            },
            "se_createdat": {
              "title": "Created At",
              "type": "DATETIME",
              "defaultWidth": 180
            },
            "se_updatedat": {
              "title": "Updated At",
              "type": "DATETIME",
              "defaultWidth": 180
            }
          },
          "actions": [],
          "widget_id": "94a3fc11"
        },
