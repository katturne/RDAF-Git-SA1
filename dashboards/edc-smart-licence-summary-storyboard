      "name": "script.js",
      "value": "document.addEventListener('DOMContentLoaded', async function () {\r\n    // Main form elements\r\n    const dropdownInput = document.getElementById('dropdown-input');\r\n    const dropdownToggle = document.getElementById('dropdown-toggle');\r\n    const dropdownMenu = document.getElementById('dropdown-menu');\r\n    const selectedOptions = document.getElementById('selected-options');\r\n    const emptySelection = document.getElementById('empty-selection');\r\n    const hiddenInput = document.getElementById('selected-commands');\r\n    let options = document.querySelectorAll('.option');\r\n    const form = document.getElementById('commandForm');\r\n    const ruleTemplate = document.getElementById('rule-template');\r\n\r\n    // Add template modal elements\r\n    const addTemplateModal = document.getElementById('add-template-modal');\r\n    const closeAddModal = document.getElementById('close-add-modal');\r\n    const addTemplateForm = document.getElementById('add-template-form');\r\n    const validateBtn = document.getElementById('validate-template');\r\n\r\n    \r\n\r\n    let selectedValues = [];\r\n    let currentRuleElement = null;\r\n    let currentTemplateInput = null;\r\n\r\n    let cachedTextfsmTemplates = [];\r\n    await loadTextfsmData();\r\n\r\n    // Show/hide dropdown\r\n    function toggleDropdown() {\r\n        dropdownMenu.classList.toggle('hidden');\r\n    }\r\n\r\n    // Close dropdown when clicking outside\r\n    document.addEventListener('click', function (e) {\r\n        if (!dropdownInput.contains(e.target) && !dropdownToggle.contains(e.target) && !dropdownMenu.contains(e.target)) {\r\n            dropdownMenu.classList.add('hidden');\r\n        }\r\n\r\n        // Close any open template dropdowns if clicking outside\r\n        document.querySelectorAll('.template-menu').forEach(menu => {\r\n            const input = menu.closest('.relative').querySelector('.template-input');\r\n            const toggle = menu.closest('.relative').querySelector('.template-dropdown-toggle');\r\n\r\n            if (!input.contains(e.target) && !toggle.contains(e.target) && !menu.contains(e.target)) {\r\n                menu.classList.add('hidden');\r\n            }\r\n        });\r\n    });\r\n\r\n    // Toggle dropdown on click\r\n    dropdownToggle.addEventListener('click', function() {\r\n        toggleDropdown();\r\n        showAllOptions();\r\n    });\r\n\r\n    dropdownInput.addEventListener('click', function() {\r\n        toggleDropdown();\r\n        showAllOptions();\r\n    });\r\n    //new function to redirect to saved command collection dashboard \r\n    function openDashboard(e) {\r\n        const eventPayload = { \r\n            type: \"GO_TO_APP_STATE\", \r\n            label: \"cfx action\", \r\n            appName: \"user-dashboard/xnor_save_collection\", \r\n            pageName: null, \r\n            contexts: {\r\n                // Optional: Pass any context key-value pairs here\r\n             \r\n            } \r\n        };\r\n\r\n        // Send message to parent frame (CloudFabrix dashboard)\r\n        window.top.postMessage(eventPayload, \"*\");\r\n    }\r\n    // New function to show all options\r\n    function showAllOptions() {\r\n        // Clear any active highlights\r\n        document.querySelectorAll('.option, #add-command').forEach(opt => {\r\n            opt.classList.remove('bg-blue-100', 'focused-option');\r\n            opt.style.display = '';  // Show all options\r\n        });\r\n        \r\n        // Hide the Add Command option when showing all\r\n        const addCommandOption = document.getElementById('add-command');\r\n        addCommandOption.classList.add('hidden');\r\n    }\r\n    \r\n    // Filter options based on input and show \"Add Command\" if no match\r\n    dropdownInput.addEventListener('input', function () {\r\n        const filter = this.value.toLowerCase();\r\n        let matchFound = false;\r\n        let firstMatchingOption = null;\r\n\r\n        // Ensure dropdown is visible when typing\r\n        if (filter.trim() !== '') {\r\n            dropdownMenu.classList.remove('hidden');\r\n        }\r\n\r\n        // Reset any previous selection\r\n        document.querySelectorAll('.option, #add-command').forEach(opt => {\r\n            opt.classList.remove('bg-blue-100', 'focused-option');\r\n        });\r\n\r\n        options.forEach(option => {\r\n            const text = option.textContent.toLowerCase();\r\n            const isMatch = text.includes(filter);\r\n            option.style.display = isMatch ? '' : 'none';\r\n\r\n            if (isMatch) {\r\n                matchFound = true;\r\n                if (!firstMatchingOption) {\r\n                    firstMatchingOption = option;\r\n                }\r\n            }\r\n        });\r\n\r\n        // Show or hide the \"Add Command\" option\r\n        const addCommandOption = document.getElementById('add-command');\r\n        if (filter.trim() !== '' && !matchFound) {\r\n            addCommandOption.classList.remove('hidden');\r\n            document.getElementById('new-command-text').textContent = this.value;\r\n\r\n            // Focus the add command option when no matches\r\n            addCommandOption.classList.add('bg-blue-100', 'focused-option');\r\n        } else {\r\n            addCommandOption.classList.add('hidden');\r\n\r\n            // Focus the first matching option if available\r\n            if (firstMatchingOption) {\r\n                firstMatchingOption.classList.add('bg-blue-100', 'focused-option');\r\n            }\r\n        }\r\n    });\r\n\r\n    // Handle keyboard navigation\r\n    dropdownInput.addEventListener('keydown', function (e) {\r\n        // Only handle keyboard navigation if dropdown is visible\r\n        if (dropdownMenu.classList.contains('hidden')) return;\r\n\r\n        const focusedOption = document.querySelector('.focused-option');\r\n        const visibleOptions = Array.from(document.querySelectorAll('.option:not([style*=\"display: none\"]), #add-command:not(.hidden)'));\r\n\r\n        switch (e.key) {\r\n            case 'ArrowDown':\r\n                e.preventDefault();\r\n                if (focusedOption) {\r\n                    const currentIndex = visibleOptions.indexOf(focusedOption);\r\n                    const nextIndex = (currentIndex + 1) % visibleOptions.length;\r\n\r\n                    focusedOption.classList.remove('bg-blue-100', 'focused-option');\r\n                    visibleOptions[nextIndex].classList.add('bg-blue-100', 'focused-option');\r\n                } else if (visibleOptions.length > 0) {\r\n                    visibleOptions[0].classList.add('bg-blue-100', 'focused-option');\r\n                }\r\n                break;\r\n\r\n            case 'ArrowUp':\r\n                e.preventDefault();\r\n                if (focusedOption) {\r\n                    const currentIndex = visibleOptions.indexOf(focusedOption);\r\n                    const prevIndex = (currentIndex - 1 + visibleOptions.length) % visibleOptions.length;\r\n\r\n                    focusedOption.classList.remove('bg-blue-100', 'focused-option');\r\n                    visibleOptions[prevIndex].classList.add('bg-blue-100', 'focused-option');\r\n                } else if (visibleOptions.length > 0) {\r\n                    visibleOptions[visibleOptions.length - 1].classList.add('bg-blue-100', 'focused-option');\r\n                }\r\n                break;\r\n\r\n            // For the Enter key handler in the keydown event:\r\n            case 'Enter':\r\n                e.preventDefault();\r\n                if (focusedOption) {\r\n                    // If \"Add Command\" is selected\r\n                    if (focusedOption.id === 'add-command') {\r\n                        // Simulate clicking the Add Command option\r\n                        addCommandOption.click();\r\n                    } else {\r\n                        // Otherwise, it's a regular option\r\n                        focusedOption.click();\r\n                    }\r\n\r\n                    // Clear highlight from all options after selection\r\n                    document.querySelectorAll('.option, #add-command').forEach(opt => {\r\n                        opt.classList.remove('bg-blue-100', 'focused-option');\r\n                    });\r\n                }\r\n                break;\r\n\r\n                case 'Escape':\r\n                    e.preventDefault();\r\n                    dropdownMenu.classList.add('hidden');\r\n                    break;\r\n            }\r\n        });\r\n    \r\n    \r\n        // Extract the option click handler to a named function so we can reuse it\r\n        function handleOptionClick() {\r\n            const value = this.getAttribute('data-value');\r\n            const display = this.getAttribute('data-display');\r\n    \r\n            // Hide empty message if this is the first selection\r\n            if (selectedValues.length === 0) {\r\n                document.getElementById('empty-selection').style.display = 'none';\r\n            }\r\n    \r\n            // Add to selected values with empty rules array\r\n            selectedValues.push({\r\n                id: value,\r\n                display: display,\r\n                rules: []\r\n            });\r\n    \r\n            // Update the selection display\r\n            updateSelectionDisplay();\r\n    \r\n            // Clear search input but don't hide dropdown\r\n            dropdownInput.value = '';\r\n    \r\n            // Show all options again\r\n            options.forEach(opt => {\r\n                opt.style.display = '';\r\n            });\r\n        }\r\n    \r\n        // Add selected option as accordion\r\n        options.forEach(option => {\r\n            option.addEventListener('click', handleOptionClick);\r\n        });\r\n    \r\n        // Add handler for the \"Add Command\" option\r\n        const addCommandOption = document.getElementById('add-command');\r\n        addCommandOption.addEventListener('click', async function () {\r\n            const commandText = dropdownInput.value;\r\n            // Generate a new unique ID for the command\r\n            const newCommandId = 'CMD' + String(Math.floor(Math.random() * 9000) + 1000);\r\n    \r\n            // Add to selected values with empty rules array\r\n            selectedValues.push({\r\n                id: newCommandId,\r\n                display: commandText,\r\n                rules: []\r\n            });\r\n    \r\n            // Update the selection display\r\n            updateSelectionDisplay();\r\n    \r\n            // Hide empty message if this is the first selection\r\n            if (selectedValues.length === 1) {\r\n                document.getElementById('empty-selection').style.display = 'none';\r\n            }\r\n    \r\n            // Clear search input and hide dropdown\r\n            dropdownInput.value = '';\r\n            dropdownMenu.classList.add('hidden');\r\n    \r\n            // Add the new command to the dropdown options list too\r\n            const optionsContainer = dropdownMenu.querySelector('.py-1');\r\n            const newOptionDiv = document.createElement('div');\r\n            newOptionDiv.className = 'option px-4 py-2 cursor-pointer hover:bg-blue-50';\r\n            newOptionDiv.setAttribute('data-value', newCommandId);\r\n            newOptionDiv.setAttribute('data-display', commandText);\r\n            newOptionDiv.textContent = commandText;\r\n    \r\n            // Add event listener to the new option\r\n            newOptionDiv.addEventListener('click', handleOptionClick);\r\n    \r\n            // Insert before the \"Add Command\" option\r\n            optionsContainer.insertBefore(newOptionDiv, addCommandOption);\r\n    \r\n            // Update the options NodeList\r\n            options = document.querySelectorAll('.option');\r\n        });\r\n    \r\n        // Close add template modal\r\n        closeAddModal.addEventListener('click', function () {\r\n            addTemplateModal.classList.add('hidden');\r\n        });\r\n\r\n        function extractHeaders(template) {\r\n            const headerLines = template.match(/^Value\\s+(\\w+)/gm);\r\n            if (!headerLines) return [];\r\n\r\n            return headerLines.map(line => {\r\n                const match = line.match(/^Value\\s+(\\w+)/);\r\n                return match ? match[1] : null;\r\n            }).filter(Boolean);\r\n            }\r\n\r\n    \r\n        // Validate TextFSM template\r\n        validateBtn.addEventListener('click', async function (e) {\r\n            e.preventDefault();\r\n\r\n            const templateContent = document.getElementById('template-content').value;\r\n            const cliOutput = document.getElementById('cli-output').value;\r\n            const resultDisplay = document.getElementById('template-result');\r\n\r\n            if (!templateContent || !cliOutput) {\r\n                resultDisplay.innerHTML = '<span class=\"text-red-500\">Please provide both template and CLI output</span>';\r\n                return;\r\n            }\r\n\r\n            resultDisplay.innerHTML = '<span class=\"text-blue-500\">Validating...</span>';\r\n\r\n            try {\r\n                const response = await fetch('/api/v2/textfsms/validate_template', {\r\n                method: 'POST',\r\n                headers: { 'Content-Type': 'application/json' },\r\n                body: JSON.stringify({\r\n                    textfsm_template: templateContent,\r\n                    sample_input: cliOutput\r\n                })\r\n                });\r\n\r\n                const parsedData = await response.json();\r\n\r\n                if (!Array.isArray(parsedData) || parsedData.length === 0) {\r\n                resultDisplay.innerHTML = '<div class=\"text-red-500\">No parsed output.</div>';\r\n                return;\r\n                }\r\n\r\n                const headers = extractHeaders(templateContent);\r\n\r\n                if (headers.length === 0) {\r\n                resultDisplay.innerHTML = '<div class=\"text-red-500\">Could not extract headers from template.</div>';\r\n                return;\r\n                }\r\n\r\n                const tableHeaders = headers.map(h =>\r\n                `<th class=\"px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase\">${h}</th>`\r\n                ).join('');\r\n\r\n                const tableRows = parsedData.map(row =>\r\n                `<tr>${headers.map(h => `<td class=\"px-3 py-2 text-sm text-gray-500\">${row[h] || ''}</td>`).join('')}</tr>`\r\n                ).join('');\r\n\r\n                resultDisplay.innerHTML = `\r\n                <div class=\"text-green-600 mb-2\">\u2713 Template validated successfully</div>\r\n                <table class=\"min-w-full border divide-y divide-gray-200\">\r\n                    <thead class=\"bg-gray-100\"><tr>${tableHeaders}</tr></thead>\r\n                    <tbody class=\"bg-white divide-y divide-gray-200\">${tableRows}</tbody>\r\n                </table>\r\n                `;\r\n            } catch (err) {\r\n                console.error(\"Validation error:\", err);\r\n                resultDisplay.innerHTML = '<div class=\"text-red-500\">Error validating template.</div>';\r\n            }\r\n            });\r\n\r\n\r\n\r\n    \r\n        // Add template dropdown handler setup\r\n        function setupTemplateDropdown(ruleElement) {\r\n            const templateInput = ruleElement.querySelector('.template-input');\r\n            const templateToggle = ruleElement.querySelector('.template-dropdown-toggle');\r\n            const templateMenu = ruleElement.querySelector('.template-menu');\r\n            const templateOptions = ruleElement.querySelectorAll('.template-option');\r\n            const templateValue = ruleElement.querySelector('.template-value');\r\n            const addTemplateBtn = ruleElement.querySelector('.add-template');\r\n            const fsmcontainer = ruleElement.querySelector('#templateOptionsContainer');\r\n            if (fsmcontainer) {\r\n                populateTemplateOptions(fsmcontainer, ruleElement);\r\n            }\r\n\r\n            console.log(\"Dropdown setup:\", {\r\n                input: !!templateInput,\r\n                toggle: !!templateToggle,\r\n                menu: !!templateMenu\r\n                });\r\n\r\n    \r\n            if (!templateInput || !templateToggle || !templateMenu) return;\r\n    \r\n            // Toggle dropdown on click (same pattern as main dropdown)\r\n            function toggleTemplateMenu() {\r\n                console.log(\"Dropdown clicked\");\r\n                templateMenu.classList.toggle('hidden');\r\n            }\r\n    \r\n            templateToggle.addEventListener('click', toggleTemplateMenu);\r\n            templateInput.addEventListener('click', toggleTemplateMenu);\r\n    \r\n            // Filter template options based on input\r\n            templateInput.addEventListener('input', function () {\r\n                const filter = this.value.toLowerCase();\r\n                templateOptions.forEach(option => {\r\n                    const text = option.textContent.toLowerCase();\r\n                    option.style.display = text.includes(filter) ? '' : 'none';\r\n                });\r\n    \r\n                // Always show \"Add Template\" option\r\n                if (addTemplateBtn) {\r\n                    addTemplateBtn.style.display = '';\r\n                }\r\n            });\r\n    \r\n            // Template selection\r\n            templateOptions.forEach(option => {\r\n                option.addEventListener('click', function () {\r\n                    const value = this.getAttribute('data-value');\r\n                    const display = this.getAttribute('data-display');\r\n    \r\n                    // Update template input and hidden value\r\n                    templateInput.value = display;\r\n                    templateValue.value = value;\r\n    \r\n                    // Close dropdown\r\n                    templateMenu.classList.add('hidden');\r\n    \r\n                    // Update rule in data structure\r\n                    const commandItem = ruleElement.closest('.command-item');\r\n                    if (commandItem) {\r\n                        const commandId = commandItem.dataset.commandId;\r\n                        const ruleIndex = parseInt(ruleElement.dataset.ruleIndex);\r\n    \r\n                        const command = selectedValues.find(item => item.id === commandId);\r\n                        if (command && command.rules[ruleIndex]) {\r\n                            command.rules[ruleIndex].templateId = value;\r\n                            command.rules[ruleIndex].templateName = display;\r\n                            updateHiddenInput();\r\n                        }\r\n                    }\r\n                });\r\n            });\r\n    \r\n            // Add template button\r\n            if (addTemplateBtn) {\r\n                addTemplateBtn.addEventListener('click', function () {\r\n                    // Store reference to the current template input\r\n                    currentRuleElement = ruleElement;\r\n                    currentTemplateInput = templateInput;\r\n    \r\n                    // Show add template modal\r\n                    addTemplateModal.classList.remove('hidden');\r\n    \r\n                    // Hide template menu\r\n                    templateMenu.classList.add('hidden');\r\n                });\r\n            }\r\n\r\n\r\n            function populateTemplateOptions(container, ruleElement) {\r\n\r\n                container.innerHTML = '';\r\n            \r\n                cachedTextfsmTemplates.forEach(item => {\r\n                    const div = document.createElement('div');\r\n                    div.className = 'template-option px-3 py-1 cursor-pointer hover:bg-blue-50 text-sm';\r\n                    div.setAttribute('data-value', item.name);\r\n                    div.setAttribute('data-display', item.name);\r\n                    div.textContent = item.name;\r\n            \r\n                    div.addEventListener('click', function () {\r\n                        const ruleElement = this.closest('.rule-form');\r\n                        const templateInput = ruleElement.querySelector('.template-input');\r\n                        const templateValue = ruleElement.querySelector('.template-value');\r\n                        templateInput.value = item.name;\r\n                        templateValue.value = item.name;\r\n                        \r\n            \r\n                        container.parentElement.classList.add('hidden');\r\n            \r\n                        const commandId = ruleElement.closest('.command-item').dataset.commandId;\r\n                        const ruleIndex = parseInt(ruleElement.dataset.ruleIndex);\r\n                        const command = selectedValues.find(item => item.id === commandId);\r\n                        if (command && command.rules[ruleIndex]) {\r\n                            command.rules[ruleIndex].templateId = item.name;\r\n                            command.rules[ruleIndex].templateName = item.name;\r\n                            updateHiddenInput();\r\n                        }\r\n                    });\r\n            \r\n                    container.appendChild(div);\r\n                });\r\n            \r\n                const addDiv = document.createElement('div');\r\n                addDiv.className = 'add-template px-3 py-1 cursor-pointer hover:bg-green-50 text-green-600 font-medium text-sm';\r\n                addDiv.textContent = '+ Add TextFSM Template';\r\n                container.appendChild(addDiv);\r\n\r\n                addDiv.addEventListener('click', function () {\r\n                currentRuleElement = this.closest('.rule-form');\r\n                currentTemplateInput = this.closest('.relative').querySelector('.template-input');\r\n\r\n                const dropdown = this.closest('.template-menu');\r\n                if (dropdown) dropdown.classList.add('hidden'); // hide dropdown\r\n\r\n                // Show the modal\r\n                addTemplateModal.classList.remove('hidden');\r\n                });\r\n            }\r\n            \r\n\r\n\r\n            \r\n\r\n            const container = ruleElement.querySelector('#templateOptionsContainer');\r\n            if (container) {\r\n                populateTemplateOptions(container);\r\n            }\r\n            function toggleMenu() {\r\n                templateMenu.classList.toggle('hidden');\r\n            }\r\n\r\n            templateToggle.addEventListener('click', toggleTemplateMenu);\r\n            templateInput.addEventListener('click', toggleTemplateMenu);\r\n\r\n\r\n        }\r\n    \r\n        // Add new template via modal\r\n        addTemplateForm.addEventListener('submit', async function (e) {\r\n            e.preventDefault();\r\n    \r\n            const templateName = document.getElementById('template-name').value;\r\n            const templateContent = document.getElementById('template-content').value;\r\n            const cliOutput = document.getElementById('cli-output').value;\r\n\r\n            const payload = {\r\n                name: templateName,\r\n                description: \"text\",\r\n                textfsm_template: templateContent,\r\n                sample_input: cliOutput\r\n            };\r\n            console.log(\"%%%%%%\",payload)\r\n            try {\r\n                const response = await fetch('/api/v2/textfsms', {\r\n                    method: 'POST',\r\n                    headers: { 'Content-Type': 'application/json' },\r\n                    body: JSON.stringify(payload)\r\n                });\r\n            \r\n                if (!response.ok) {\r\n                    alert('Failed to save template to API.');\r\n                    return;\r\n                }\r\n            \r\n                alert('Template saved to API!');\r\n                await loadTextfsmData(); // Refresh the dropdown options\r\n            \r\n            } catch (err) {\r\n                console.error('API error:', err);\r\n                alert('API call failed.');\r\n            }\r\n    \r\n            // Create new template ID\r\n            const newTemplateId = 'TPL' + String(Math.floor(Math.random() * 900) + 100);\r\n    \r\n            // Add to all existing template dropdowns\r\n            document.querySelectorAll('.template-menu').forEach(menu => {\r\n                // Find the py-1 container - direct child approach\r\n                const container = menu.querySelector(':scope > .py-1');\r\n                if (!container) return;\r\n    \r\n                // Find the Add Template button as a direct child of the container\r\n                const addTemplateBtn = container.querySelector(':scope > .add-template');\r\n                if (!addTemplateBtn) return;\r\n    \r\n                // Create the new option element directly rather than using innerHTML\r\n                const newOption = document.createElement('div');\r\n                newOption.className = 'template-option px-3 py-1 cursor-pointer hover:bg-blue-50 text-sm';\r\n                newOption.setAttribute('data-value', newTemplateId);\r\n                newOption.setAttribute('data-display', templateName);\r\n                newOption.textContent = templateName; // This is key - using textContent not innerHTML\r\n    \r\n                // Add click event handler\r\n                newOption.addEventListener('click', function () {\r\n                    const value = this.getAttribute('data-value');\r\n                    const display = this.getAttribute('data-display');\r\n    \r\n                    // Get parent elements\r\n                    const dropdown = this.closest('.template-menu');\r\n                    const relativeContainer = dropdown.closest('.relative');\r\n                    const templateInput = relativeContainer.querySelector('.template-input');\r\n                    const templateValue = relativeContainer.querySelector('.template-value');\r\n    \r\n                    // Update template input and hidden value\r\n                    if (templateInput) templateInput.value = display;\r\n                    if (templateValue) templateValue.value = value;\r\n    \r\n                    // Close dropdown\r\n                    dropdown.classList.add('hidden');\r\n    \r\n                    // Update rule in data structure\r\n                    const ruleElement = dropdown.closest('.rule-form');\r\n                    const commandItem = ruleElement.closest('.command-item');\r\n                    if (commandItem && ruleElement) {\r\n                        const commandId = commandItem.dataset.commandId;\r\n                        const ruleIndex = parseInt(ruleElement.dataset.ruleIndex);\r\n    \r\n                        const command = selectedValues.find(item => item.id === commandId);\r\n                        if (command && command.rules[ruleIndex]) {\r\n                            command.rules[ruleIndex].templateId = value;\r\n                            command.rules[ruleIndex].templateName = display;\r\n                            updateHiddenInput();\r\n                        }\r\n                    }\r\n                });\r\n    \r\n                // Insert before \"Add Template\" option\r\n                container.insertBefore(newOption, addTemplateBtn);\r\n            });\r\n    \r\n            // Add to template in rule template (for future rules)\r\n            const ruleTemplateContainer = ruleTemplate.content.querySelector('.template-menu > .py-1');\r\n            if (ruleTemplateContainer) {\r\n                const addTemplateBtn = ruleTemplateContainer.querySelector(':scope > .add-template');\r\n                if (addTemplate