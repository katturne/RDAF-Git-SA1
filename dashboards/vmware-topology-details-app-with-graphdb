      "name": "documentation",
      "value": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Conexus Menu Documentation</title>\r\n    <link rel=\"stylesheet\" href=\"styles.css\">\r\n    <style>\r\n        body, html {\r\n            margin: 0;\r\n            padding: 0;\r\n            height: 100%;\r\n            font-family: Arial, sans-serif;\r\n        }\r\n\r\n        header {\r\n            padding: 10px;\r\n            background-color: #333;\r\n            color: white;\r\n            text-align: center;\r\n        }\r\n\r\n        nav {\r\n            background-color: #f4f4f4;\r\n            padding: 10px;\r\n            position: fixed;\r\n            top: 50px;\r\n            left: 0;\r\n            width: 200px;\r\n            height: 100%;\r\n            overflow: auto;\r\n        }\r\n\r\n        nav ul {\r\n            list-style-type: none;\r\n            padding: 0;\r\n        }\r\n\r\n        nav ul li {\r\n            padding: 8px;\r\n        }\r\n\r\n        nav ul li a {\r\n            text-decoration: none;\r\n            color: black;\r\n            display: block;\r\n        }\r\n\r\n        nav ul li a:hover {\r\n            background-color: #ddd;\r\n        }\r\n\r\n        main {\r\n            margin-left: 150px;\r\n            padding: 20px;\r\n            overflow: auto;\r\n            height: calc(100% - 70px);\r\n            max-width: calc(100% - 210px);\r\n            box-sizing: border-box;\r\n        }\r\n\r\n        section {\r\n            margin-bottom: 20px;\r\n            width: 100%;\r\n            max-width: calc(100% - 210px); /* Keeps the section within the main content area */\r\n        }\r\n\r\n        section img {\r\n            max-width: 100%;\r\n            height: auto;\r\n        }\r\n        \r\n\r\n        /* Styling for collapsible sections */\r\n        details {\r\n            margin-bottom: 15px;\r\n        }\r\n\r\n        summary {\r\n            background-color: #00BCEB;\r\n            padding: 10px;\r\n            border: 1px solid #ddd;\r\n            cursor: pointer;\r\n            font-weight: bold;\r\n        }\r\n\r\n        .rda-pack-summary {\r\n            padding: 10px;\r\n            background-color: #00BCEB;\r\n            border-top: 1px solid #ddd;\r\n        }\r\n\r\n        table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n        }\r\n\r\n        table th, table td {\r\n            padding: 10px;\r\n            border: 1px solid #ddd;\r\n            text-align: left;\r\n        }\r\n\r\n        table th {\r\n            background-color: #00BCEB;\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n    <header>\r\n        <h1>Conexus Menu Documentation</h1>\r\n        <p>This page provides an overview of the Conexus menu structure and details of its sections and submenus.</p>\r\n    </header>\r\n\r\n    <!-- Navigation Menu -->\r\n    <nav>\r\n        <ul>\r\n            <li><a href=\"#menu-structure\">Menu Structure</a></li>\r\n            <li><a href=\"#executive-summary\">Executive Summary</a></li>\r\n            <li><a href=\"#asset-management\">Asset Management</a></li>\r\n            <li><a href=\"#service-assurance\">Service Assurance</a></li>\r\n            <li><a href=\"#networks\">Networks</a></li>\r\n            <li><a href=\"#auto-x-tools\">Auto-X Tools</a></li>\r\n        </ul>\r\n    </nav>\r\n\r\n    <!-- Main Content -->\r\n    <main>\r\n        <!-- Conexus Menu Structure -->\r\n        <section id=\"menu-structure\">\r\n            <h2>Conexus Menu Structure</h2>\r\n            <div style='text-align:left;width:100%;height:100%;'><img src='/iconlib/03f06e51' alt=1Italian  </div>\r\n            <p>The Conexus menu consists of several sections that provide access to various tools and information.</p>\r\n        </section>\r\n\r\n        <!-- Executive Summary -->\r\n        <section id=\"executive-summary\">\r\n            <h2>Executive Summary</h2>\r\n            <!-- <img src=\"images/executive-summary.png\" alt=\"Executive Summary Menu\"> -->\r\n            <details open>\r\n                <summary>Network Summary</summary>\r\n                <div class=\"rda-pack-summary\">\r\n                    <p>Provides a snapshot of the number of devices under the Campus, Retail, and Data Center networks and NuDOC.</p>\r\n                </div>\r\n            </details>\r\n            <details>\r\n                <summary>Auto-X Adoption</summary>\r\n                <div class=\"rda-pack-summary\">\r\n                    <p>Provides a historical view of user adoption across different tools: Catalyst Center, SPOG, BPA, NSO, and NuDOC.</p>\r\n                </div>\r\n            </details>\r\n            <details>\r\n                <summary>Catalyst Center Adoption</summary>\r\n                <div class=\"rda-pack-summary\">\r\n                    <p>Provides snapshot of devices across all the Catalyst Center grouped by device types\u200b</p>\r\n                </div>\r\n            </details>\r\n            <details>\r\n                <summary>CatC and Prime Historic Adoption</summary>\r\n                <div class=\"rda-pack-summary\">\r\n                    <p>Provides the device count evolution in time for both Prime and CatC, as well as a 4-week and 3-month AP delta count\u200b</p>\r\n                </div>\r\n            </details>\r\n            <details>\r\n                <summary>NDFC Adoption</summary>\r\n                <div class=\"rda-pack-summary\">\r\n                    <p>Provides snapshot of devices across all the NDFCs grouped by device types and number of interfaces\u200b\u200b</p>\r\n                </div>\r\n            </details>\r\n            <details>\r\n                <summary>RTO CatC Network </summary>\r\n                <div class=\"rda-pack-summary\">\r\n                    <p>\u200bProvides snapshot and historical view of client and data usage of devices under Catalyst Center flagged as RTO\u200b</p>\r\n                </div>\r\n            </details>\r\n            <details>\r\n                <summary>RTO Prime Network</summary>\r\n                <div class=\"rda-pack-summary\">\r\n                    <p>Provides snapshot and historical view of client and data usage of devices under Prime flagged as RTO\u200b\u200b</p>\r\n                </div>\r\n            </details>\r\n            <details>\r\n                <summary>Ticketing Summary</summary>\r\n                <div class=\"rda-pack-summary\">\r\n                    <p>Provides a summary of the current number of devices enabled for ticketing, currently ticketing and if they are not sending syslog/SNMP traps\u200b\u200b\u200b</p>\r\n                </div>\r\n            </details>\r\n        </section>\r\n\r\n\r\n        <!-- Asset Management -->\r\n        <section id=\"asset-management\">\r\n            <h2>Asset Management</h2>\r\n            <!-- <img src=\"images/asset-management.png\" alt=\"Asset Management Menu\"> -->\r\n            <details>\r\n                <summary>Conexus Inventory</summary>\r\n                <div class=\"rda-pack-summary\">\r\n                    <p>Provides a consolidated view of unique devices in the Conexus network across different sources (i.e CatC, NDFC, NuDoc, etc).\u200b</p> \r\n                     <p>Devices are de-duplicated based on valid serial numbers. It contains filters based on source, network, service assurance, BPA, reachability, etc\u200b.</p>\r\n                </div>\r\n            </details>\r\n            <details>\r\n                <summary>Campus Inventory</summary>\r\n                <div class=\"rda-pack-summary\">\r\n                    <p>Lists all devices across Catalyst Centers that are part of the Conexus Campus network.</p>\r\n                </div>\r\n            </details>\r\n            <details>\r\n                <summary>Retail Inventory</summary>\r\n                <div class=\"rda-pack-summary\">\r\n                    <p>Provides list of all devices across all Catalyst Centers that are part of Conexus Retail network\u200b</p>\r\n                </div>\r\n            </details>\r\n            <details>\r\n                <summary>NDFC Inventory</summary>\r\n                <div class=\"rda-pack-summary\">\r\n                    <p>Provides list of all devices across all NDFCs in the Data Center network\u200b\u200b</p>\r\n                </div>\r\n            </details>\r\n            <details>\r\n                <summary>nuDOC Inventory</summary>\r\n                <div class=\"rda-pack-summary\">\r\n                    <p> Provides list of all devices part of nuDoc\u200b\u200b</p>\r\n                </div>\r\n            </details>\r\n            <details>\r\n                <summary>Discovery Inventory</summary>\r\n                <div class=\"rda-pack-summary\">\r\n                    <p>Provides list of all devices that are SNMP discovered by RDAF\u200b\u200b\u200b</p>\r\n                </div>\r\n            </details>\r\n            <details>\r\n                <summary>CDP Neighbors</summary>\r\n                <div class=\"rda-pack-summary\">\r\n                    <p>\u200b</p>\r\n                </div>\r\n            </details>  \r\n        </section>\r\n\r\n        <!-- Service Assurance -->\r\n        <section id=\"service-assurance\">\r\n            <h2>Service Assurance</h2>\r\n            <!-- <img src=\"images/service-assurance.png\" alt=\"Service Assurance Menu\"> -->\r\n\r\n            <table>\r\n                <thead>\r\n                    <tr>\r\n                        <th>Service Assurance Options</th>\r\n                        <th>Sub options</th>\r\n                    </tr>\r\n                </thead>\r\n                <tbody>\r\n                    <tr>\r\n                        <td>Incidents</td>\r\n                        <td><p>View of incidents raised from alerts. Users can see:</p>\r\n                            <ul>\r\n                                <li>Open/Resolved/Total incidents</li>\r\n                                <li>Open Incidents by Source and Priority</li>\r\n                                <li>Incidents trend</li>\r\n                                <li>Incidents list with columns (Summary, Device IP, Device Hostname, Priority, Source, ITSM ticket, etc\u200b)</li>\r\n                            </ul>\r\n                        </td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td>Alerts</td>\r\n                        <td><p>View of alerts raised from syslogs, snmp traps, events from catalyst center, snmp polling, etc. User can see:</p>\r\n                            <ul>\r\n                                <li>Total Active/Suppressed/Cleared/Deduped/Ingested alerts\u200b</li>\r\n                                <li>Active Alerts by Source and Severity</li>\r\n                                <li>Alerts trend</li>\r\n                                <li>Alerts list with columns i.e Asset associated with the alert, IP, Message, Status, Severity, Incident, etc.</li>\r\n                            </ul>\r\n                            <p><strong>NOTE: Alerts are created only for the events as finalized by AT&T in the fault matrix. As an example, not every syslog will result in an alert. Only the syslogs identified as per fault matrix for each device type will generate an alert.\u200b</strong></p>\r\n                        </td>\r\n                    </tr>\r\n\r\n\r\n                    \r\n                    <tr>\r\n                        <td>SA Management</td>\r\n                        <td>\r\n                            <details>\r\n                                <summary>SA Ticketing Report</summary>\r\n                                <div class=\"rda-pack-summary\">\r\n                                    <p>Provides an overview of the tickets created, auto closed and MTTR per organization group\r\n                                    \u200b</p>\r\n                                </div>\r\n                            </details>\r\n                            <details>    \r\n                                <summary>SA Onboarding</summary>\r\n                                <div class=\"rda-pack-summary\">\r\n                                    <p>Provides a current snapshot of the devices onboarding status within RDAF i.e RDAF receiving syslog/SNMP traps, Orchestrator onboarded, reachability, etc\u200b\r\n                                    \u200b</p>\r\n                                </div>\r\n                            </details>\r\n                        </td>\r\n                    </tr>\r\n\r\n\r\n\r\n                    <tr>\r\n                        <td>Performance Management</td>\r\n                        <td>\r\n                            <details>\r\n                                <summary>PM Exec</summary>\r\n                                <div class=\"rda-pack-summary\">\r\n                                    <p>High level view of performance metrics of devices being monitored.\r\n                                    User can see:</p>\r\n                                        <ul>\r\n                                            <li>Top 5 devices with highest CPU utilization/Memory utilization\u200b\u200b</li>\r\n                                            <li>Trends for CPU and Memory usage trend, fan speed, device temperature. Device list with columns i.e IP, model, SW\u200b</li>\r\n                                            <li>Port Usage Summary</li>\r\n                                            <li>Interface Status\u200b</li>\r\n                                        </ul>\r\n                                    </p>\r\n                                    <p><strong>Note: The metrics are currently enabled only for 20 devices. More devices will be enabled in future.\u200b</strong></p>\r\n                                </div>\r\n                            </details>\r\n                        </td>\r\n                    </tr>\r\n\r\n\r\n                    <tr>\r\n                        <td>Data Collection</td>\r\n                        <td>\r\n                            <details>\r\n                                <summary>Syslogs</summary>\r\n                                <div class=\"rda-pack-summary\">\r\n                                    <p>List of all syslogs received from devices in last 7 days\u200b\u200b\u200b\r\n                                    </p>\r\n                                </div>\r\n                            </details>\r\n                            <details>\r\n                                <summary>SNMP Traps</summary>\r\n                                <div class=\"rda-pack-summary\">\r\n                                    <p>List of all SNMP traps received from devices in last 30 days.\u200b\u200b</p>\r\n                                </div>\r\n                            </details>\r\n                        </td>\r\n                    </tr>\r\n                    \r\n\r\n                </tbody>\r\n            </table>\r\n\r\n\r\n        <!-- Networks -->\r\n        <section id=\"networks\">\r\n            <h2>Networks</h2>\r\n            <!-- <img src=\"images/networks.png\" alt=\"Networks Menu\"> -->\r\n            <details>\r\n                <summary>Campus Network</summary>\r\n                <div class=\"rda-pack-summary\">\r\n                    <p>Redirects to dashboard apps for the Campus Network (source is Catalyst Center)\u200b.</p>\r\n                </div>\r\n            </details>\r\n            <details>\r\n                <summary>Retail Network</summary>\r\n                <div class=\"rda-pack-summary\">\r\n                    <p>Redirects to dashboard apps for the Retail Network (source is Catalyst Center).</p>\r\n                </div>\r\n            </details>\r\n            <details>\r\n                <summary>CC Leadership View</summary>\r\n                <div class=\"rda-pack-summary\">\r\n                    <p>Shows the list of devices from Campus network identified as \u201cexecutive\u201d sites\u200b.</p>\r\n                </div>\r\n            </details>\r\n            <details>\r\n                <summary>Data Center Network</summary>\r\n                <div class=\"rda-pack-summary\">\r\n                    <p>Redirect to the dashboard apps for the Data Center Network (source is NDFC).</p>\r\n                </div>\r\n            </details>\r\n\r\n\r\n            <details>\r\n                <summary>Central Office Network</summary>\r\n                <div class=\"rda-pack-summary\">\r\n                    <p>Shows the inventory dashboard for devices part of Central Office. Devices are categorized based on FQDN.\u200b</p>\r\n                </div>\r\n            </details>\r\n\r\n\r\n            <details>\r\n                <summary>Call Center Network</summary>\r\n                <div class=\"rda-pack-summary\">\r\n                    <p>Redirect to the dashboard apps for the Call Center Network (source is devices from Discovery inventory that belong to Call Center)\u200b</p>\r\n                </div>\r\n            </details>\r\n        </section>\r\n\r\n        <!-- Auto-X Tools -->\r\n        <section id=\"auto-x-tools\">\r\n            <h2>Auto-X Tools</h2>\r\n            <!-- <img src=\"images/auto-x-tools.png\" alt=\"Auto-X Tools Menu\"> -->\r\n            <details>\r\n                <summary>Config Orchestration</summary>\r\n                <div class=\"rda-pack-summary\">\r\n                    <p>Redirection to the production BPA.</p>\r\n                </div>\r\n            </details>\r\n            <details>\r\n                <summary>Port Tracking</summary>\r\n                <div class=\"rda-pack-summary\">\r\n                    <p>Redirection to the production nuDOC.</p>\r\n                </div>\r\n            </details>\r\n        </section>\r\n    </main>\r\n</body>\r\n</html>\r\n\r\n"
    }
