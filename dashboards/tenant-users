{
  "name": "rdaf_system_health_trends",
  "label": "RDAF System Health Trends",
  "description": "RDAF System Health Trends",
  "version": "1.0.1",
  "enabled": true,
  "status_poller": {},
  "dashboard_type": "app",
  "is_template": true,
  "custom_context": {
    "rda-dashboard-live-edit": true
  },
  "computedContext": {
    "RDAF_NAME": {
      "expr": "'rdaf-prod'"
    },
    "NOW": {
      "expr": "now().replace(hour = 0, minute = 0, second = 0, microsecond = 0).isoformat()"
    },
    "DAY_1_AGO": {
      "expr": "now().replace(hour = 0, minute = 0, second = 0, microsecond = 0).isoformat()"
    },
    "DAY_2_AGO": {
      "expr": "(now().replace(hour = 0, minute = 0, second = 0, microsecond = 0) - timedelta(days=1)).isoformat()"
    },
    "DAY_3_AGO": {
      "expr": "(now().replace(hour = 0, minute = 0, second = 0, microsecond = 0) - timedelta(days=2)).isoformat()"
    },
    "DAY_4_AGO": {
      "expr": "(now().replace(hour = 0, minute = 0, second = 0, microsecond = 0) - timedelta(days=3)).isoformat()"
    },
    "TODAY": {
      "expr": "now().strftime('%B %d, %Y')"
    }
  },
  "dashboard_pages": [
    {
      "name": "host_os_performance_metrics",
      "label": "Host OS Metrics",
      "icon": "pipeline.svg"
    },
    {
      "name": "alert_trend_snap",
      "label": "Alert Trend",
      "icon": "alert.svg"
    },
    {
      "name": "alert_analysis",
      "label": "Alert Analysis",
      "icon": "alertGroups.svg"
    },
    {
      "name": "pipeline_failure_trends",
      "label": "Pipeline Failure Trend",
      "icon": "trace.svg"
    },
    {
      "name": "artifact_change_trends",
      "label": "Artifact Changes Trend",
      "icon": "changes.svg"
    },
    {
      "name": "user_activity_trends",
      "label": "User Activity",
      "icon": "customer.svg"
    }
  ],
  "dashboard_folder": "RDAF_Health_Trends"
}