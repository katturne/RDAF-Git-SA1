d to command's rules\r\n                commandItem.rules.push(newRule);\r\n\r\n                // Create and add rule element\r\n                const ruleElement = createRuleElement(newRule, commandItem.rules.length - 1);\r\n                rulesContainer.appendChild(ruleElement);\r\n\r\n                // Update hidden input\r\n                updateHiddenInput();\r\n            });\r\n        });\r\n\r\n        // Make commands sortable\r\n        makeCommandsSortable();\r\n\r\n\r\n        // Update hidden input\r\n        updateHiddenInput();\r\n    }\r\n\r\n    // Function to create a rule element\r\n    function createRuleElement(rule, ruleIndex) {\r\n        const ruleElement = document.importNode(ruleTemplate.content, true).firstElementChild;\r\n\r\n        // Add data attribute for rule index\r\n        ruleElement.dataset.ruleIndex = ruleIndex;\r\n\r\n        // Set initial values\r\n        const operationSelect = ruleElement.querySelector('.rule-operation');\r\n        const valueInput = ruleElement.querySelector('.rule-value');\r\n        const valueContainer = ruleElement.querySelector('.value-container');\r\n\r\n        operationSelect.value = rule.operation;\r\n        valueInput.value = rule.value || '';\r\n\r\n        // Set up TextFSM specific fields if needed\r\n        const textfsmInputs = ruleElement.querySelector('.rule-textfsm-inputs');\r\n\r\n        if (rule.operation === 'textfsm') {\r\n            textfsmInputs.classList.remove('hidden');\r\n            valueContainer.classList.add('hidden');\r\n\r\n            // Set template input value if it exists\r\n            const templateInput = ruleElement.querySelector('.template-input');\r\n            const templateValue = ruleElement.querySelector('.template-value');\r\n\r\n            if (templateInput && rule.templateName) {\r\n                templateInput.value = rule.templateName;\r\n            }\r\n\r\n            if (templateValue && rule.templateId) {\r\n                templateVa