      "value": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Organization & Executive Summary</title>\n<style>\n    body {\n        font-family: Arial, sans-serif;\n        padding: 20px;\n        background: url(\"/iconlib/background\") no-repeat center center fixed;\n        background-size: cover;\n        color: white;\n    }\n\n    .section {\n        border: 2px solid #ccc;\n        border-radius: 8px;\n        background: rgba(255, 255, 255, 0.95);\n        color: black;\n        margin-bottom: 40px;\n        overflow: hidden;\n    }\n\n    .section-header {\n        background-color: #07182D;\n        color: white;\n        font-size: 20px;\n        font-weight: bold;\n        padding: 10px;\n    }\n\n    .section-content {\n        padding: 20px;\n        text-align: center;\n    }\n\n    img {\n        max-width: 100%;\n        border-radius: 5px;\n        height: auto;\n        margin: 10px 0;\n    }\n\n    table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-top: 20px;\n    }\n    th, td {\n        padding: 10px;\n        border: 1px solid #ccc;\n        text-align: center;\n    }\n    th {\n        background-color: #07182D;\n        color: white;\n    }\n    tr:nth-child(even) {\n        background-color: #f2f2f2;\n    }\n</style>\n</head>\n<body>\n\n<!-- Organization Section -->\n<div class=\"section\">\n    <div class=\"section-header\">Organization</div>\n    <div class=\"section-content\">\n        <img src=\"/iconlib/orgchart\" alt=\"Organization Chart\">\n        <img src=\"/iconlib/orgchart-1\" alt=\"Organization Chart 2\">\n    </div>\n</div>\n\n<!-- Executive Summary Section -->\n<div class=\"section\">\n    <div class=\"section-header\">Executive Summary</div>\n    <div class=\"section-content\">\n        <table id=\"dataTable\">\n            <thead>\n                <tr><th>Metric</th><th>Value</th></tr>\n            </thead>\n            <tbody></tbody>\n        </table>\n    </div>\n</div>\n\n<script>\nasync function loadData() {\n    try {\n        const response = await fetch('/api/v2/pstreams/pstream/data_trial/data');\n        if (!response.ok) throw new Error('Failed to fetch data');\n        \n        const json = await response.json();\n        console.log(\"Fetched JSON:\", json);\n\n        const table = document.getElementById(\"dataTable\");\n        const thead = table.querySelector(\"thead\");\n        const tbody = table.querySelector(\"tbody\");\n\n        tbody.innerHTML = \"\";\n        thead.innerHTML = \"\";\n\n        if (!json.pstream_data || json.pstream_data.length === 0) {\n            tbody.innerHTML = `<tr><td colspan=\"100%\">No data available</td></tr>`;\n            return;\n        }\n\n        const excludeKeys = [\"__uuid\", \"timestamp\", \"count_\", \"_RDA_Id\"];\n        const columns = Object.keys(json.pstream_data[0]).filter(k => !excludeKeys.includes(k));\n\n        // Create table header\n        const headerRow = document.createElement(\"tr\");\n        columns.forEach(col => {\n            const th = document.createElement(\"th\");\n            th.textContent = col;\n            headerRow.appendChild(th);\n        });\n        thead.appendChild(headerRow);\n\n        // Create rows\n        json.pstream_data.forEach(row => {\n            const tr = document.createElement(\"tr\");\n            columns.forEach(col => {\n                const td = document.createElement(\"td\");\n                td.textContent = row[col] || \"\";\n                tr.appendChild(td);\n            });\n            tbody.appendChild(tr);\n        });\n\n    } catch (err) {\n        console.error(\"Error fetching/parsing stream:\", err);\n    }\n}\n\nloadData();\n</script>\n\n</body>\n</html>\n"
    }
