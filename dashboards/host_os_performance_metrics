{
  "name": "host_os_performance_metrics",
  "label": "Host OS Performance Metrics",
  "description": "Host OS Performance Metrics Dashboard",
  "version": "2024-05-23_1",
  "enabled": true,
  "live_edit": true,
  "debug": true,
  "dashboard_style": "tabbed",
  "dashboard_folder": "RDAF_Health_Trends",
  "dashboard_type": "template",
  "custom_context": {
    "rda-dashboard-live-edit": true
  },
  "template_variables": {
    "RDAF_NAME": {
      "contextId": [
        "RDAF_NAME"
      ]
    }
  },
  "status_poller": {
    "stream": "host_os_metrics",
    "frequency": 600,
    "columns": [
      "timestamp"
    ],
    "sorting": [
      {
        "timestamp": "desc"
      }
    ],
    "query": "timestamp is after '${timestamp}'",
    "defaults": {
      "timestamp": "$UTCNOW"
    },
    "action": "refresh"
  },
  "dashboard_filters": {
    "time_filter": true,
    "default_time_filter_labels": [
      "Last 24 hours"
    ],
    "columns_filter": [
      {
        "id": "timestamp",
        "label": "Timestamp",
        "type": "DATETIME"
      },
      {
        "id": "tags_deployment",
        "label": "RDAF Deployment",
        "type": "TEXT"
      },
      {
        "id": "name",
        "label": "Metric Name",
        "type": "TEXT"
      },
      {
        "id": "tags_container_name",
        "label": "Container Name",
        "type": "TEXT"
      },
      {
        "id": "tags_host_ip",
        "label": "Host IP",
        "type": "TEXT"
      },
      {
        "id": "tags_host",
        "label": "Hostname",
        "type": "TEXT"
      }
    ],
    "group_filters": [
      {
        "stream": "host_os_metrics",
        "title": "RDAF Deployment",
        "limit": 50,
        "group_by": [
          "tags_deployment"
        ],
        "ts_column": "timestamp",
        "agg": "cardinality",
        "column": "tags_deployment",
        "type": "int",
        "show_counts": false
      },
      {
        "stream": "host_os_metrics",
        "title": "Hostname",
        "limit": 50,
        "group_by": [
          "tags_host"
        ],
        "ts_column": "timestamp",
        "agg": "cardinality",
        "column": "tags_host",
        "type": "int",
        "show_counts": false
      },
      {
        "stream": "host_os_metrics",
        "title": "Host IP",
        "limit": 50,
        "group_by": [
          "tags_host_ip"
        ],
        "ts_column": "timestamp",
        "agg": "cardinality",
        "column": "tags_host_ip",
        "type": "str",
        "show_counts": false
      },
      {
        "stream": "host_os_metrics",
        "title": "Metric Name",
        "limit": 50,
        "group_by": [
          "name"
        ],
        "ts_column": "timestamp",
        "agg": "cardinality",
        "column": "name",
        "type": "str",
        "show_counts": false
      },
      {
        "stream": "host_os_metrics",
        "title": "Device Name",
        "limit": 50,
        "group_by": [
          "tags_device"
        ],
        "ts_column": "timestamp",
        "agg": "cardinality",
        "column": "name",
        "type": "str",
        "show_counts": false
      },
      {
        "stream": "host_os_metrics",
        "title": "Tag Device",
        "limit": 50,
        "group_by": [
          "tags_device"
        ],
        "ts_column": "timestamp",
        "agg": "cardinality",
        "column": "count_",
        "type": "int",
        "show_counts": false
      }
    ]
  },
