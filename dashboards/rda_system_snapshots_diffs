      "name": "main.html",
      "value": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Pack Configuration Wizard</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    colors: {\n                        primary: '#3B82F6',\n                        secondary: '#10B981',\n                        accent: '#F59E0B'\n                    }\n                }\n            }\n        }\n    </script>\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n    <div class=\"container mx-auto px-4 py-8 max-w-4xl\">\n        <!-- Header -->\n        <div class=\"text-center mb-8\">\n            <h1 class=\"text-3xl font-bold text-gray-800 mb-2\">Pack Configuration Wizard</h1>\n            <p class=\"text-gray-600\">Follow the steps below to configure your data pack</p>\n        </div>\n\n        <!-- Progress Bar -->\n        <div class=\"mb-8\">\n            <div class=\"flex items-center justify-between mb-4\">\n                <div class=\"flex items-center justify-between w-full\">\n                    <div class=\"flex flex-col items-center\">\n                        <div id=\"step1-indicator\" class=\"flex items-center justify-center w-10 h-10 bg-primary text-white rounded-full font-semibold mb-2\">\n                            1\n                        </div>\n                        <span class=\"text-sm text-gray-600 text-center\">Customer Info</span>\n                    </div>\n                    <div class=\"flex-1 h-1 bg-gray-300 mx-4 hidden md:block\" id=\"progress1\"></div>\n                    <div class=\"flex flex-col items-center\">\n                        <div id=\"step2-indicator\" class=\"flex items-center justify-center w-10 h-10 bg-gray-300 text-gray-500 rounded-full font-semibold mb-2\">\n                            2\n                        </div>\n                        <span class=\"text-sm text-gray-600 text-center\">Data Source</span>\n                    </div>\n                    <div class=\"flex-1 h-1 bg-gray-300 mx-4 hidden md:block\" id=\"progress2\"></div>\n                    <div class=\"flex flex-col items-center\">\n                        <div id=\"step3-indicator\" class=\"flex items-center justify-center w-10 h-10 bg-gray-300 text-gray-500 rounded-full font-semibold mb-2\">\n                            3\n                        </div>\n                        <span class=\"text-sm text-gray-600 text-center\">Data Collection</span>\n                    </div>\n                    <div class=\"flex-1 h-1 bg-gray-300 mx-4 hidden md:block\" id=\"progress3\"></div>\n                    <div class=\"flex flex-col items-center\">\n                        <div id=\"step4-indicator\" class=\"flex items-center justify-center w-10 h-10 bg-gray-300 text-gray-500 rounded-full font-semibold mb-2\">\n                            4\n                        </div>\n                        <span class=\"text-sm text-gray-600 text-center\">Complete</span>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Wizard Content -->\n        <div class=\"bg-white rounded-lg shadow-lg p-8\">\n            <!-- Step 1: Customer Name and Logo -->\n            <div id=\"step1\" class=\"step-content\">\n                <div class=\"text-center mb-6\">\n                    <i class=\"fas fa-user-cog text-4xl text-primary mb-4\"></i>\n                    <h2 class=\"text-2xl font-semibold text-gray-800 mb-2\">Customer Information</h2>\n                    <p class=\"text-gray-600\">Please provide your customer name and upload your logo</p>\n                </div>\n                \n                <div class=\"space-y-6\">\n                    <!-- Customer Name Input -->\n                    <div>\n                        <label for=\"customerName\" class=\"block text-sm font-medium text-gray-700 mb-2\">\n                            Customer Name <span class=\"text-red-500\">*</span>\n                        </label>\n                        <input \n                            type=\"text\" \n                            id=\"customerName\" \n                            name=\"customerName\"\n                            class=\"w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all\"\n                            placeholder=\"Enter customer name\"\n                            required\n                        >\n                        <p class=\"text-sm text-red-500 mt-1 hidden\" id=\"customerNameError\">Customer name is required</p>\n                    </div>\n\n                    <!-- Logo Upload -->\n                    <div>\n                        <label for=\"customerLogo\" class=\"block text-sm font-medium text-gray-700 mb-2\">\n                            Customer Logo\n                        </label>\n                        <div class=\"relative border-2 border-dashed border-gray-300 rounded-lg p-6 text-center hover:border-primary transition-colors\">\n                            <input \n                                type=\"file\" \n                                id=\"customerLogo\" \n                                name=\"customerLogo\"\n                                accept=\"image/*\"\n                                class=\"absolute inset-0 w-full h-full opacity-0 cursor-pointer\"\n                            >\n                            <div id=\"logoUploadContent\">\n                                <i class=\"fas fa-cloud-upload-alt text-3xl text-gray-400 mb-2\"></i>\n                                <p class=\"text-gray-600\">Click to upload or drag and drop</p>\n                                <p class=\"text-sm text-gray-500\">PNG, JPG, SVG up to 10MB</p>\n                            </div>\n                            <div id=\"logoPreview\" class=\"hidden\">\n                                <img id=\"logoImage\" class=\"mx-auto max-h-20 mb-2\" alt=\"Logo preview\">\n                                <p class=\"text-sm text-gray-600\" id=\"logoFileName\"></p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Step 2: Data Source Choice -->\n            <div id=\"step2\" class=\"step-content hidden\">\n                <div class=\"text-center mb-6\">\n                    <i class=\"fas fa-database text-4xl text-primary mb-4\"></i>\n                    <h2 class=\"text-2xl font-semibold text-gray-800 mb-2\">Choose Data Source</h2>\n                    <p class=\"text-gray-600\">Select how you want to provide your data</p>\n                </div>\n\n                <div class=\"grid md:grid-cols-3 gap-6\">\n                    <!-- Offline Data Option -->\n                    <div class=\"data-source-option border-2 border-gray-200 rounded-lg p-6 cursor-pointer hover:border-primary transition-colors\" data-source=\"offline\">\n                        <div class=\"text-center\">\n                            <i class=\"fas fa-file-upload text-3xl text-gray-600 mb-4\"></i>\n                            <h3 class=\"font-semibold text-gray-800 mb-2\">Offline Data</h3>\n                            <p class=\"text-sm text-gray-600\">Upload files from your local system</p>\n                        </div>\n                        <input type=\"radio\" name=\"dataSource\" value=\"offline\" class=\"hidden\">\n                    </div>\n\n                    <!-- Online Data Option -->\n                    <div class=\"data-source-option border-2 border-gray-200 rounded-lg p-6 cursor-pointer hover:border-primary transition-colors\" data-source=\"online\">\n                        <div class=\"text-center\">\n                            <i class=\"fas fa-cloud text-3xl text-gray-600 mb-4\"></i>\n                            <h3 class=\"font-semibold text-gray-800 mb-2\">Online Data</h3>\n                            <p class=\"text-sm text-gray-600\">Connect to online data sources</p>\n                        </div>\n                        <input type=\"radio\" name=\"dataSource\" value=\"online\" class=\"hidden\">\n                    </div>\n\n                    <!-- Sample Data Option -->\n                    <div class=\"data-source-option border-2 border-gray-200 rounded-lg p-6 cursor-pointer hover:border-primary transition-colors\" data-source=\"sample\">\n                        <div class=\"text-center\">\n                            <i class=\"fas fa-vial text-3xl text-gray-600 mb-4\"></i>\n                            <h3 class=\"font-semibold text-gray-800 mb-2\">Sample Data</h3>\n                            <p class=\"text-sm text-gray-600\">Use pre-configured sample data</p>\n                        </div>\n                        <input type=\"radio\" name=\"dataSource\" value=\"sample\" class=\"hidden\">\n                    </div>\n                </div>\n                <p class=\"text-sm text-red-500 mt-4 hidden text-center\" id=\"dataSourceError\">Please select a data source</p>\n            </div>\n\n            <!-- Step 3: Data Collection -->\n            <div id=\"step3\" class=\"step-content hidden\">\n                <!-- Offline Data Collection -->\n                <div id=\"offlineDataCollection\" class=\"hidden\">\n                    <div class=\"text-center mb-6\">\n                        <i class=\"fas fa-file-upload text-4xl text-primary mb-4\"></i>\n                        <h2 class=\"text-2xl font-semibold text-gray-800 mb-2\">Upload Data Files</h2>\n                        <p class=\"text-gray-600\">Please upload the required data files</p>\n                    </div>\n\n                    <div class=\"space-y-6\">\n                        <!-- File Upload 1 -->\n                        <div>\n                            <label class=\"block text-sm font-medium text-gray-700 mb-2\">\n                                Inventory Data <span class=\"text-red-500\">*</span>\n                            </label>\n                            <div class=\"file-upload-area border-2 border-dashed border-gray-300 rounded-lg p-4 text-center hover:border-primary transition-colors\">\n                                <input type=\"file\" accept=\".csv,.xlsx,.json\" class=\"hidden\" id=\"inventoryFile\">\n                                <i class=\"fas fa-file-csv text-2xl text-gray-400 mb-2\"></i>\n                                <p class=\"text-gray-600\">Click to upload inventory data (CSV, Excel, JSON)</p>\n                                <div class=\"file-info hidden mt-2\"></div>\n                            </div>\n                        </div>\n\n                        <!-- File Upload 2 -->\n                        <div>\n                            <label class=\"block text-sm font-medium text-gray-700 mb-2\">\n                                License Data <span class=\"text-red-500\">*</span>\n                            </label>\n                            <div class=\"file-upload-area border-2 border-dashed border-gray-300 rounded-lg p-4 text-center hover:border-primary transition-colors\">\n                                <input type=\"file\" accept=\".csv,.xlsx,.json\" class=\"hidden\" id=\"licenseFile\">\n                                <i class=\"fas fa-file-csv text-2xl text-gray-400 mb-2\"></i>\n                                <p class=\"text-gray-600\">Click to upload license data (CSV, Excel, JSON)</p>\n                                <div class=\"file-info hidden mt-2\"></div>\n                            </div>\n                        </div>\n\n                        <!-- File Upload 3 -->\n                        <div>\n                            <label class=\"block text-sm font-medium text-gray-700 mb-2\">\n                                Configuration Data\n                            </label>\n                            <div class=\"file-upload-area border-2 border-dashed border-gray-300 rounded-lg p-4 text-center hover:border-primary transition-colors\">\n                                <input type=\"file\" accept=\".csv,.xlsx,.json\" class=\"hidden\" id=\"configFile\">\n                                <i class=\"fas fa-file-csv text-2xl text-gray-400 mb-2\"></i>\n                                <p class=\"text-gray-600\">Click to upload configuration data (CSV, Excel, JSON)</p>\n                                <div class=\"file-info hidden mt-2\"></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Online Data Collection -->\n                <div id=\"onlineDataCollection\" class=\"hidden\">\n                    <div class=\"text-center mb-6\">\n                        <i class=\"fas fa-cloud-download-alt text-4xl text-primary mb-4\"></i>\n                        <h2 class=\"text-2xl font-semibold text-gray-800 mb-2\">Online Data Configuration</h2>\n                        <p class=\"text-gray-600\">Configure your data collection parameters and run pipelines</p>\n                    </div>\n\n                    <!-- Credentials Section -->\n                    <div class=\"bg-gray-50 rounded-lg p-6 mb-6\">\n                        <div class=\"flex items-center justify-between mb-4\">\n                            <div class=\"flex items-center\">\n                                <i class=\"fas fa-key text-primary text-xl mr-3\"></i>\n                                <h3 class=\"text-lg font-semibold text-gray-800\">Credentials <span class=\"text-red-500\">*</span></h3>\n                            </div>\n                            <div class=\"relative\">\n                                <button id=\"credentialsDropdown\" class=\"bg-primary hover:bg-blue-600 text-white px-4 py-2 rounded-lg flex items-center transition-colors\">\n                                    <i class=\"fas fa-plus mr-2\"></i>\n                                    Add Credential\n                                    <i class=\"fas fa-chevron-down ml-2\"></i>\n                                </button>\n                                <div id=\"credentialsDropdownMenu\" class=\"hidden absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 z-50\">\n                                    <div class=\"py-1\">\n                                        <button id=\"addSnowflakeCredential\" class=\"w-full text-left px-4 py-2 hover:bg-gray-50 flex items-center transition-colors\">\n                                            <i class=\"fas fa-snowflake text-blue-500 mr-3\"></i>\n                                            Snowflake\n                                        </button>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"text-sm text-gray-600\">\n                            <i class=\"fas fa-info-circle mr-1\"></i>\n                            Configure your data source credentials to enable pipeline execution\n                        </div>\n                    </div>\n\n                    <!-- Customer Data - Inventory Hardware EoX Form -->\n                    <div class=\"bg-gray-50 rounded-lg p-6 mb-6\">\n                        <div class=\"flex items-center mb-4\">\n                            <i class=\"fas fa-server text-primary text-xl mr-3\"></i>\n                            <h3 class=\"text-lg font-semibold text-gray-800\">Customer Data - Inventory Hardware EoX</h3>\n                        </div>\n                        <form id=\"inventoryForm\" class=\"space-y-4\">\n                            <div class=\"flex items-end gap-4\">\n                                <div class=\"grid md:grid-cols-3 gap-4 flex-1\">\n                                    <div>\n                                        <label for=\"inventory_customer\" class=\"block text-sm font-medium text-gray-700 mb-2\">\n                                            Customer <span class=\"text-red-500\">*</span>\n                                        </label>\n                                        <input \n                                            type=\"text\" \n                                            id=\"inventory_customer\" \n                                            name=\"customer\"\n                                            class=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none\"\n                                            placeholder=\"Enter customer name\"\n                                            required\n                                        >\n                                    </div>\n                                    <div>\n                                        <label for=\"inventory_savm_level\" class=\"block text-sm font-medium text-gray-700 mb-2\">\n                                            Savm Level <span class=\"text-red-500\">*</span>\n                                        </label>\n                                        <input \n                                            type=\"text\" \n                                            id=\"inventory_savm_level\" \n                                            name=\"savm_level\"\n                                            class=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none\"\n                                            placeholder=\"Enter SAVM level\"\n                                            required\n                                        >\n                                    </div>\n                                    <div>\n                                        <label for=\"inventory_savm_name\" class=\"block text-sm font-medium text-gray-700 mb-2\">\n                                            Savm Name <span class=\"text-red-500\">*</span>\n                                        </label>\n                                        <input \n                                            type=\"text\" \n                                            id=\"inventory_savm_name\" \n                                            name=\"savm_name\"\n                                            class=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none\"\n                                            placeholder=\"Enter SAVM name\"\n                                            required\n                                        >\n                                    </div>\n                                </div>\n                                <div class=\"flex flex-col items-center gap-2\">\n                                    <button \n                                        type=\"button\" \n                                        id=\"addInventoryData\" \n                                        class=\"bg-secondary hover:bg-green-600 text-white px-6 py-2 rounded-lg font-medium transition-colors whitespace-nowrap\"\n                                    >\n                                        <i class=\"fas fa-plus mr-2\"></i>\n                                        Add\n                                    </button>\n                                    <div id=\"inventoryStatus\" class=\"hidden\">\n                                        <span class=\"px-3 py-1 bg-gray-200 text-gray-600 rounded-full text-sm\">Ready</span>\n                                    </div>\n                                </div>\n                            </div>\n                        </form>\n                        \n                        <!-- Inventory Data Table -->\n                        <div class=\"mt-6\">\n                            <div class=\"flex items-center justify-between mb-4\">\n                                <h4 class=\"text-md font-semibold text-gray-800\">Inventory Data Records</h4>\n                                <button \n                                    type=\"button\" \n                                    id=\"refreshInventoryTable\" \n                                    class=\"bg-gray-100 hover:bg-gray-200 text-gray-600 hover:text-gray-700 px-3 py-1.5 rounded border border-gray-300 text-xs transition-colors flex items-center\"\n                                >\n                                    <i class=\"fas fa-refresh text-xs mr-1\"></i>\n                                    Refresh\n                                </button>\n                            </div>\n                            <div class=\"overflow-x-auto\">\n                                <table class=\"min-w-full bg-white border border-gray-200 rounded-lg\">\n                                    <thead class=\"bg-gray-50\">\n                                        <tr>\n                                            <th class=\"px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Customer</th>\n                                            <th class=\"px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Savm Level</th>\n                                            <th class=\"px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Savm Name</th>\n                                            <th class=\"px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Timestamp</th>\n                                        </tr>\n                                    </thead>\n                                    <tbody id=\"inventoryTableBody\" class=\"divide-y divide-gray-200\">\n                                        <tr>\n                                            <td colspan=\"4\" class=\"px-4 py-8 text-center text-gray-500\">\n                                                <i class=\"fas fa-inbox text-2xl mb-2\"></i>\n                                                <p>No data available. Add records to see them here.</p>\n                                            </td>\n                                        </tr>\n                                    </tbody>\n                                </table>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- Customer Data - SW License Details Form -->\n                    <div class=\"bg-gray-50 rounded-lg p-6 mb-6\">\n                        <div class=\"flex items-center mb-4\">\n                            <i class=\"fas fa-key text-primary text-xl mr-3\"></i>\n                            <h3 class=\"text-lg font-semibold text-gray-800\">Customer Data - SW License Details</h3>\n                        </div>\n                        <form id=\"licenseForm\" class=\"space-y-4\">\n                            <div class=\"flex items-end gap-4\">\n                                <div class=\"grid md:grid-cols-2 gap-4 flex-1\">\n                                    <div>\n                                        <label for=\"license_customer\" class=\"block text-sm font-medium text-gray-700 mb-2\">\n                                            Customer <span class=\"text-red-500\">*</span>\n                                        </label>\n                                        <input \n                                            type=\"text\" \n                                            id=\"license_customer\" \n                                            name=\"customer\"\n                                            class=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none\"\n                                            placeholder=\"Enter customer name\"\n                                            required\n                                        >\n                                    </div>\n                                    <div>\n                                        <label for=\"license_top_level_domain\" class=\"block text-sm font-medium text-gray-700 mb-2\">\n                                            Top Level Domain <span class=\"text-red-500\">*</span>\n                                        </label>\n                                        <input \n                                            type=\"text\" \n                                            id=\"license_top_level_domain\" \n                                            name=\"top_level_domain\"\n                                            class=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none\"\n                                            placeholder=\"Enter top level domain\"\n                                            required\n                                        >\n                                    </div>\n                                </div>\n                                <div class=\"flex flex-col items-center gap-2\">\n                                    <button \n                                        type=\"button\" \n                                        id=\"addLicenseData\" \n                                        class=\"bg-secondary hover:bg-green-600 text-white px-6 py-2 rounded-lg font-medium transition-colors whitespace-nowrap\"\n                                    >\n                                        <i class=\"fas fa-plus mr-2\"></i>\n                                        Add\n                                    </button>\n                                    <div id=\"licenseStatus\" class=\"hidden\">\n                                        <span class=\"px-3 py-1 bg-gray-200 text-gray-600 rounded-full text-sm\">Ready</span>\n                                    </div>\n                                </div>\n                            </div>\n                        </form>\n                        \n                        <!-- License Data Table -->\n                        <div class=\"mt-6\">\n                            <div class=\"flex items-center justify-between mb-4\">\n                                <h4 class=\"text-md font-semibold text-gray-800\">License Data Records</h4>\n                                <button \n                                    type=\"button\" \n                                    id=\"refreshLicenseTable\" \n                                    class=\"bg-gray-100 hover:bg-gray-200 text-gray-600 hover:text-gray-700 px-3 py-1.5 rounded border border-gray-300 text-xs transition-colors flex items-center\"\n                                >\n                                    <i class=\"fas fa-refresh text-xs mr-1\"></i>\n                                    Refresh\n                                </button>\n                            </div>\n                            <div class=\"overflow-x-auto\">\n                                <table class=\"min-w-full bg-white border border-gray-200 rounded-lg\">\n                                    <thead class=\"bg-gray-50\">\n                                        <tr>\n                                            <th class=\"px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Customer</th>\n                                            <th class=\"px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Top Level Domain</th>\n                                            <th class=\"px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Timestamp</th>\n                                        </tr>\n                                    </thead>\n                                    <tbody id=\"licenseTableBody\" class=\"divide-y divide-gray-200\">\n                                        <tr>\n                                            <td colspan=\"3\" class=\"px-4 py-8 text-center text-gray-500\">\n                                                <i class=\"fas fa-inbox text-2xl mb-2\"></i>\n                                                <p>No data available. Add records to see them here.</p>\n                                            </td>\n                                        </tr>\n                                    </tbody>\n                                </table>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- Pipeline Progress Summary -->\n                    <div id=\"pipelinesSummary\" class=\"hidden\">\n                        <div class=\"bg-blue-50 border border-blue-200 rounded-lg p-4\">\n                            <div class=\"flex items-center mb-2\">\n                                <i class=\"fas fa-info-circle text-blue-500 mr-2\"></i>\n                                <span class=\"font-medium text-blue-800\">Pipeline Execution Summary</span>\n                            </div>\n                            <div class=\"space-y-2\" id=\"pipelineSummaryList\">\n                                <!-- Summary items will be added dynamically -->\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"space-y-4 mb-6\">\n                        <div class=\"pipeline-item bg-gray-50 rounded-lg p-4 flex items-center justify-between\">\n                            <div class=\"flex items-center\">\n                                <i class=\"fas fa-cogs text-primary mr-3\"></i>\n                                <div>\n                                    <h4 class=\"font-medium text-gray-800\">Inventory Collection Pipeline</h4>\n                                    <p class=\"text-sm text-gray-600\">Collects device inventory data from your systems</p>\n                                </div>\n                            </div>\n                            <div class=\"pipeline-status\">\n                                <span class=\"px-3 py-1 bg-gray-200 text-gray-600 rounded-full text-sm\">Ready</span>\n                            </div>\n                        </div>\n\n                        <div class=\"pipeline-item bg-gray-50 rounded-lg p-4 flex items-center justify-between\">\n                            <div class=\"flex items-center\">\n                                <i class=\"fas fa-key text-primary mr-3\"></i>\n                                <div>\n                                    <h4 class=\"font-medium text-gray-800\">License Data Pipeline</h4>\n                                    <p class=\"text-sm text-gray-600\">Retrieves license information and compliance data</p>\n                                </div>\n                            </div>\n                            <div class=\"pipeline-status\">\n                                <span class=\"px-3 py-1 bg-gray-200 text-gray-600 rounded-full text-sm\">Ready</span>\n                            </div>\n                        </div>\n\n                        <div class=\"pipeline-item bg-gray-50 rounded-lg p-4 flex items-center justify-between\">\n                            <div class=\"flex items-center\">\n                                <i class=\"fas fa-chart-line text-primary mr-3\"></i>\n                                <div>\n                                    <h4 class=\"font-medium text-gray-800\">Analytics Pipeline</h4>\n                                    <p class=\"text-sm text-gray-600\">Processes and analyzes collected data</p>\n                                </div>\n             