ta || apiResponse.pstream_data.length === 0) {\n            console.log('No data found, showing empty state');\n            tableBody.innerHTML = `\n                <tr>\n                    <td colspan=\"4\" class=\"px-4 py-8 text-center text-gray-500\">\n                        <i class=\"fas fa-inbox text-2xl mb-2\"></i>\n                        <p>No data available. Add records to see them here.</p>\n                    </td>\n                </tr>\n            `;\n            return;\n        }\n\n        console.log('Data found, populating table with', apiResponse.pstream_data.length, 'records');\n\n        // Clear existing content\n        tableBody.innerHTML = '';\n\n        // Pagination logic - show max 5 records per page\n        const maxRecordsPerPage = 5;\n        const totalRecords = apiResponse.pstream_data.length;\n        \n        // Get current page from data attribute or default to 1\n        const currentPage = parseInt(tableBody.getAttribute('data-current-page')) || 1;\n        const startIndex = (currentPage - 1) * maxRecordsPerPage;\n        const endIndex = Math.min(startIndex + maxRecordsPerPage, totalRecords);\n        \n        // Get records for current page\n        const recordsToShow = apiResponse.pstream_data.slice(startIndex, endIndex);\n\n        // Populate with paginated data\n        recordsToShow.forEach((record, index) => {\n            console.log(`Processing record ${startIndex + index}:`, record);\n            \n            const row = document.createElement('tr');\n            row.className = 'hover:bg-gray-50';\n            \n            const customer = record.customer || '-';\n            const savmLevel = record.savm_level || '-';\n            const savmName = record.savm_name || '-';\n            const timestamp = record.timestamp ? new Date(record.timestamp).toLocaleString() : '-';\n            \n            console.log('Extracted values:', { customer, savmLevel, savmName, timestamp });\n            \n            row.innerHTML = `\n                <td class=\"px-4 py-2 text-xs text-gray-900\">${customer}</td>\n                <td class=\"px-4 py-2 text-xs text-gray-900\">${savmLevel}</td>\n                <td class=\"px-4 py-2 text-xs text-gray-900\">${savmName}</td>\n                <td class=\"px-4 py-2 text-xs text-gray-500\">${timestamp}</td>\n            `;\n            \n            tableBody.appendChild(row);\n        });\n        \n        // Update pagination controls for inventory table\n        this.updateInventoryPagination(currentPage, totalRecords, maxRecordsPerPage);\n        \n        console.log('Table population completed');\n    }\n\n    populateLicenseTable(apiResponse) {\n        const tableBody = document.getElementById('licenseTableBody');\n        \n        // Debug logging\n        console.log('populateLicenseTable called with:', apiResponse);\n        console.log('pstream_data:', apiResponse.pstream_data);\n        console.log('pstream_data length:', apiResponse.pstream_data?.length);\n        \n        // Check if we have data - the actual data is in pstream_data array\n        if (!apiResponse.pstream_data || apiResponse.pstream_data.length === 0) {\n            console.log('No license data found, showing empty state');\n            tableBody.innerHTML = `\n                <tr>\n                    <td colspan=\"3\" class=\"px-4 py-8 text-center text-gray-500\">\n                        <i class=\"fas fa-inbox text-2xl mb-2\"></i>\n                        <p>No data available. Add records to see them here.</p>\n                    </td>\n                </tr>\n            `;\n            return;\n        }\n\n        console.log('License data found, populating table with', apiResponse.pstream_data.length, 'records');\n\n        // Clear existing content\n        tableBody.innerHTML = '';\n\n        // Pagination logic - show max 5 records per page\n        const maxRecordsPerPage = 5;\n        const totalRecords = apiResponse.pstream_data.length;\n        \n        // Get current page from data attribute or default to 1\n        const currentPage = parseInt(tableBody.getAttribute('data-current-page')) || 1;\n        const startIndex = (currentPage - 1) * maxRecordsPerPage;\n        const endIndex = Math.min(startIndex + maxRecordsPerPage, totalRecords);\n        \n        // Get records for current page\n        const recordsToShow = apiResponse.pstream_data.slice(startIndex, endIndex);\n\n        // Populate with paginated data\n        recordsToShow.forEach((record, index) => {\n            console.log(`Processing license record ${startIndex + index}:`, record);\n            \n            const row = document.createElement('tr');\n            row.className = 'hover:bg-gray-50';\n            \n            const customer = record.customer || '-';\n            const topLevelDomain = record.top_level_domain || '-';\n            const timestamp = record.timestamp ? new Date(record.timestamp).toLocaleString() : '-';\n            \n            console.log('Extracted license values:', { customer, topLevelDomain, timestamp });\n            \n            row.innerHTML = `\n                <td class=\"px-4 py-2 text-xs text-gray-900\">${customer}</td>\n                <td class=\"px-4 py-2 text-xs text-gray-900\">${topLevelDomain}</td>\n                <td class=\"px-4 py-2 text-xs text-gray-500\">${timestamp}</td>\n            `;\n            \n            tableBody.appendChild(row);\n        });\n        \n        // Update pagination controls for license table\n        this.updateLicensePagination(currentPage, totalRecords, maxRecordsPerPage);\n        \n        console.log('License table population completed');\n    }\n\n    updateInventoryPagination(currentPage, totalRecords, maxRecordsPerPage) {\n        const totalPages = Math.ceil(totalRecords / maxRecordsPerPage);\n        let paginationHtml = '';\n        \n        if (totalPages > 1) {\n            paginationHtml = `\n                <div class=\"w-full flex justify-center mt-4 px-4 py-2 bg-gray-50 border-t\">\n                    <div class=\"flex items-center space-x-1\">\n                        ${currentPage > 1 ? \n                            `<button onclick=\"window.packWizard.goToInventoryPage(${currentPage - 1})\" class=\"flex items-center justify-center w-8 h-8 bg-white border border-gray-300 rounded hover:bg-gray-50 text-xs\">\n                                <i class=\"fas fa-chevron-left text-xs\"></i>\n                            </button>` : \n                            `<button disabled class=\"flex items-center justify-center w-8 h-8 bg-gray-100 border border-gray-300 rounded text-gray-400 cursor-not-allowed text-xs\">\n                                <i class=\"fas fa-chevron-left text-xs\"></i>\n                            </button>`\n                        }\n                        <span class=\"px-2 py-1 text-xs text-gray-700 min-w-fit\">\n                            Page ${currentPage} of ${totalPages}\n                        </span>\n                        ${currentPage < totalPages ? \n                            `<button onclick=\"window.packWizard.goToInventoryPage(${currentPage + 1})\" class=\"flex items-center justify-center w-8 h-8 bg-white border border-gray-300 rounded hover:bg-gray-50 text-xs\">\n                                <i class=\"fas fa-chevron-right text-xs\"></i>\n                            </button>` : \n                            `<button disabled class=\"flex items-center justify-center w-8 h-8 bg-gray-100 border border-gray-300 rounded text-gray-400 cursor-not-allowed text-xs\">\n                                <i class=\"fas fa-chevron-right text-xs\"></i>\n                            </button>`\n                        }\n                    </div>\n                </div>\n            `;\n        }\n        \n        // Insert or update pagination\n        const tableContainer = document.getElementById('inventoryTableBody').closest('.bg-white');\n        let existingPagination = tableContainer.querySelector('.inventory-pagination');\n        if (existingPagination) {\n            existingPagination.remove();\n        }\n        \n        if (paginationHtml) {\n            const paginationDiv = document.createElement('div');\n            paginationDiv.className = 'inventory-pagination';\n            paginationDiv.innerHTML = paginationHtml;\n            tableContainer.appendChild(paginationDiv);\n        }\n    }\n\n    updateLicensePagination(currentPage, totalRecords, maxRecordsPerPage) {\n        const totalPages = Math.ceil(totalRecords / maxRecordsPerPage);\n        let paginationHtml = '';\n        \n        if (totalPages > 1) {\n            paginationHtml = `\n                <div class=\"w-full flex justify-center mt-4 px-4 py-2 bg-gray-50 border-t\">\n                    <div class=\"flex items-center space-x-1\">\n                        ${currentPage > 1 ? \n                            `<button onclick=\"window.packWizard.goToLicensePage(${currentPage - 1})\" class=\"flex items-center justify-center w-8 h-8 bg-white border border-gray-300 rounded hover:bg-gray-50 text-xs\">\n                                <i class=\"fas fa-chevron-left text-xs\"></i>\n                            </button>` : \n                            `<button disabled class=\"flex items-center justify-center w-8 h-8 bg-gray-100 border border-gray-300 rounded text-gray-400 cursor-not-allowed text-xs\">\n                                <i class=\"fas fa-chevron-left text-xs\"></i>\n                            </button>`\n                        }\n                        <span class=\"px-2 py-1 text-xs text-gray-700 min-w-fit\">\n                            Page ${currentPage} of ${totalPages}\n                        </span>\n                        ${currentPage < totalPages ? \n                            `<button onclick=\"window.packWizard.goToLicensePage(${currentPage + 1})\" class=\"flex items-center justify-center w-8 h-8 bg-white border border-gray-300 rounded hover:bg-gray-50 text-xs\">\n                                <i class=\"fas fa-chevron-right text-xs\"></i>\n                            </button>` : \n                            `<button disabled class=\"flex items-center justify-center w-8 h-8 bg-gray-100 border border-gray-300 rounded text-gray-400 cursor-not-allowed text-xs\">\n                                <i class=\"fas fa-chevron-right text-xs\"></i>\n                            </button>`\n                        }\n                    </div>\n                </div>\n            `;\n        }\n        \n        // Insert or update pagination\n        const tableContainer = document.getElementById('licenseTableBody').closest('.bg-white');\n        let existingPagination = tableContainer.querySelector('.license-pagination');\n        if (existingPagination) {\n            existingPagination.remove();\n        }\n        \n        if (paginationHtml) {\n            const paginationDiv = document.createElement('div');\n            paginationDiv.className = 'license-pagination';\n            paginationDiv.innerHTML = paginationHtml;\n            tableContainer.appendChild(paginationDiv);\n        }\n    }\n\n    goToInventoryPage(page) {\n        const tableBody = document.getElementById('inventoryTableBody');\n        tableBody.setAttribute('data-current-page', page);\n        \n        // Re-populate table with stored data\n        if (this.wizardData.lastInventoryResponse) {\n            this.populateInventoryTable(this.wizardData.lastInventoryResponse);\n        } else {\n            // If no stored data, reload from API\n            this.loadInventoryData();\n        }\n    }\n\n    goToLicensePage(page) {\n        const tableBody = document.getElementById('licenseTableBody');\n        tableBody.setAttribute('data-current-page', page);\n        \n        // Re-populate table with stored data\n        if (this.wizardData.lastLicenseResponse) {\n            this.populateLicenseTable(this.wizardData.lastLicenseResponse);\n        } else {\n            // If no stored data, reload from API\n            this.loadLicenseData();\n        }\n    }\n\n    // ...existing code...\n\n    validateCurrentStep() {\n        switch (this.currentStep) {\n            case 1:\n                return this.validateStep1();\n            case 2:\n                return this.validateStep2();\n            case 3:\n                return this.validateStep3();\n            case 4:\n                return true;\n            default:\n                return false;\n        }\n    }\n\n    validateStep1() {\n        const customerName = document.getElementById('customerName').value.trim();\n        return customerName.length > 0;\n    }\n\n    validateStep2() {\n        const selectedSource = document.querySelector('input[name=\"dataSource\"]:checked');\n        if (!selectedSource) {\n            document.getElementById('dataSourceError').classList.remove('hidden');\n            return false;\n        }\n        return true;\n    }\n\n    validateStep3() {\n        if (this.wizardData.dataSource === 'offline') {\n            const requiredFiles = ['inventoryFile', 'licenseFile'];\n            return requiredFiles.every(fileId => this.wizardData.uploadedFiles[fileId]);\n        } else if (this.wizardData.dataSource === 'online') {\n            // For online data, credentials are mandatory\n            if (!this.validateCredentials()) {\n                return false;\n            }\n            // Also check if pipelines need to be completed (optional)\n            return true; // Allow proceeding if credentials are configured\n        }\n        // Sample data always valid\n        return true;\n    }\n\n    nextStep() {\n        if (!this.validateCurrentStep()) {\n            this.showValidationErrors();\n            return;\n        }\n\n        if (this.currentStep < this.totalSteps) {\n            this.currentStep++;\n            this.updateStepDisplay();\n            this.updateStepIndicators();\n            this.updateNavigationButtons();\n\n            // Special handling for step 4\n            if (this.currentStep === 4) {\n                this.startFinalConfiguration();\n            }\n        }\n    }\n\n    prevStep() {\n        if (this.currentStep > 1) {\n            this.currentStep--;\n            this.updateStepDisplay();\n            this.updateStepIndicators();\n            this.updateNavigationButtons();\n        }\n    }\n\n    updateStepDisplay() {\n        // Hide all steps\n        document.querySelectorAll('.step-content').forEach(step => {\n            step.classList.add('hidden');\n        });\n\n        // Show current step\n        const currentStepElement = document.getElementById(`step${this.currentStep}`);\n        currentStepElement.classList.remove('hidden');\n\n        // Show appropriate data collection section for step 3\n        if (this.currentStep === 3) {\n            this.showDataCollectionSection();\n        }\n\n        // Dispatch step change event\n        document.dispatchEvent(new CustomEvent('stepChange', {\n            detail: { step: this.currentStep }\n        }));\n    }\n\n    showDataCollectionSection() {\n        // Hide all data collection sections\n        document.querySelectorAll('[id$=\"DataCollection\"]').forEach(section => {\n            section.classList.add('hidden');\n        });\n\n        // Show the appropriate section based on selected data source\n        const sectionId = `${this.wizardData.dataSource}DataCollection`;\n        const section = document.getElementById(sectionId);\n        if (section) {\n            section.classList.remove('hidden');\n            \n            // If showing online data collection, automatically load existing table data\n            if (this.wizardData.dataSource === 'online') {\n                // Load existing data for both tables\n                setTimeout(() => {\n                    this.loadInventoryData();\n                    this.loadLicenseData();\n                }, 500); // Small delay to ensure DOM is ready\n            }\n        }\n    }\n\n    updateStepIndicators() {\n        for (let i = 1; i <= this.totalSteps; i++) {\n            const indicator = document.getElementById(`step${i}-indicator`);\n            const progress = document.getElementById(`progress${i}`);\n\n            if (i < this.currentStep) {\n                // Completed step\n                indicator.className = 'flex items-center justify-center w-10 h-10 bg-secondary text-white rounded-full font-semibold mb-2';\n                indicator.innerHTML = '<i class=\"fas fa-check\"></i>';\n                if (progress) progress.className = 'flex-1 h-1 bg-secondary mx-4 hidden md:block';\n            } else if (i === this.currentStep) {\n                // Current step\n                indicator.className = 'flex items-center justify-center w-10 h-10 bg-primary text-white rounded-full font-semibold mb-2';\n                indicator.textContent = i;\n                if (progress) progress.className = 'flex-1 h-1 bg-gray-300 mx-4 hidden md:block';\n            } else {\n                // Future step\n                indicator.className = 'flex items-center justify-center w-10 h-10 bg-gray-300 text-gray-500 rounded-full font-semibold mb-2';\n                indicator.textContent = i;\n                if (progress) progress.className = 'flex-1 h-1 bg-gray-300 mx-4 hidden md:block';\n            }\n        }\n    }\n\n    updateNavigationButtons() {\n        const prevBtn = document.getElementById('prevBtn');\n        const nextBtn = document.getElementById('nextBtn');\n\n        // Previous button\n        prevBtn.disabled = this.currentStep === 1;\n        prevBtn.className = this.currentStep === 1 \n            ? 'px-6 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors disabled:opacity-50 disabled:cursor-not-allowed'\n            : 'px-6 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors';\n\n        // Next button\n        if (this.currentStep === this.totalSteps) {\n            nextBtn.style.display = 'none';\n        } else {\n            nextBtn.style.display = 'inline-flex';\n            nextBtn.disabled = false;\n            nextBtn.className = 'flex items-center px-6 py-2 bg-primary text-white rounded-lg hover:bg-blue-600 transition-colors';\n            \n            nextBtn.innerHTML = this.currentStep === 3 && this.wizardData.dataSource === 'online' \n                ? 'Complete <i class=\"fas fa-check ml-2\"></i>'\n                : 'Next <i class=\"fas fa-arrow-right ml-2\"></i>';\n        }\n    }\n\n    showValidationErrors() {\n        // Add specific validation error display logic here\n        console.log('Validation failed for step', this.currentStep);\n        \n        if (this.currentStep === 3 && this.wizardData.dataSource === 'online') {\n            if (!this.validateCredentials()) {\n                this.showNotification('Please configure credentials before proceeding to the next step', 'error');\n            }\n        }\n    }\n\n    startFinalConfiguration() {\n        const finalProgressBar = document.getElementById('finalProgressBar');\n        const finalProgressText = document.getElementById('finalProgressText');\n        const completionMessage = document.getElementById('completionMessage');\n\n        const stages = [\n            { progress: 25, text: 'Validating configuration...' },\n            { progress: 50, text: 'Creating pack structure...' },\n            { progress: 75, text: 'Generating artifacts...' },\n            { progress: 100, text: 'Configuration complete!' }\n        ];\n\n        let currentStage = 0;\n        const interval = setInterval(() => {\n            if (currentStage < stages.length) {\n                finalProgressBar.style.width = stages[currentStage].progress + '%';\n                finalProgressText.textContent = stages[currentStage].text;\n                currentStage++;\n            } else {\n                clearInterval(interval);\n                setTimeout(() => {\n                    completionMessage.classList.remove('hidden');\n                    this.updateFinalStepIndicators();\n                }, 1000);\n            }\n        }, 1500);\n    }\n\n    updateFinalStepIndicators() {\n        const indicators = document.querySelectorAll('[class*=\"fa-spinner\"]');\n        indicators.forEach(indicator => {\n            indicator.className = 'fas fa-check-circle text-green-500 mr-3';\n        });\n    }\n\n    // Utility methods\n    showNotification(message, type = 'info') {\n        // Create notification element\n        const notification = document.createElement('div');\n        notification.className = `fixed top-4 right-4 p-4 rounded-lg shadow-lg z-50 max-w-sm transform transition-all duration-300 translate-x-full`;\n        \n        // Set colors based on type\n        let bgColor, textColor, iconClass;\n        switch (type) {\n            case 'success':\n                bgColor = 'bg-green-100 border border-green-400';\n                textColor = 'text-green-700';\n                iconClass = 'fas fa-check-circle text-green-500';\n                break;\n            case 'error':\n                bgColor = 'bg-red-100 border border-red-400';\n                textColor = 'text-red-700';\n                iconClass = 'fas fa-exclamation-circle text-red-500';\n                break;\n            case 'warning':\n                bgColor = 'bg-yellow-100 border border-yellow-400';\n                textColor = 'text-yellow-700';\n                iconClass = 'fas fa-exclamation-triangle text-yellow-500';\n                break;\n            default:\n                bgColor = 'bg-blue-100 border border-blue-400';\n                textColor = 'text-blue-700';\n                iconClass = 'fas fa-info-circle text-blue-500';\n        }\n        \n        notification.className += ` ${bgColor}`;\n        notification.innerHTML = `\n            <div class=\"flex items-center\">\n                <i class=\"${iconClass} mr-2\"></i>\n                <span class=\"${textColor}\">${message}</span>\n                <button class=\"ml-4 ${textColor} hover:opacity-70\" onclick=\"this.parentElement.parentElement.remove()\">\n                    <i class=\"fas fa-times\"></i>\n                </button>\n            </div>\n        `;\n        \n        // Add to document\n        document.body.appendChild(notification);\n        \n        // Animate in\n        setTimeout(() => {\n            notification.classList.remove('translate-x-full');\n        }, 100);\n        \n        // Auto remove after 5 seconds\n        setTimeout(() => {\n            notification.classList.add('translate-x-full');\n            setTimeout(() => {\n                if (notification.parentElement) {\n                    notification.remove();\n                }\n            }, 300);\n        }, 5000);\n    }\n\n    getWizardData() {\n        return this.wizardData;\n    }\n\n    resetWizard() {\n        this.currentStep = 1;\n        this.wizardData = {\n            customerName: '',\n            customerLogo: null,\n            logoUploadResponse: null,\n            dataSource: '',\n            uploadedFiles: {},\n            pipelineStatus: {},\n            inventoryPipelineData: {},\n            licensePipelineData: {}\n        };\n        this.updateStepDisplay();\n        this.updateStepIndicators();\n        this.updateNavigationButtons();\n    }\n}\n\n// Initialize the wizard when the DOM is loaded\ndocument.addEventListener('DOMContentLoaded', () => {\n    window.packWizard = new PackConfigurationWizard();\n});\n\n// Export for testing or external usage\nif (typeof module !== 'undefined' && module.exports) {\n    module.exports = PackConfigurationWizard;\n}\n"
