ss=\"block text-sm font-medium text-gray-700 mb-2\">\n                                Name <span class=\"text-red-500\">*</span>\n                            </label>\n                            <input \n                                type=\"text\" \n                                id=\"snowflake_name\" \n                                name=\"name\"\n                                class=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none\"\n                                placeholder=\"Name for the Integration\"\n                                required\n                            >\n                            <p class=\"text-xs text-gray-500 mt-1\">Name for the Integration</p>\n                        </div>\n\n                        <!-- Snowflake Account -->\n                        <div>\n                            <label for=\"snowflake_account\" class=\"block text-sm font-medium text-gray-700 mb-2\">\n                                Snowflake Account <span class=\"text-red-500\">*</span>\n                            </label>\n                            <input \n                                type=\"text\" \n                                id=\"snowflake_account\" \n                                name=\"account\"\n                                class=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none\"\n                                placeholder=\"Snowflake Account\"\n                                required\n                            >\n                            <p class=\"text-xs text-gray-500 mt-1\">Snowflake Account</p>\n                        </div>\n\n                        <!-- Snowflake User -->\n                        <div>\n                            <label for=\"snowflake_user\" class=\"block text-sm font-medium text-gray-700 mb-2\">\n                                Snowflake User <span class=\"text-red-500\">*</span>\n                            </label>\n                            <input \n                                type=\"text\" \n                                id=\"snowflake_user\" \n                                name=\"user\"\n                                class=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none\"\n                                placeholder=\"Snowflake User\"\n                                required\n                            >\n                            <p class=\"text-xs text-gray-500 mt-1\">Snowflake User</p>\n                        </div>\n\n                        <!-- Timeout -->\n                        <div>\n                            <label for=\"snowflake_timeout\" class=\"block text-sm font-medium text-gray-700 mb-2\">\n                                Timeout(sec)\n                            </label>\n                            <input \n                                type=\"number\" \n                                id=\"snowflake_timeout\" \n                                name=\"timeout\"\n                                class=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none\"\n                                placeholder=\"60\"\n                            >\n                            <p class=\"text-xs text-gray-500 mt-1\">Timeout(sec)</p>\n                        </div>\n                    </div>\n\n                    <!-- SSL Certificate Verification -->\n                    <div class=\"flex items-center\">\n                        <input \n                            type=\"checkbox\" \n                            id=\"snowflake_verify\" \n                            name=\"verify\"\n                            class=\"h-4 w-4 text-primary focus:ring-primary border-gray-300 rounded\"\n                        >\n                        <label for=\"snowflake_verify\" class=\"ml-2 block text-sm text-gray-700\">\n                            SSL Certificate Verification\n                        </label>\n                    </div>\n                    <p class=\"text-xs text-gray-500 -mt-4 ml-6\">SSL Certificate Verification</p>\n\n                    <!-- API Private Key -->\n                    <div>\n                        <label for=\"snowflake_private_key\" class=\"block text-sm font-medium text-gray-700 mb-2\">\n                            API Private Key <span class=\"text-red-500\">*</span>\n                        </label>\n                        <textarea \n                            id=\"snowflake_private_key\" \n                            name=\"private_key\"\n                            rows=\"4\"\n                            class=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none\"\n                            placeholder=\"Enter your API Private Key\"\n                            required\n                        ></textarea>\n                        <p class=\"text-xs text-gray-500 mt-1\">API Private Key</p>\n                    </div>\n\n                    <!-- Add to Default Site Profile -->\n                    <div class=\"flex items-center\">\n                        <input \n                            type=\"checkbox\" \n                            id=\"snowflake_add_to_default\" \n                            name=\"add_to_default_site_profile\"\n                            class=\"h-4 w-4 text-primary focus:ring-primary border-gray-300 rounded\"\n                            checked\n                        >\n                        <label for=\"snowflake_add_to_default\" class=\"ml-2 block text-sm text-gray-700\">\n                            Add to Default Site Profile\n                        </label>\n                    </div>\n                    <p class=\"text-xs text-gray-500 -mt-4 ml-6\">Add this