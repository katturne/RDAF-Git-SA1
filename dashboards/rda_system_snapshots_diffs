I data\n            const pipelineData = {\n                customer: formData.get('customer'),\n                top_level_domain: formData.get('top_level_domain')\n            };\n\n            // Call POST API to add data to pipeline\n            const response = await this.callPipelineAPI('edc_license_domain_input', '1.0.0', pipelineData);\n            \n            if (response.ok) {\n                const result = await response.json();\n                console.log('License data added successfully:', result);\n                \n                // Clear form\n                form.reset();\n                \n                // Show success message\n                this.showNotification('License data added successfully!', 'success');\n                \n                // Automatically refresh table data after successful POST\n                // Adding a small delay to ensure data is processed\n                setTimeout(async () => {\n                    await this.loadLicenseData();\n                }, 2000); // 2 second delay for data processing\n                \n            } else {\n                throw new Error(`Add failed: ${response.status} ${response.statusText}`);\n            }\n\n        } catch (error) {\n            console.error('Error adding license data:', error);\n            this.showNotification(`Error adding data: ${error.message}`, 'error');\n        } finally {\n            // Reset button\n            button.disabled = false;\n            button.innerHTML = '<i class=\"fas fa-plus mr-2\"></i>Add';\n        }\n    }\n\n    async loadInventoryData() {\n        const refreshButton = document.getElementById('refreshInventoryTable');\n        \n        try {\n            // Show loading state on refresh button\n            if (refreshButton) {\n                refreshButton.disabled = true;\n                refreshButton.innerHTML = '<i class=\"fas fa-spinner fa-spin mr-2\"></i>Loading...';\n            }\n            \n            console.log