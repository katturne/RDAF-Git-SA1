          "max_rows": 50,
          "columns": {
            "e_label": {
              "title": "Label",
              "formatter": "truncate",
              "defaultWidth": 270
            },
            "e_severity_color": {
              "title": "Sev_2",
              "type": "COLOR-MAP",
              "source-column": "e_severity",
              "color-map": {
                "SEVERE": "#B71C1C",
                "CRITICAL": "#E53935",
                "MAJOR": "#F57C00",
                "MINOR": "#FFA726",
                "WARNING": "#FFD54F",
                "NOTIFICATION": "#4DD0E1",
                "INFORMATION": "#03A9F4"
              }
            },
            "e_severity": {
              "title": "Severity",
              "htmlTemplateForRow": "<span class='badge' style='background-color: {{'{{ row.e_severity_color }}'}}' > {{'{{ row.e_severity }}'}} </span>",
              "defaultWidth": 150
            },
            "e_status": {
              "title": "Status",
              "defaultWidth": 150
            },
            "e_eventstate": {
              "title": "Processing State",
              "defaultWidth": 150
            },
            "e_message": {
              "title": "Comments",
              "defaultWidth": 270
            },
            "e_createdat": {
              "title": "Created At",
              "type": "DATETIME",
              "defaultWidth": 180
            },
            "e_updatedat": {
              "title": "Updated At",
              "type": "DATETIME",
              "defaultWidth": 180
            },
            "e_id": {
              "title": "Event Id",
              "visible": false,
              "key": true,
              "defaultWidth": 150
            },
            "e_projectid": {
              "title": "project Id",
              "visible": false,
              "key": true,
              "defaultWidth": 150
            },
            "e_sourceeventid": {
              "title": "Source Event ID",
              "visible": false,
              "key": true,
              "defaultWidth": 150
            },
            "e_eventkey": {
              "title": "Alert Key",
              "visible": false,
              "key": true,
              "defaultWidth": 150
            },
            "e_processedeventid": {
              "title": "Alert ID",
              "visible": false,
              "key": true,
              "defaultWidth": 150
            }
          },
          "actions": [
            {
              "title": "View Alert Trail",
              "type": "POPUP_FORM",
              "selectionType": "SINGLE",
              "permission": "oia:event-tracking:view",
              "identifier": "ingestion-tracker:cfx.view.alert.trail",
              "drillDownLinkField": "label",
              "drillDownContext": "id",
              "displayLabelColumnId": "label",
              "contextParamList": {
                "contextParams": [
                  {
                    "paramKey": "e_processedeventid",
                    "paramId": "processedeventid"
                  }
                ]
              },
              "api-endpoint": {
                "service-name": "ingestion-tracker",
                "namespace": "io.cfx.dimensions.app",
                "methodName": "invokeAppApi:getFormById",
                "stringified-params": true,
                "useReportContext": true,
                "parse-output": false,
                "params": [
                  {
                    "form_id": "com.cfx.form.view.alert.trail",
                    "context": {}
                  }
                ]
              }
            }
          ],
          "widget_id": "2d17f8a1"
        }
      ]
    }
