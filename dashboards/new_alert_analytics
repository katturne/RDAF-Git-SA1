          "min_width": 2,
          "height": 3,
          "max_width": 4,
          "column": "count_",
          "agg": "sum",
          "group_by": [
            "messageType"
          ],
          "style": {
            "color-map": {
              "Insufficient Licenses": "#FFA500",
              "Licenses Expired": "#FF0000",
              "Licenses Expiring": "#F4C430",
              "Product Instance Failed To Renew": "#8B0000"
            }
          },
          "widget_id": "55740e87"
        },
        {
          "widget_type": "label",
          "min_width": 2,
          "height": 3,
          "max_width": 4,
          "sorting": [
            {
              "endTime": "desc"
            }
          ],
          "label": "{% set all_latest_data = {} %}\r\n{% for latest in latest_end_time %}\r\n    {% set last_updated_time = latest.get(\"label\") %}\r\n    {% set _ = all_latest_data.update({ \"latest\": last_updated_time }) or \"\" %}\r\n{% endfor %}\r\n\r\n<br><br> <center><h4> Last Collected at </h4></center><br><center><h3>{{all_latest_data.get(\"latest\")}}</h3></center>",
          "segments": [
            {
              "stream": "smart_license_summary_consolidate",
              "variable": "latest_end_time",
              "ts_column": "timestamp",
              "agg": "value_count",
              "group_by": "endTime",
              "column": "source"
            }
          ],
          "widget_id": "0991e641"
        },
