      "value": "/* Base Animation Classes */\r\n.notification-enter {\r\n    transform: translateX(100%);\r\n    opacity: 0;\r\n}\r\n.notification-enter-active {\r\n    transform: translateX(0);\r\n    opacity: 1;\r\n    transition: transform 300ms, opacity 300ms;\r\n}\r\n.notification-exit {\r\n    transform: translateX(0);\r\n    opacity: 1;\r\n}\r\n.notification-exit-active {\r\n    transform: translateX(100%);\r\n    opacity: 0;\r\n    transition: transform 300ms, opacity 300ms;\r\n}\r\n\r\n/* Animation for dropdown */\r\n.dropdown-appear {\r\n    opacity: 0;\r\n    transform: translateY(-10px);\r\n}\r\n.dropdown-appear-active {\r\n    opacity: 1;\r\n    transform: translateY(0);\r\n    transition: opacity 150ms, transform 150ms;\r\n}\r\n\r\n/* Custom styling for command items */\r\n.command-item {\r\n    transition: border-color 0.2s;\r\n}\r\n.command-item.dragging {\r\n    opacity: 0.5;\r\n    border-style: dashed;\r\n}\r\n.command-item.drag-over {\r\n    border-color: #3b82f6; /* blue-500 */\r\n}\r\n\r\n/* Rotate animation for chevron */\r\n.accordion-toggle svg {\r\n    transition: transform 0.2s ease;\r\n}\r\n.rotate-180 {\r\n    transform: rotate(180deg);\r\n}\r\n\r\n/* Rule form styling */\r\n.rule-form {\r\n    transition: background-color 0.2s;\r\n}\r\n.rule-form:hover {\r\n    background-color: #f3f4f6; /* gray-100 */\r\n}\r\n\r\n/* Template dropdown styling */\r\n.template-menu, .dropdown-menu {\r\n    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);\r\n    transition: opacity 0.2s, transform 0.2s;\r\n}\r\n\r\n/* Button loading animation */\r\n@keyframes spin {\r\n    from { transform: rotate(0deg); }\r\n    to { transform: rotate(360deg); }\r\n}\r\n.animate-spin {\r\n    animation: spin 1s linear infinite;\r\n}\r\n\r\n/* Focus states */\r\ninput:focus, select:focus, textarea:focus {\r\n    outline: none;\r\n    border-color: #3b82f6; /* blue-500 */\r\n    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.3); /* blue-500 with opacity */\r\n}\r\n\r\n/* Improve accessibility */\r\n.focused-option {\r\n    outline: 2px solid #3b82f6; /* blue-500 */\r\n    outline-offset: -2px;\r\n}\r\n\r\n/* Responsive adjustments */\r\n@media (max-width: 640px) {\r\n    .rule-standard-inputs, .grid-cols-3 {\r\n        grid-template-columns: 1fr;\r\n    }\r\n    \r\n    .rule-form {\r\n        padding-left: 0.5rem;\r\n        padding-right: 0.5rem;\r\n    }\r\n}"
