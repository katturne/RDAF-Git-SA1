 response.json();\r\n        console.log(\"dataaaaaa\",data.textfsm)\r\n        cachedTextfsmTemplates = data.textfsm;\r\n        console.log(\"**********\",cachedTextfsmTemplates)\r\n    } catch (error) {\r\n        console.error('Error loading TextFSM templates:', error);\r\n    }\r\n  }\r\n\r\n\r\n\r\n// Form submission\r\nform.addEventListener('submit', async function (e) {\r\n    e.preventDefault();\r\n\r\n    // Get form data\r\n    const name = document.getElementById('name').value;\r\n    \r\n    // Validate form data\r\n    const validationErrors = validateFormData(name, selectedValues);\r\n    if (validationErrors.length > 0) {\r\n        // Show validation errors\r\n        alert(validationErrors.join('. '));\r\n        return;\r\n    }\r\n\r\n    // Show loading state\r\n    const submitButton = this.querySelector('button[type=\"submit\"]');\r\n    const originalButtonText = submitButton.innerHTML;\r\n    submitButton.disabled = true;\r\n    submitButton.innerHTML = `\r\n        <svg class=\"animate-spin -ml-1 mr-2 h-4 w-4 text-white inline-block\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\">\r\n            <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\r\n            <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path>\r\n        </svg>\r\n        Saving...\r\n    `;\r\n    \r\n    // Format commands and rules for API payload\r\n    const formattedCommands = selectedValues.map(command => {\r\n        return {\r\n            id: command.id,\r\n            command: command.display, // Changed 'display' to 'command'\r\n            // Use our helper function to format rules\r\n            rules: formatRulesForAPI(command.rules || [])\r\n        };\r\n    });\r\n\r\n    // Construct API payload\r\n    const payload = [{\r\n        collection_name : name,\r\n        commands: formattedCommands\r\n    }];\r\n\r\n    \r\n    const payload2 = [{\r\n        name : name,\r\n        commands: JSON.stringify(formattedCommands)\r\n    }];\r\n    console.log(\"payload2\",payload2)\r\n    const output = payload.flatMap(item =>\r\n        item.commands.map(command => ({\r\n            name : item.name,\r\n            commands: JSON.stringify([command])\r\n        }))\r\n        );\r\n    \r\n\r\n    console.log(\"####\",JSON.stringify(output, null, 2));\r\n\r\n    console.log('Payload:', payload);\r\n\r\n    // Show the payload in an alert\r\n    setTimeout(async() => {\r\n        // Reset button state\r\n        submitButton.disabled = false;\r\n        submitButton.innerHTML = originalButtonText;\r\n        \r\n        // Display the payload\r\n        //alert('Form submitted with the following payload:\\n\\n' + \r\n             // JSON.stringify(payload, null, 2));\r\n\r\n        try {\r\n\r\n                const response_stream = await fetch('/api/v2/pstreams/pstream/xnor_pack_commands_collections/data', {\r\n                    method: 'POST',\r\n                    headers: {'Content-Type': 'application/json'},\r\n                    body: JSON.stringify(payload2)\r\n                });\r\n\r\n                \r\n                const response = await fetch('/api/v2/datasets/dataset/xnor_pack_commands_collections/data', {\r\n                    method: 'PUT',\r\n                    headers: {'Content-Type': 'application/json'},\r\n                    body: JSON.stringify(payload)\r\n                });\r\n                console.log(payload)\r\n\r\n                if (response.ok) {\r\n                    alert('Data submitted successfully!');\r\n                    form.reset();\r\n                    selectedValues = [];\r\n                    updateSelectionDisplay();  \r\n                    updateHiddenInput();\r\n                    document.getElementById('empty-selection').style.display = 'block';\r\n                    dropdownMenu.classList.add('hidden');\r\n                    //openDashboard(e);\r\n                } else {\r\n                    alert('Failed to submit data.');\r\n                }\r\n                } catch (error) {\r\n                console.error('Error submitting form:', error);\r\n                alert('Error submitting form');\r\n                }\r\n            \r\n    }, 500); // Short delay to show loading state\r\n});\r\n});"
