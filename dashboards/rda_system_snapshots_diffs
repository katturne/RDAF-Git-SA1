primary hover:bg-blue-600 text-white px-6 py-2 rounded-lg transition-colors\"\n                            >\n                                <i class=\"fas fa-save mr-2\"></i>\n                                Save Credential\n                            </button>\n                        </div>\n                    </div>\n                </form>\n\n                <!-- Connection Status -->\n                <div id=\"connectionStatus\" class=\"hidden mx-6 mb-6\">\n                    <div class=\"bg-blue-50 border border-blue-200 rounded-lg p-4\">\n                        <div class=\"flex items-center\">\n                            <i class=\"fas fa-spinner fa-spin text-blue-500 mr-2\"></i>\n                            <span class=\"text-blue-800\">Testing connection...</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <script src=\"script.js\"></script>   \n</body>\n</html>"
