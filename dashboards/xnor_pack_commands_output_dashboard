{
  "name": "xnor_pack_commands_output_dashboard",
  "label": "Command Outputs",
  "description": "Dashboard to see collection ",
  "version": "2.0.0",
  "enabled": false,
  "dashboard_style": "auto",
  "dashboard_type": "dashboard",
  "showRowSummary": true,
  "stream": "xnor_pack_command_final_results",
  "max_rows": 50,
  "paginated": true,
  "live_edit": true,
  "dashboard_filters": {
    "time_filter": true,
    "default_time_filter_labels": [
      "Last 5 months"
    ],
    "group_filters": [
      {
        "stream": "xnor_pack_command_final_results",
        "title": "Collection",
        "group_by": [
          "collection_name"
        ],
        "ts_column": "collection_timestamp",
        "agg": "value_count",
        "column": "collection_name",
        "type": "TEXT",
        "show_counts": true
      },
      {
        "stream": "xnor_pack_command_final_results",
        "title": "IP",
        "group_by": [
          "source_ip"
        ],
        "ts_column": "collection_timestamp",
        "agg": "value_count",
        "column": "source_ip",
        "type": "int",
        "show_counts": true
      },
      {
        "stream": "xnor_pack_command_final_results",
        "title": "Validation",
        "group_by": [
          "Validation"
        ],
        "ts_column": "collection_timestamp",
        "agg": "value_count",
        "column": "command",
        "type": "str",
        "show_counts": true
      }
    ]
  },
  "dashboard_sections": [
    {
      "title": "Command Outputs",
      "show_filter": true,
      "widgets": [
        {
          "title": "Command Outputs",
          "widget_type": "tabular",
          "duration_hours": 1080,
          "max_width": 12,
          "min_width": 12,
          "height": 7,
          "resizableColumns": true,
          "remote_searchable": true,
          "paginated": true,
          "stream": "xnor_pack_command_final_results",
          "sorting": [],
          "showRowSummary": true,
          "ts_column": "timestamp",
          "columns": {
            "id": {
              "title": "ID",
              "type": "TEXT",
              "hidden": true,
              "formatter": "truncate",
              "key": true
            },
            "collection_timestamp": {
              "title": "Timestamp",
              "type": "DATETIME",
              "hidden": false,
              "key": true,
              "format": "MMM DD, YYYY HH:mm:ss"
            },
            "command": {
              "title": "Command",
              "type": "TEXT",
              "hidden": false,
              "key": true
            },
            "collection_status": {
              "title": "Command Execution",
              "type": "TEXT",
              "hidden": false,
              "key": true,
              "htmlTemplateForRow": "<span class='badge' style='background-color: {{ row.collection_status_color }}' > {{ row.collection_status }} </span>"
            },
            "collection_status_color": {
              "type": "COLOR-MAP",
              "source-column": "collection_status",
              "color-map": {
                "Success": "#9ACD32",
                "Failed": "#FF2400"
              }
            },
            "output": {
              "title": "Command Output",
              "type": "TEXT",
              "hidden": false,
              "key": true,
              "htmlTemplateForRow": "<pre> {{ row.output }} </pre>"
            },
            "rule": {
              "title": "Rule",
              "type": "TEXT",
              "key": true
            },
            "Validation": {
              "title": "Rules Status",
              "type": "TEXT",
              "hidden": false,
              "key": true,
              "htmlTemplateForRow": "<span class='badge' style='background-color: {{ row.Validation_colour }}' > {{ row.Validation }} </span>"
            },
            "Validation_colour": {
              "type": "COLOR-MAP",
              "source-column": "Validation",
              "color-map": {
                "Failed": "#FF2400",
                "Passed": "#9ACD32"
              }
            },
            "collection_duration": {
              "title": "Duration",
              "type": "integer",
              "hidden": false,
              "key": true,
              "formatter": {
                "notation": "standard",
                "style": "unit",
                "unit": "millisecond"
              }
            },
            "source_ip": {
              "title": "Source IP",
              "type": "integer",
              "hidden": false,
              "key": true
            },
            "collection_name": {
              "title": "Collection Name",
              "type": "TEXT",
              "hidden": false,
              "key": true
            }
          },
          "widget_id": "55e1ca69"
        }
      ]
    }
  ],
