 }\n        \n        // Alternative check: verify if credentials modal was successfully submitted\n        // This assumes you set a flag when credentials are saved successfully\n        const credentialsSaved = localStorage.getItem('snowflakeCredentialsSaved');\n        if (credentialsSaved === 'true') {\n            return true;\n        }\n        \n        return false;\n    }\n\n    validateInventoryForm(formData) {\n        const required = ['customer', 'savm_level', 'savm_name'];\n        const fieldLabels = {\n            'customer': 'Customer',\n            'savm_level': 'Savm Level', \n            'savm_name': 'Savm Name'\n        };\n        \n        for (const field of required) {\n            if (!formData.get(field) || formData.get(field).trim() === '') {\n                alert(`Please fill in the ${fieldLabels[field]} field`);\n                return false;\n            }\n        }\n        return true;\n    }\n\n    validateLicenseForm(formData) {\n        const required = ['customer', 'top_level_domain'];\n        const fieldLabels = {\n            'customer': 'Customer',\n            'top_level_domain': 'Top Level Domain'\n        };\n        \n        for (const field of required) {\n            if (!formData.get(field) || formData.get(field).trim() === '') {\n                alert(`Please fill in the ${fieldLabels[field]} field`);\n                return false;\n            }\n        }\n        return true;\n    }\n\n    updatePipelineFormStatus(statusId, type, message) {\n        const statusElement = document.getElementById(statusId);\n        const span = statusElement.querySelector('span');\n        \n        let className = 'px-3 py-1 rounded-full text-sm ';\n        switch (type) {\n            case 'running':\n                className += 'bg-blue-200 text-blue-600';\n                break;\n            case 'success':\n                className += 'bg-green-200 text-green-600';\n                break;\n            case 'error':\n                className += 'bg-red-200 text-red-600';\n                break;\n            default:\n                className += 'bg-gray-200 text-gray-600';\n        }\n        \n        span.className = className;\n        span.textContent = message;\n    }\n\n    addPipelineSummary(pipelineName, status, data, error = null) {\n        const summaryDiv = document.getElementById('pipelinesSummary');\n        const summaryList = document.getElementById('pipelineSummaryList');\n        \n        summaryDiv.classList.remove('hidden');\n        \n        const summaryItem = document.createElement('div');\n        summaryItem.className = 'flex items-center justify-between p-2 bg-white rounded border';\n        \n        const icon = status === 'success' ? 'fa-check-circle text-green-500' : 'fa-exclamation-circle text-red-500';\n        const statusText = status === 'success' ? 'Started' : 'Failed';\n        \n        summaryItem.innerHTML = `\n            <div class=\"flex items-center\">\n                <i class=\"fas ${icon} mr-2\"></i>\n                <span class=\"font-medium\">${pipelineName}</span>\n            </div>\n            <span class=\"text-sm text-gray-600\">${statusText}</span>\n        `;\n        \n        summaryList.appendChild(summaryItem);\n    }\n\n    async addInventoryData() {\n        const form = document.getElementById('inventoryForm');\n        const formData = new FormData(form);\n        \n        // Validate form\n        if (!this.validateInventoryForm(formData)) {\n            return;\n        }\n\n        const button = document.getElementById('addInventoryData');\n        \n        try {\n            // Show loading state\n            button.disabled = true;\n            button.innerHTML = '<i class=\"fas fa-spinner fa-spin mr-2\"></i>Adding...';\n\n            // Prepare API data\n            const pipelineData = {\n                customer: formData.get('customer'),\n                savm_level: formData.get('savm_level'),\n         