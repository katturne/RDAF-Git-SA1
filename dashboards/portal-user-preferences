      "name": "main112.html",
      "value": "{%-\n    set docContentsYaml = engine.get_dashboard_attachment(help_yaml_source_dashboard, help_yaml_source_attachment, defaultValue=help_default)\n-%}\n\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>r</title>\n    <style>\n        body {\n            font-family: Avenir, Helvetica, Arial, sans-serif;\n            margin: 20px;\n            padding: 20px;\n            max-width0: 1000px;\n            margin: auto;\n            background-color: #D3D3D3;\n            color: #36454F;\n        }\n        .editor-container {\n            width: 90%;\n            height: 300px;\n            margin: 10px auto;\n            border: 0px solid #ccc;\n        }\n        #toc {\n            background: #07182D;\n            padding: 10px;\n            margin-bottom: 20px;\n            border-radius: 8px;\n        }\n        section.section-box {\n            background: #07182D; /* Light gray background */\n            border: 1px solid #ddd; /* Border around the box */\n            border-radius: 8px; /* Rounded corners */\n            padding: 10px; /* Padding inside the box */\n            margin-bottom: 10px; /* Space between boxes */\n            color: white; /* Text color */\n            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1); /* Light shadow for section elevation */\n        }\n\n        section.section-box h2, \n        section.section-box h3, \n        section.section-box h4, \n        section.section-box h5 {\n            margin-top: 10px;\n        }\n        \n        h2 {\n            color:#90CAF9;\n            border-bottom: 1px solid #607D8B;\n            padding-bottom: 1px;\n            margin-top: 5px;\n        }\n        h3 {\n            color: red;\n        }\n        p {\n            line-height: 1.6;\n            font-size: 14px;\n        }\n        ol{\n            font-size: 14px;\n        }\n        a {\n            color: #42A5F5;\n            text-decoration: none;\n        }\n        ul{\n            list-style:none;\n        }\n        li {\n            margin: 8px 0;\n        }\n        a:hover {\n            text-decoration: underline;\n        }\n        img {\n            max-width: 100%;\n            height: auto;\n            margin-top: 10px;\n            border-radius: 5px;\n        }\n        .hidden {\n            display: none;\n        }\n        .tabs {\n            display: flex;\n            border-bottom: 2px solid #ccc;\n        }\n        .tab {\n            padding: 10px 20px;\n            cursor: pointer;\n            border: 1px solid #ccc;\n            border-bottom: none;\n            background: #494949;\n            border-top-left-radius: 10px;\n            border-top-right-radius: 10px;\n        }\n        .tab.active {\n            background: #3333a9;\n            font-weight: bold;\n        }\n        .tab-content {\n            display: block;\n            padding: 20px;\n            border: 1px solid #ccc;\n            border-radius: 10px;\n        }\n        .toggle-button {\n            cursor: pointer;\n            font-weight: bold;\n            margin-right: 5px;\n        }\n        .tab-content.active {\n            display: block;\n        }\n    </style>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/js-yaml/4.1.0/js-yaml.min.js\"></script>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/require.js/2.3.6/require.min.js\"></script>\n    <script>\n        window.MonacoEnvironment = {\n            getWorkerUrl: function (workerId, label) {\n                return `data:text/javascript;charset=utf-8,` +\n                    `importScripts('https://unpkg.com/monaco-editor@0.34.0/min/vs/base/worker/workerMain.js');`;\n            }\n        };\n    </script>\n    <script src=\"https://unpkg.com/monaco-editor@0.34.0/min/vs/loader.js\"></script>\n</head>\n<body>\n<h1>{{help_title}}</h1>\n<p>{{help_description}}</p>\n    <div id=\"toc\">\n        <ul id=\"index\"></ul>\n    </div>\n    <div id=\"content\"></div>\n\n    <script>\n        const yamlData = `{{docContentsYaml}}`;\n        \n        const data = jsyaml.load(yamlData);\n        renderDocumentation(data);\n        function renderDocumentation(data) {\n    const indexEl = document.getElementById('index');\n    const contentEl = document.getElementById('content');\n    indexEl.innerHTML = '';\n    contentEl.innerHTML = '';\n\n    // Call the recursive function for the root level\n    renderSectionsRecursive(data.sections, indexEl, contentEl, 'section');\n}\n\nfunction renderSectionsRecursive(sections, parentTOCEl, parentContentEl, parentIdPrefix) {\n    sections.forEach((section, sectionIndex) => {\n        const sectionId = `${parentIdPrefix}-${sectionIndex}`;\n        const sectionToggleId = `${sectionId}-toggle`;\n        const sectionTOCId = `${sectionId}-toc`;\n\n        // Add section to TOC with a toggle button\n        const sectionItem = document.createElement('li');\n        sectionItem.innerHTML = `\n            <span class=\"toggle-button\" id=\"${sectionToggleId}\" onclick=\"toggleTOC('${sectionToggleId}', '${sectionTOCId}')\">\u25b6</span>\n            <a href=\"#${sectionId}\">${section.title}</a>\n            <ul class=\"hidden\" id=\"${sectionTOCId}\"></ul>\n        `;\n        parentTOCEl.appendChild(sectionItem);\n\n        // Add section content inside a <section> element\n        const sectionEl = document.createElement('section');\n        sectionEl.classList.add('section-box'); // Add a CSS class for styling\n        sectionEl.innerHTML = `\n            <h2 id=\"${sectionId}\">${section.title}</h2>\n            <p>${section.description || ''}</p>\n        `;\n        if (section.image) {\n            sectionEl.innerHTML += `<img src=\"${section.image}\" alt=\"${section.title}\">`;\n        }\n        parentContentEl.appendChild(sectionEl);\n\n        // Check for nested sections (any deeper level)\n        if (section.children && section.children.length > 0) {\n            const childTOCEl = document.getElementById(sectionTOCId);\n            renderSectionsRecursive(section.children, childTOCEl, sectionEl, sectionId);\n        }\n    });\n}\n\n// Function to toggle visibility of TOC items\nfunction toggleTOC(toggleId, listId) {\n    const toggleButton = document.getElementById(toggleId);\n    const list = document.getElementById(listId);\n\n    if (list.classList.contains('hidden')) {\n        list.classList.remove('hidden'); // Expand list\n        toggleButton.textContent = '\u25bc'; // Change to expanded symbol\n    } else {\n        list.classList.add('hidden'); // Collapse list\n        toggleButton.textContent = '\u25b6'; // Change to collapsed symbol\n    }\n}\n    </script>\n    <script>\n        require.config({ paths: { 'vs': 'https://unpkg.com/monaco-editor@0.34.0/min/vs' } });\n\n        require(['vs/editor/editor.main'], function () {\n            document.querySelectorAll('.editor-container').forEach(container => {\n                let code = container.textContent.trim();\n                let language = container.getAttribute('data-language') || 'javascript';\n                let theme = container.getAttribute('data-theme') || 'vs-dark';\n\n                container.innerHTML = \"\"; // Clear text to prevent duplication\n\n                monaco.editor.create(container, {\n                    value: code,\n                    language: language,\n                    theme: theme,\n                    readOnly: true\n                });\n            });\n        });\n    </script>\n</body>\n</html>"
