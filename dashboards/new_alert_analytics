          "extra_filter": null,
          "column": "count_",
          "agg": "sum",
          "group_by": [
            "exp_status"
          ],
          "style": {
            "color-map": {
              "Valid Indefinitely": "#79BAEC",
              "One or more Expired Licenses": "#BB0000",
              "Expiring within 90 days": "#BB0000",
              "Expiring after 90 days": "#00BB00"
            }
          },
          "type": "int",
          "min_width": 2,
          "height": 3,
          "max_width": 4,
          "widget_id": "04d52ddb"
        },
        {
          "widget_type": "pie_chart",
          "title": "Alerts",
