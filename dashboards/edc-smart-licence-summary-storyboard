tainer = document.getElementById('selected-options');\r\n    const items = container.querySelectorAll('.command-item');\r\n\r\n    items.forEach(item => {\r\n        item.setAttribute('draggable', 'true');\r\n\r\n        // Drag start\r\n        item.addEventListener('dragstart', function (e) {\r\n            e.dataTransfer.setData('text/plain', this.dataset.index);\r\n            this.classList.add('opacity-50', 'border-dashed');\r\n        });\r\n\r\n        // Drag end\r\n        item.addEventListener('dragend', function () {\r\n            this.classList.remove('opacity-50', 'border-dashed');\r\n        });\r\n\r\n        // Drag over\r\n        item.addEventListener('dragover', function (e) {\r\n            e.preventDefault();\r\n            this.classList.add('border-blue-500');\r\n        });\r\n\r\n        // Drag leave\r\n        item.addEventListener('dragleave', function () {\r\n            this.classList.remove('border-blue-500');\r\n        });\r\n\r\n        // Drag enter\r\n        item.addEventListener('dragenter', function (e) {\r\n            e.preventDefault();\r\n        });\r\n\r\n        // Drop\r\n        item.addEventListener('drop', function (e) {\r\n            e.preventDefault();\r\n            this.classList.remove('border-blue-500');\r\n\r\n            const sourceIndex = parseInt(e.dataTransfer.getData('text/plain'));\r\n            const targetIndex = parseInt(this.dataset.index);\r\n\r\n            if (sourceIndex !== targetIndex) {\r\n                // Reorder array\r\n                const itemToMove = selectedValues.splice(sourceIndex, 1)[0];\r\n                selectedValues.splice(targetIndex, 0, itemToMove);\r\n\r\n                // Update display\r\n                updateSelectionDisplay();\r\n            }\r\n        });\r\n\r\n        // Drag handle specific events\r\n        const dragHandle = item.querySelector('.drag-handle');\r\n        dragHandle.addEventListener('mousedown', function (e) {\r\n            // Start drag