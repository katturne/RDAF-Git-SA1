ize this based on your API requirements\n                timestamp: new Date().toISOString(),\n                source: 'pack_configuration_wizard'\n            };\n\n            // Call the trigger pipeline API\n            let response;\n            try {\n                response = await this.callPipelineAPI('edc_oi_trigger_pipeline', '1.0.0', triggerData);\n            } catch (networkError) {\n                // Handle network errors specifically\n                throw new Error('Cannot connect to the server. Please check if the API server is running.');\n            }\n            \n            if (response.ok) {\n                const result = await response.json();\n                console.log('All pipelines triggered successfully:', result);\n                \n                // Update progress bar stages\n                const stages = [\n                    { progress: 40, text: 'Pipelines initiated successfully...' },\n                    { progress: 60, text: 'Processing data streams...' },\n                    { progress: 80, text: 'Running analytics...' },\n                    { progress: 100, text: 'All pipelines completed successfully!' }\n                ];\n\n                let currentStage = 0;\n                const interval = setInterval(() => {\n                    if (currentStage < stages.length) {\n                        progressBar.style.width = stages[currentStage].progress + '%';\n                        progressText.textContent = stages[currentStage].text;\n                        currentStage++;\n                    } else {\n                        clearInterval(interval);\n                        \n                        // Add pipeline summary\n                        this.addPipelineSummary('All Pipelines Trigger', 'success', triggerData);\n                        \n                        // Show success notification\n                        this.showNotification('All pipelines triggered successfully!', 'success');\n                        \n                        setTimeout(() => {\n                            this.nextStep();\n                        }, 1000);\n                    }\n                }, 1500);\n\n                // Update pipeline status indicators\n                this.updatePipelineStatus();\n                \n            } else {\n                throw new Error(`Pipeline trigger failed: ${response.status} ${response.statusText}`);\n            }\n\n        } catch (error) {\n            console.error('Error triggering pipelines:', error);\n            \n            // Update progress to show error\n            progressBar.style.width = '100%';\n            progressBar.className = 'bg-red-500 h-2 rounded-full transition-all duration-1000';\n            progressText.textContent = `Error: ${error.message}`;\n            \n            // Add error summary\n            this.addPipelineSummary('All Pipelines Trigger', 'error', null, error.message);\n            \n            // Show error notification\n            this.showNotification(`Error triggering pipelines: ${error.message}`, 'error');\n            \n            // Hide progress div after showing error for 3 seconds\n            setTimeout(() => {\n                progressDiv.classList.add('hidden');\n                // Reset progress bar appearance\n                progressBar.style.width = '0%';\n                progressBar.className = 'bg-blue-500 h-2 rounded-full transition-all duration-1000';\n                progressText.textContent = 'Initializing pipelines...';\n            }, 3000);\n            \n        } finally {\n            // Reset button after delay\n            setTimeout(() => {\n                triggerBtn.disabled = false;\n                triggerBtn.innerHTML = '<i class=\"fas fa-play mr-2\"></i>Trigger All Pipelines';\n            }, 3000);\n        }\n    }\n\n    updatePipelineStatus() {\n        const pipelineItems = document.querySelectorAll('.pipeline-item');\n        let delay = 0;\n\n   