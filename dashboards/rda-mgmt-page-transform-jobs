{
  "name": "topology-details-with-html-and-pivot-report",
  "label": "X-Leaf Workflow Results",
  "description": "X-Leaf EVT Workflow Results",
  "enabled": true,
  "dashboard_style": "auto",
  "dashboard_type": "template",
  "dashboard_folder": "X-Leaf",
  "version": "23.8.21.1",
  "short_label": "X-Leaf EVT Workflow",
  "dashboard_filters": {},
  "template_variables": {
    "NODE_ID": {
      "contextId": [
        "navigatorSelectionContexts",
        "secondaryListSelection",
        "device_ip"
      ]
    },
    "PRECHECK_NAME": {
      "contextId": [
        "navigatorSelectionContexts",
        "secondaryListSelection",
        "evt_check_name"
      ]
    },
    "COMMAND": {
      "contextId": [
        "navigatorSelectionContexts",
        "secondaryListSelection",
        "command"
      ]
    }
  },
  "navigation_dashboards": {
    "tree_data": {
      "column_name": "device_ip",
      "pstream_name": "xleaf_evt_results_summary",
      "cfxql_query": "timestamp is after -30d",
      "show_counts": false
    },
    "tree_detail": {
      "display_column": "evt_check_name",
      "pstream_name": "xleaf_evt_results_summary",
      "cfxql_query": "timestamp is after -30d",
      "htmlTemplate": "<div style='overflow:hidden;'><div class='d-flex'><div style='flex-grow: 1' class='label1 text-truncate'><b>{{data.label1}}</b></div><div class='label2 text-truncate badge' :style='{backgroundColor: data.color}'>{{data.label2}}</div></div><div class='cfx-list-item-end-label'>{{data.label3}}</div></div>",
      "report_definition": {
        "title": "Validation Checks",
        "widget_type": "tabular",
        "stream": "xleaf_evt_results_summary",
        "ts_column": "timestamp",
        "timebased": false,
        "columns": {
          "evt_check_name": "evt_check_name",
          "device_ip": "device_ip",
          "status": "status",
          "command": "command"
        },
        "sorting": [
          {
            "result_int_max": "desc"
          }
        ],
        "cfxql_query": "device_ip is '{{NODE_ID}}' and timestamp is after -30d",
        "pivot": {
          "pivot_type": "advanced",
          "series": [
            {
              "column": "evt_check_name",
              "agg": "cardinality"
            },
            {
              "column": "result_int",
              "agg": "max"
            }
          ],
          "group_by": [
            "evt_check_name",
            "device_ip",
            "status",
            "command"
          ]
        },
        "paginated": true,
        "enableVirtualScrolling": false,
        "custom_columns": [
          {
            "id": "label1",
            "expr": "str(evt_check_name)"
          },
          {
            "id": "label2",
            "expr": "'Pass' if int(result_int_max) == 0 else 'Fail' if int(result_int_max) == 1 else 'Run'"
          },
          {
            "id": "label3",
            "expr": "str(status)"
          },
          {
            "id": "color",
            "expr": "'#4caf50' if int(result_int_max) == 0 else '#E53935' if int(result_int_max) == 1 else '#FFD54F'"
          }
        ],
        "widget_id": "5afc2391"
      }
    },
    "showNodeIcon": false,
    "showSearchBox": true
  },
  "dashboard_sections": [
    {
      "title": "Passed",
      "widgets": [
        {
          "title": "Summary",
          "widget_type": "tabular",
          "stream": "xleaf_evt_results",
