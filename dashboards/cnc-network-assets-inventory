  "version": "2023-03-18_1",
  "enabled": false,
  "debug": true,
  "live_edit": true,
  "stream": "cnc_device_inventory",
  "dashboard_type": "dashboard",
  "dashboard_filters": {
    "time_filter": true,
    "default_time_filter_labels": [
      "Last 12 months"
    ],
    "extra_filter": "`item_type` is  \"ASSET\"",
    "columns_filter": [
      {
        "id": "device_ip",
        "label": "IP Address",
        "type": "TEXT"
      },
      {
        "id": "device_family",
        "label": "Device Family",
        "type": "TEXT"
      },
      {
        "id": "device_serial_number",
        "label": "Serial Number",
        "type": "TEXT"
      },
      {
        "id": "device_fw_version",
        "label": "Software Version",
        "type": "TEXT"
      },
      {
        "id": "clli_code",
        "label": "CLLI Code",
        "type": "TEXT"
      }
    ],
    "group_filters": [
      {
        "stream": "cnc_device_inventory",
        "title": "Manufacturer",
        "duration_hours": 1080,
        "extra_filter": "`item_type` is  \"ASSET\"",
        "group_by": [
          "manufacturer"
        ],
        "ts_column": "timestamp",
        "agg": "value_count",
        "column": "_RDA_Id",
        "type": "str"
      },
      {
        "stream": "cnc_device_inventory",
        "title": "Model",
        "duration_hours": 1080,
        "extra_filter": "`item_type` is  \"ASSET\"",
        "group_by": [
          "device_model"
        ],
        "ts_column": "timestamp",
        "agg": "value_count",
        "column": "_RDA_Id",
        "type": "str"
      },
      {
        "stream": "cnc_device_inventory",
        "title": "SW Versions",
        "duration_hours": 1080,
        "extra_filter": "`item_type` is  \"ASSET\"",
        "group_by": [
          "device_fw_version"
        ],
        "ts_column": "timestamp",
        "agg": "value_count",
        "column": "_RDA_Id",
        "type": "str"
      }
    ]
  },
