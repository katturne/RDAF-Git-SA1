    {
      "name": "style.css",
      "value": "/* Custom CSS Styles for Pack Configuration Wizard */\n\n/* Custom CSS Variables for consistent theming */\n:root {\n    --primary-color: #3B82F6;\n    --secondary-color: #10B981;\n    --accent-color: #F59E0B;\n    --success-color: #10B981;\n    --error-color: #EF4444;\n    --warning-color: #F59E0B;\n    --info-color: #3B82F6;\n}\n\n/* Additional custom styles beyond Tailwind */\n.step-content {\n    opacity: 1;\n    transform: translateX(0);\n    transition: all 0.3s ease-in-out;\n}\n\n.step-content.hidden {\n    opacity: 0;\n    transform: translateX(20px);\n    display: none !important;\n}\n\n.step-content.entering {\n    display: block !important;\n    opacity: 0;\n    transform: translateX(20px);\n}\n\n.step-content.entered {\n    opacity: 1;\n    transform: translateX(0);\n}\n\n/* Data source option selection styles */\n.data-source-option.selected {\n    border-color: var(--primary-color);\n    background-color: #EBF8FF;\n    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);\n}\n\n.data-source-option.selected .fas {\n    color: var(--primary-color);\n}\n\n/* File upload area hover effects */\n.file-upload-area {\n    cursor: pointer;\n    position: relative;\n    overflow: hidden;\n}\n\n.file-upload-area input[type=\"file\"] {\n    position: absolute;\n    width: 100%;\n    height: 100%;\n    opacity: 0;\n    cursor: pointer;\n    z-index: 2;\n}\n\n.file-upload-area:hover {\n    background-color: #F8FAFC;\n    border-color: var(--primary-color);\n}\n\n.file-upload-area.dragover {\n    background-color: #EBF8FF;\n    border-color: var(--primary-color);\n    border-style: solid;\n}\n\n/* File info display */\n.file-info {\n    background-color: #F0F9FF;\n    border: 1px solid #0EA5E9;\n    border-radius: 0.5rem;\n    padding: 0.75rem;\n    color: #0369A1;\n}\n\n/* Pipeline status indicators */\n.pipeline-status .ready {\n    background-color: #F3F4F6;\n    color: #6B7280;\n}\n\n.pipeline-status .running {\n    background-color: #DBEAFE;\n    color: #2563EB;\n}\n\n.pipeline-status .completed {\n    background-color: #D1FAE5;\n    color: #065F46;\n}\n\n.pipeline-status .error {\n    background-color: #FEE2E2;\n    color: #DC2626;\n}\n\n/* Progress bar animations */\n@keyframes progress-fill {\n    0% {\n        width: 0%;\n    }\n    100% {\n        width: var(--progress-width, 100%);\n    }\n}\n\n.progress-animated {\n    animation: progress-fill 2s ease-in-out;\n}\n\n/* Step indicator active state */\n.step-indicator-active {\n    background-color: var(--primary-color) !important;\n    color: white !important;\n    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);\n}\n\n.step-indicator-completed {\n    background-color: var(--secondary-color) !important;\n    color: white !important;\n}\n\n/* Logo preview styles */\n#logoPreview img {\n    max-width: 200px;\n    max-height: 80px;\n    object-fit: contain;\n    border-radius: 0.5rem;\n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\n}\n\n/* Custom button hover effects */\n.btn-primary {\n    background-color: var(--primary-color);\n    color: white;\n    transition: all 0.2s ease-in-out;\n}\n\n.btn-primary:hover {\n    background-color: #2563EB;\n    transform: translateY(-1px);\n    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);\n}\n\n.btn-secondary {\n    background-color: var(--secondary-color);\n    color: white;\n    transition: all 0.2s ease-in-out;\n}\n\n.btn-secondary:hover {\n    background-color: #059669;\n    transform: translateY(-1px);\n    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);\n}\n\n/* Loading spinner styles */\n.loading-spinner {\n    animation: spin 1s linear infinite;\n}\n\n@keyframes spin {\n    from {\n        transform: rotate(0deg);\n    }\n    to {\n        transform: rotate(360deg);\n    }\n}\n\n/* Form validation styles */\n.form-error {\n    border-color: var(--error-color) !important;\n    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1) !important;\n}\n\n.form-success {\n    border-color: var(--success-color) !important;\n    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1) !important;\n}\n\n/* Tooltip styles */\n.tooltip {\n    position: relative;\n}\n\n.tooltip::after {\n    content: attr(data-tooltip);\n    position: absolute;\n    bottom: 100%;\n    left: 50%;\n    transform: translateX(-50%);\n    background-color: #1F2937;\n    color: white;\n    padding: 0.5rem 0.75rem;\n    border-radius: 0.375rem;\n    font-size: 0.875rem;\n    white-space: nowrap;\n    opacity: 0;\n    visibility: hidden;\n    transition: all 0.2s ease-in-out;\n    z-index: 10;\n}\n\n.tooltip:hover::after {\n    opacity: 1;\n    visibility: visible;\n    transform: translateX(-50%) translateY(-4px);\n}\n\n/* Mobile responsive adjustments */\n@media (max-width: 768px) {\n    .container {\n        padding-left: 1rem;\n        padding-right: 1rem;\n    }\n    \n    .grid-cols-3 {\n        grid-template-columns: 1fr;\n        gap: 1rem;\n    }\n    \n    .flex-1.h-1 {\n        display: none !important;\n    }\n    \n    .step-indicator {\n        width: 2rem;\n        height: 2rem;\n        font-size: 0.875rem;\n    }\n}\n\n/* Print styles */\n@media print {\n    .bg-gray-50 {\n        background-color: white !important;\n    }\n    \n    .shadow-lg {\n        box-shadow: none !important;\n        border: 1px solid #E5E7EB;\n    }\n    \n    button {\n        display: none !important;\n    }\n    \n    .hidden {\n        display: none !important;\n    }\n}\n\n/* High contrast mode support */\n@media (prefers-contrast: high) {\n    .border-gray-300 {\n        border-color: #000 !important;\n    }\n    \n    .text-gray-600 {\n        color: #000 !important;\n    }\n    \n    .bg-gray-50 {\n        background-color: #fff !important;\n    }\n}\n\n/* Reduced motion support */\n@media (prefers-reduced-motion: reduce) {\n    * {\n        animation-duration: 0.01ms !important;\n        animation-iteration-count: 1 !important;\n        transition-duration: 0.01ms !important;\n    }\n}\n\n/* Credentials dropdown styles */\n.credentials-dropdown {\n    z-index: 1000;\n}\n\n.credentials-dropdown-menu {\n    min-width: 200px;\n    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);\n}\n\n.credentials-dropdown-menu button:hover {\n    background-color: #F3F4F6;\n    transition: background-color 0.2s ease-in-out;\n}\n\n/* Modal styles */\n.modal-backdrop {\n    backdrop-filter: blur(4px);\n    background-color: rgba(0, 0, 0, 0.6);\n}\n\n.modal-content {\n    animation: modal-enter 0.3s ease-out;\n}\n\n@keyframes modal-enter {\n    from {\n        opacity: 0;\n        transform: scale(0.95) translateY(-20px);\n    }\n    to {\n        opacity: 1;\n        transform: scale(1) translateY(0);\n    }\n}\n\n/* Snowflake modal specific styles */\n.snowflake-modal {\n    max-height: 90vh;\n    overflow-y: auto;\n}\n\n.snowflake-modal::-webkit-scrollbar {\n    width: 6px;\n}\n\n.snowflake-modal::-webkit-scrollbar-track {\n    background: #f1f1f1;\n    border-radius: 3px;\n}\n\n.snowflake-modal::-webkit-scrollbar-thumb {\n    background: #888;\n    border-radius: 3px;\n}\n\n.snowflake-modal::-webkit-scrollbar-thumb:hover {\n    background: #555;\n}\n\n/* Form field focus states */\n.snowflake-form input:focus,\n.snowflake-form textarea:focus,\n.snowflake-form select:focus {\n    border-color: var(--primary-color);\n    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);\n    outline: none;\n}\n\n/* Status message animations */\n.status-message {\n    animation: fade-in 0.3s ease-in-out;\n}\n\n@keyframes fade-in {\n    from {\n        opacity: 0;\n        transform: translateY(-10px);\n    }\n    to {\n        opacity: 1;\n        transform: translateY(0);\n    }\n}\n\n/* Button loading states */\n.btn-loading {\n    position: relative;\n    color: transparent !important;\n}\n\n.btn-loading::after {\n    content: '';\n    position: absolute;\n    width: 16px;\n    height: 16px;\n    top: 50%;\n    left: 50%;\n    margin-left: -8px;\n    margin-top: -8px;\n    border: 2px solid transparent;\n    border-top-color: currentColor;\n    border-radius: 50%;\n    animation: spin 1s linear infinite;\n}\n\n/* Checkbox and radio custom styles */\n.custom-checkbox,\n.custom-radio {\n    appearance: none;\n    border: 2px solid #D1D5DB;\n    border-radius: 4px;\n    width: 16px;\n    height: 16px;\n    background-color: white;\n    cursor: pointer;\n    position: relative;\n    transition: all 0.2s ease-in-out;\n}\n\n.custom-checkbox:checked,\n.custom-radio:checked {\n    background-color: var(--primary-color);\n    border-color: var(--primary-color);\n}\n\n.custom-checkbox:checked::after {\n    content: '\u2713';\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    color: white;\n    font-size: 12px;\n    font-weight: bold;\n}\n\n.custom-radio {\n    border-radius: 50%;\n}\n\n.custom-radio:checked::after {\n    content: '';\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    width: 6px;\n    height: 6px;\n    background-color: white;\n    border-radius: 50%;\n}\n"
